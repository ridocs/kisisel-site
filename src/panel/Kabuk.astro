---
import '../styles/global.css';
import './panel.css';

/*
  PANELİN ORTAK KABUĞU

  Üç ekran (istatistik · kontrol · durum) daha önce kendi `<html>` belgesini
  basıyordu. Aynı `<head>`, aynı tema betiği, aynı gövde sınıfları üç yerde
  kopyalanmıştı; biri değiştiğinde öteki ikisi geride kalıyordu — tipografi ve
  kenar boşlukları da öyle ayrıştı. Belgenin tamamı artık burada.

  Yayın derlemesi bu dosyayı da görmüyor: kabuğu yalnızca `src/pages/` dışında
  duran ve rotaları elle bağlanan üç panel sayfası kullanıyor.

  `global.css` sitenin kendi yazı tipini (yerel Inter alt kümesi) ve `.dark`
  düzeneğini getiriyor; `panel.css` onun üzerine panelin görsel dilini koyuyor.
  Sıra önemli, bu yüzden ikisi de burada ve bu sırayla içe aktarılıyor.
*/

interface Props {
	/** Sekme başlığı ve sayfanın H1'i. */
	baslik: string;
	/** Hangi panelde olduğumuz; üst şeritte işaretlenir. */
	aktif: 'istatistik' | 'kontrol' | 'durum';
	/** Başlığın yanındaki bağlam satırı: kaynak, çekim anı, özet. */
	not?: string;
}

/*
  Genişlik seçeneği YOK, üç ekran da aynı sütunu kullanıyor.

  Önce istatistik geniş (1220px), kontrol ve durum dar (920px) idi; gerekçe
  liste ağırlıklı ekranlarda satır uzunluğuydu. Ama sekmeler arasında geçerken
  içerik her seferinde yerinden oynuyordu ve bu, okuma kolaylığından daha çok
  rahatsız ediyordu. Tek ölçü seçildi: istatistiğin iki sütunlu ızgarası için
  yeterli, öbür ikisinde satırları aşırı germeyecek kadar dar.

  Satır uzunluğu sorunu sütunu daraltarak değil, metin bloklarının kendi üst
  sınırıyla çözülüyor (`p-olcum` altındaki açıklama metinleri).
*/
const { baslik, aktif, not } = Astro.props;

/*
  Dört panel tek listede. "Yazılar" Keystatic'e gidiyor — o sayfa bizim değil,
  ona stil verilmiyor, yalnızca bağlantı veriliyor. Panelden çıkıldığı ok imiyle
  belirtiliyor ki kullanıcı üst şeridin orada da duracağını sanmasın.
*/
/*
  Adresler ÖNEKTEN geçiyor, sabit yazılmıyor.

  Masaüstü panelinde önek yok (`/istatistik`), internete açık kopyada var
  (`/web-sitem/panel-root/istatistik`). Sabit yazıldığında ikinci durumda
  bağlantılar sitenin köküne çıkıyor ve 404 veriyordu — ölçüldü.

  `BASE_URL` sondaki eğik çizgiyle geliyor (`/` ya da `/web-sitem/panel-root/`),
  bu yüzden birleştirmede çift çizgi oluşmaması için kırpılıyor.
*/
const onek = import.meta.env.BASE_URL.replace(/\/$/, '');
const yol = (adres: string) => `${onek}${adres}`;

/*
  Yazı editörü yalnızca masaüstü panelinde var; internete açık kopyada
  Keystatic hiç derlenmiyor. Bağlantıyı yine de bassaydık 404'e giden ölü bir
  sekme olurdu — kullanıcı tıklar, boş sayfa alır, sebebini anlamaz.
*/
const yaziEditoruVar = process.env.PANEL_SALT_OKUR !== '1';

const PANELLER = [
	...(yaziEditoruVar
		? [{ anahtar: 'yazilar', ad: 'Yazılar', adres: yol('/keystatic'), disari: true } as const]
		: []),
	{ anahtar: 'istatistik', ad: 'İstatistik', adres: yol('/istatistik'), disari: false },
	{ anahtar: 'kontrol', ad: 'Yayın öncesi kontrol', adres: yol('/kontrol'), disari: false },
	{ anahtar: 'durum', ad: 'Site durumu', adres: yol('/durum'), disari: false },
] as const;
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{baslik} · Panel</title>
		{/* Panel yerelde çalışıyor ama yine de: bu sayfalar hiçbir dizine girmemeli. */}
		<meta name="robots" content="noindex, nofollow" />
		{/* Sitenin tema düzeneği `.dark` sınıfına bakıyor; panelde tema değiştirici
		    yok, işletim sisteminin tercihi doğrudan uygulanıyor. Betik `<head>`
		    içinde ve satır içi: gövde boyanmadan önce çalışmazsa açık temadan koyuya
		    geçerken bir kare beyaz parlıyor. */}
		<script is:inline>
			try {
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					document.documentElement.classList.add('dark');
				}
			} catch {
				// Eşleştirme desteklenmiyorsa açık tema kullanılır.
			}
		</script>
	</head>
	<body class="p-kabuk">
		<a class="p-atla" href="#panel-icerik">İçeriğe geç</a>

		<header class="p-serit">
			<div class="p-serit-ic">
				<span class="p-marka">Panel</span>
				<nav class="p-gezinti" aria-label="Panel bölümleri">
					{
						PANELLER.map((panel) => (
							<a
								href={panel.adres}
								aria-current={panel.anahtar === aktif ? 'page' : undefined}
							>
								{panel.ad}
								{panel.disari && (
									<span class="p-dis-im" aria-hidden="true">
										↗
									</span>
								)}
							</a>
						))
					}
				</nav>
			</div>
		</header>

		<main id="panel-icerik" class="p-govde">
			<div class="p-basi">
				<h1 class="p-h1">{baslik}</h1>
				{not && <p class="p-basi-not">{not}</p>}
			</div>
			<slot />
		</main>
	</body>
</html>
