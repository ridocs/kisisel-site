---
import { durumGetir, neKadarOnce } from './durum';
import { CANLI_ADRES } from './sunucu.mjs';
import '../styles/global.css';

/*
  SİTE DURUMU VE YAYINLAMA

  Bu sayfa `src/pages/` altında DEĞİL; oraya konsaydı `astro build` onu üretir
  ve sunucu adresi, git durumu, taslak başlıkları internete açılırdı. Rotayı
  `astro.config.cms.mjs` içindeki eklenti bağlıyor, o yapılandırmayı da
  yalnızca `npm run yazi` okuyor.

  Sayfanın cevap verdiği soru tek: "yazdığım şey sitede görünüyor mu?"
  Kullanıcının bunu sormak zorunda kalmaması için her satır kendi kendine
  konuşuyor — sorun varsa renkleniyor, yoksa sessiz duruyor.

  Veri her istekte yeniden toplanıyor: dev sunucusu bileşeni her açılışta
  çalıştırdığı için ayrıca bir tazeleme düzeneğine gerek yok.
*/
const durum = await durumGetir();

/*
  Satırların tonu. Üç düzey yeterli çıktı:
  · sakin  — beklenen hâl, göz takılmasın
  · dikkat — bir şey eksik ama site ayakta
  · agir   — ziyaretçi şu anda etkileniyor

  Ton metinle birlikte tek yerde hesaplanıyor; şablonun içine serpiştirilmiş
  koşullar okunmaz hâle geliyordu.
*/
type Ton = 'sakin' | 'dikkat' | 'agir';
interface Satir {
	baslik: string;
	metin: string;
	ton: Ton;
	ayrinti?: string[];
}

const tarihBicimi = new Intl.DateTimeFormat('tr-TR', {
	dateStyle: 'long',
	timeStyle: 'short',
});

const satirlar: Satir[] = [];

/* 1 — Canlı site ayakta mı */
if (!durum.canli.ulasildi) {
	satirlar.push({
		baslik: 'Canlı site',
		metin: durum.canli.hata ?? 'Ulaşılamadı.',
		ton: 'agir',
	});
} else if (durum.canli.durumKodu !== 200) {
	satirlar.push({
		baslik: 'Canlı site',
		metin: `HTTP ${durum.canli.durumKodu} dönüyor — ziyaretçi sayfayı göremiyor.`,
		ton: 'agir',
	});
} else {
	satirlar.push({
		baslik: 'Canlı site',
		metin: `Ayakta · HTTP 200 · ${(durum.canli.sureMs / 1000).toFixed(1)} saniyede yanıt verdi.`,
		ton: durum.canli.sureMs > 4000 ? 'dikkat' : 'sakin',
	});
}

/* 2 — En son ne zaman yayınlandı */
if (!durum.sunucu.ulasildi) {
	satirlar.push({
		baslik: 'Son yayın',
		metin: `Sunucuya bağlanılamadı, bu yüzden bilinmiyor. ${durum.sunucu.hata ?? ''}`.trim(),
		ton: 'dikkat',
	});
} else if (!durum.sunucu.sonYayin) {
	satirlar.push({
		baslik: 'Son yayın',
		metin: 'Yayın dizininde `index.html` bulunamadı. Site hiç yayınlanmamış olabilir.',
		ton: 'agir',
	});
} else {
	satirlar.push({
		baslik: 'Son yayın',
		metin: `${tarihBicimi.format(durum.sunucu.sonYayin)} · ${neKadarOnce(
			durum.sunucu.sonYayin,
		)} · sunucuda ${durum.sunucu.dosyaSayisi} dosya.`,
		ton: 'sakin',
	});
}

/* 3 — Yayınlanmamış yazı var mı */
if (!durum.karsilastirilabildi) {
	satirlar.push({
		baslik: 'Yayınlanmamış yazı',
		metin:
			'Site haritası okunamadı, karşılaştırma yapılamadı. Yayında ne olduğu şu an bilinmiyor.',
		ton: 'dikkat',
	});
} else if (durum.yayinlanmamis.length === 0) {
	satirlar.push({
		baslik: 'Yayınlanmamış yazı',
		metin: `Yok. Taslak olmayan ${durum.toplamYazi - durum.taslaklar.length} yazının hepsi yayında.`,
		ton: 'sakin',
	});
} else {
	satirlar.push({
		baslik: 'Yayınlanmamış yazı',
		metin: `${durum.yayinlanmamis.length} yazı yazılmış ama yayında değil.`,
		ton: 'dikkat',
		ayrinti: durum.yayinlanmamis.map((y) => `${y.baslik} — ${y.yol}`),
	});
}

/* 4 — GitHub'a gönderilmemiş değişiklik */
{
	const { kaydedilmemis, gonderilmemis, dal, not } = durum.git;
	const parcalar: string[] = [];
	if (kaydedilmemis.length > 0) parcalar.push(`${kaydedilmemis.length} dosya kaydedilmemiş`);
	if (gonderilmemis !== null && gonderilmemis > 0) {
		parcalar.push(`${gonderilmemis} commit gönderilmemiş`);
	}
	if (not) parcalar.push(not);

	satirlar.push({
		baslik: 'GitHub',
		metin:
			parcalar.length === 0
				? `${dal} dalı temiz; her şey gönderilmiş.`
				: `${dal} dalı — ${parcalar.join(' · ')}.`,
		ton: parcalar.length === 0 ? 'sakin' : 'dikkat',
		ayrinti: kaydedilmemis.slice(0, 12),
	});
}

/* 5 — Taslak bekleyen yazılar */
satirlar.push({
	baslik: 'Taslaklar',
	metin:
		durum.taslaklar.length === 0
			? 'Taslak bekleyen yazı yok.'
			: `${durum.taslaklar.length} yazı taslakta; yayına bilerek çıkmıyor.`,
	// Taslak bir arıza değil, bilerek verilmiş bir karar. Renklenmesi ekranı
	// boş yere alarma boğardı.
	ton: 'sakin',
	ayrinti: durum.taslaklar.map((y) => `${y.baslik} — ${y.dosya}`),
});

/* 6 — Geri alınabilir sürüm */
const geriAlinabilir = durum.sunucu.ulasildi === true && durum.sunucu.eskiSurumVar === true;
satirlar.push({
	baslik: 'Geri alınabilir sürüm',
	metin: !durum.sunucu.ulasildi
		? 'Sunucuya bağlanılamadığı için bilinmiyor.'
		: geriAlinabilir
			? `Var${
					durum.sunucu.eskiSurumTarihi
						? ` · ${tarihBicimi.format(durum.sunucu.eskiSurumTarihi)}`
						: ''
				}. Yayın bozulursa tek tıkla dönülebilir.`
			: 'Yok. İlk yayından sonra oluşacak.',
	ton: 'sakin',
});

const sorunSayisi = satirlar.filter((s) => s.ton !== 'sakin').length;

const TON_NOKTASI: Record<Ton, string> = {
	sakin: 'bg-neutral-300 dark:bg-neutral-600',
	dikkat: 'bg-amber-500',
	agir: 'bg-red-500',
};

const TON_METNI: Record<Ton, string> = {
	sakin: 'text-neutral-600 dark:text-neutral-400',
	dikkat: 'text-amber-800 dark:text-amber-300',
	agir: 'text-red-800 dark:text-red-300',
};

const cekimAni = new Date().toLocaleString('tr-TR', {
	dateStyle: 'long',
	timeStyle: 'short',
});
---

<!doctype html>
<html lang="tr" class="bg-neutral-50 dark:bg-neutral-950">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Site durumu</title>
		{/* Panel yerelde çalışıyor ama yine de: bu sayfa hiçbir dizine girmemeli. */}
		<meta name="robots" content="noindex, nofollow" />
		{/* Sitenin kendi tema düzeneği `.dark` sınıfına bakıyor; panelde tema
		    değiştirici yok, işletim sisteminin tercihi doğrudan uygulanıyor. */}
		<script is:inline>
			try {
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					document.documentElement.classList.add('dark');
				}
			} catch {
				// Eşleştirme desteklenmiyorsa açık tema kullanılır.
			}
		</script>
	</head>
	<body
		class="min-h-svh bg-neutral-50 text-neutral-800 antialiased dark:bg-neutral-950 dark:text-neutral-200"
	>
		<div class="mx-auto max-w-4xl px-5 py-10">
			<header class="mb-8">
				<h1
					class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
				>
					Site durumu
				</h1>
				<p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
					{CANLI_ADRES} · {cekimAni} · {
						sorunSayisi === 0
							? 'her şey yolunda'
							: `${sorunSayisi} satır dikkat istiyor`
					}
				</p>
			</header>

			{/* DURUM SATIRLARI */}
			<section
				class="divide-y divide-neutral-200 overflow-hidden rounded-xl border border-neutral-200 bg-white dark:divide-neutral-800 dark:border-neutral-800 dark:bg-neutral-900"
			>
				{
					satirlar.map((satir) => (
						<div class="flex gap-3 p-4">
							<span
								class={`mt-1.5 h-2 w-2 shrink-0 rounded-full ${TON_NOKTASI[satir.ton]}`}
								aria-hidden="true"
							/>
							<div class="min-w-0 flex-1">
								<div class="text-xs font-medium tracking-wide text-neutral-500 uppercase dark:text-neutral-400">
									{satir.baslik}
								</div>
								<p class={`mt-0.5 text-sm ${TON_METNI[satir.ton]}`}>{satir.metin}</p>
								{satir.ayrinti && satir.ayrinti.length > 0 && (
									<ul class="mt-2 space-y-1">
										{satir.ayrinti.map((madde) => (
											<li class="truncate font-mono text-xs text-neutral-500 dark:text-neutral-400">
												{madde}
											</li>
										))}
									</ul>
								)}
							</div>
						</div>
					))
				}
			</section>

			{/* YAYINLAMA */}
			<section
				class="mt-8 rounded-xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900"
			>
				<h2 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
					Yayınla
				</h2>
				<p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
					İki adım: önce derlenip ne değişeceği gösteriliyor, sunucuya ancak siz
					onayladıktan sonra dokunuluyor.
				</p>

				<div class="mt-4 flex flex-wrap items-center gap-3">
					<button
						id="dugme-derle"
						type="button"
						class="rounded-lg bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-neutral-700 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-300"
					>
						Derle ve önizle
					</button>
					<label
						class="flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-400"
					>
						<input
							id="kutu-kuru"
							type="checkbox"
							class="h-4 w-4 rounded border-neutral-300 dark:border-neutral-700"
						/>
						Kuru çalıştırma (sunucuya dokunma, yalnızca komutları göster)
					</label>
				</div>

				{/* ÖNİZLEME — derleme bitene kadar gizli */}
				<div
					id="onizleme"
					hidden
					class="mt-5 rounded-lg border border-amber-300 bg-amber-50 p-4 dark:border-amber-900/60 dark:bg-amber-950/30"
				>
					<h3 class="text-sm font-semibold text-amber-900 dark:text-amber-200">
						Yayınlamadan önce onaylayın
					</h3>
					<div id="onizleme-ozet" class="mt-2 space-y-1 text-sm text-amber-900/90 dark:text-amber-200/80"></div>
					<p class="mt-3 text-xs text-amber-900/70 dark:text-amber-200/60">
						Şu anki sürüm sunucuda <code>web-sitem.eski</code> olarak saklanacak;
						yanlış giderse "Geri al" ile dönülebilir.
					</p>
					<div class="mt-4 flex flex-wrap gap-3">
						<button
							id="dugme-gonder"
							type="button"
							class="rounded-lg bg-amber-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-amber-700 disabled:cursor-not-allowed disabled:opacity-50"
						>
							Sunucuya yayınla
						</button>
						<button
							id="dugme-vazgec"
							type="button"
							class="rounded-lg border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800"
						>
							Vazgeç
						</button>
					</div>
				</div>

				{/* İŞLEM KAYDI — derleme yarım dakika sürüyor, boş ekran donma sanılıyor */}
				<pre
					id="kayit"
					hidden
					class="mt-5 max-h-80 overflow-auto rounded-lg bg-neutral-100 p-4 text-xs leading-relaxed whitespace-pre-wrap text-neutral-700 dark:bg-neutral-950 dark:text-neutral-300"></pre>
			</section>

			{/* GERİ ALMA */}
			<section
				class="mt-5 rounded-xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900"
			>
				<h2 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
					Geri al
				</h2>
				<p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
					{
						!durum.sunucu.ulasildi
							? 'Sunucuya bağlanılamadığı için geri alınacak bir sürüm olup olmadığı bilinmiyor; düğme bu yüzden kapalı.'
							: geriAlinabilir
								? 'Sunucudaki bir önceki sürümü yayına alır. Şu anki sürüm silinmez, yer değiştirir — geri almanın kendisi de geri alınabilir.'
								: 'Şu anda geri alınacak bir sürüm yok. İlk yayından sonra bu düğme çalışır.'
					}
				</p>
				<div class="mt-4">
					<button
						id="dugme-geri-al"
						type="button"
						disabled={!geriAlinabilir}
						class="rounded-lg border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-700 transition hover:bg-neutral-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800"
					>
						Önceki sürüme dön
					</button>
				</div>
				<div
					id="geri-al-onay"
					hidden
					class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-4 dark:border-amber-900/60 dark:bg-amber-950/30"
				>
					<p class="text-sm text-amber-900 dark:text-amber-200">
						Yayındaki sürüm kaldırılıp bir öncekiyle değiştirilecek. Emin misiniz?
					</p>
					<div class="mt-3 flex flex-wrap gap-3">
						<button
							id="dugme-geri-al-onayla"
							type="button"
							class="rounded-lg bg-amber-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-amber-700 disabled:cursor-not-allowed disabled:opacity-50"
						>
							Evet, geri al
						</button>
						<button
							id="dugme-geri-al-vazgec"
							type="button"
							class="rounded-lg border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800"
						>
							Vazgeç
						</button>
					</div>
				</div>
			</section>

			<p class="mt-6 text-xs leading-relaxed text-neutral-500 dark:text-neutral-400">
				Bu sayfa yalnızca panel kipinde var; yayın derlemesine girmiyor. Sayfayı
				yenilemek bütün ölçümleri baştan yapar.
			</p>
		</div>

		{/*
		  PANELDE JAVASCRIPT SERBEST — sitede değil.

		  "Ziyaretçiye sıfır JavaScript" kuralı yayın çıktısı için. Bu sayfa hiç
		  yayınlanmıyor; burada betik olmadan yayın sürerken ne olduğunu canlı
		  göstermenin yolu yok. Çerçeve yok, yalnızca düz betik.

		  `is:inline`: Astro'nun paketleyicisinden geçmesin, kaynakta ne yazıyorsa
		  o çalışsın.
		*/}
		<script is:inline>
			(() => {
				const dugmeDerle = document.getElementById('dugme-derle');
				const dugmeGonder = document.getElementById('dugme-gonder');
				const dugmeVazgec = document.getElementById('dugme-vazgec');
				const dugmeGeriAl = document.getElementById('dugme-geri-al');
				const dugmeGeriAlOnayla = document.getElementById('dugme-geri-al-onayla');
				const dugmeGeriAlVazgec = document.getElementById('dugme-geri-al-vazgec');
				const kutuKuru = document.getElementById('kutu-kuru');
				const onizleme = document.getElementById('onizleme');
				const onizlemeOzet = document.getElementById('onizleme-ozet');
				const geriAlOnay = document.getElementById('geri-al-onay');
				const kayit = document.getElementById('kayit');

				const RENK = {
					adim: 'color:inherit;font-weight:600',
					uyari: 'color:#b45309',
					hata: 'color:#b91c1c',
					bitti: 'color:#15803d;font-weight:600',
				};

				function kayitTemizle() {
					kayit.textContent = '';
					kayit.hidden = false;
				}

				function satirYaz(tur, metin) {
					const satir = document.createElement('div');
					if (RENK[tur]) satir.setAttribute('style', RENK[tur]);
					// Komut ve ham çıktı soluk dursun: gözün takılacağı yer adımlar.
					if (tur === 'cikti' || tur === 'komut' || tur === 'bilgi') {
						satir.setAttribute('style', 'opacity:.7');
					}
					satir.textContent = metin;
					kayit.appendChild(satir);
					// Yeni satır her zaman görünsün; kullanıcı elle kaydırmak zorunda
					// kalırsa uzun derlemede ekran donmuş görünüyor.
					kayit.scrollTop = kayit.scrollHeight;
				}

				/*
				  "Önceki sürüme dön" sunucuda geri alınacak sürüm yoksa baştan
				  kapalı geliyor. Kilidi açarken bu unutulursa düğme işlem bitince
				  kendiliğinden tıklanabilir hâle geliyordu — basan da "geri alınacak
				  sürüm yok" hatasıyla karşılaşıyordu. Başlangıç hâli saklanıyor.
				*/
				const geriAlBastanKapali = dugmeGeriAl.disabled;

				function dugmeleriKilitle(kilitli) {
					for (const d of [dugmeDerle, dugmeGonder, dugmeGeriAlOnayla]) {
						if (d) d.disabled = kilitli;
					}
					dugmeGeriAl.disabled = kilitli || geriAlBastanKapali;
				}

				/*
				  Sunucu NDJSON akıtıyor: her satır bir olay. Yanıtın tamamını
				  beklemek, derleme bitene kadar ekranda hiçbir şey göstermemek
				  demekti.
				*/
				async function islemCalistir(govde, olay) {
					dugmeleriKilitle(true);
					try {
						const yanit = await fetch('/durum/islem', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify(govde),
						});
						if (!yanit.ok || !yanit.body) {
							satirYaz('hata', 'Sunucu yanıt vermedi: HTTP ' + yanit.status);
							return null;
						}

						const okuyucu = yanit.body.getReader();
						const cozucu = new TextDecoder();
						let tampon = '';
						let sonuc = null;

						while (true) {
							const { done, value } = await okuyucu.read();
							if (done) break;
							tampon += cozucu.decode(value, { stream: true });
							const parcalar = tampon.split('\n');
							// Son parça yarım kalmış olabilir; tamponda bekliyor.
							tampon = parcalar.pop();
							for (const parca of parcalar) {
								if (!parca.trim()) continue;
								const olayVerisi = JSON.parse(parca);
								if (olayVerisi.tur === 'sonuc') sonuc = olayVerisi;
								else satirYaz(olayVerisi.tur, olayVerisi.metin);
							}
						}

						if (!sonuc) {
							satirYaz('hata', 'İşlem yarıda kesildi; sonuç bilgisi gelmedi.');
							return null;
						}
						if (!sonuc.basarili) {
							satirYaz('hata', sonuc.hata || 'Bilinmeyen hata.');
							return null;
						}
						if (olay) olay(sonuc);
						return sonuc;
					} catch (hata) {
						satirYaz('hata', 'İstek başarısız: ' + (hata && hata.message));
						return null;
					} finally {
						dugmeleriKilitle(false);
					}
				}

				function listeCumlesi(baslik, liste) {
					if (!liste || liste.length === 0) return null;
					const gosterilen = liste.slice(0, 8).join(', ');
					const kalan = liste.length > 8 ? ' … (+' + (liste.length - 8) + ')' : '';
					return baslik + ': ' + gosterilen + kalan;
				}

				function onizlemeyiKur(sonuc) {
					onizlemeOzet.textContent = '';
					const cumleler = [sonuc.sayfalar.length + ' sayfa derlendi.'];

					if (!sonuc.karsilastirma) {
						cumleler.push(
							'Yayındaki site haritası okunamadı; neyin değişeceği karşılaştırılamadı.',
						);
					} else {
						const yeni = listeCumlesi('Yayına girecek yeni sayfa', sonuc.karsilastirma.yeni);
						const kaybolan = listeCumlesi(
							'Yayından kalkacak sayfa',
							sonuc.karsilastirma.kaybolan,
						);
						if (yeni) cumleler.push(yeni);
						if (kaybolan) cumleler.push(kaybolan);
						if (!yeni && !kaybolan) {
							cumleler.push(
								'Sayfa listesi yayındakiyle aynı; yalnızca sayfaların içeriği değişmiş olabilir.',
							);
						}
					}

					if (kutuKuru.checked) {
						cumleler.push('KURU ÇALIŞTIRMA açık: sunucuya hiçbir şey gönderilmeyecek.');
					}

					for (const cumle of cumleler) {
						const p = document.createElement('p');
						p.textContent = cumle;
						onizlemeOzet.appendChild(p);
					}
					onizleme.hidden = false;
				}

				dugmeDerle.addEventListener('click', async () => {
					onizleme.hidden = true;
					kayitTemizle();
					await islemCalistir({ islem: 'derle' }, onizlemeyiKur);
				});

				dugmeGonder.addEventListener('click', async () => {
					const kuru = kutuKuru.checked;
					onizleme.hidden = true;
					satirYaz('adim', kuru ? '— kuru çalıştırma başladı —' : '— yayın başladı —');
					const sonuc = await islemCalistir({ islem: 'gonder', kuru: kuru });
					// Gerçek yayından sonra durum satırları eskiyor; sayfa kendini
					// tazeliyor ki "son yayın" ve "yayınlanmamış yazı" doğru olsun.
					if (sonuc && !kuru) setTimeout(() => location.reload(), 2500);
				});

				dugmeVazgec.addEventListener('click', () => {
					onizleme.hidden = true;
					satirYaz('uyari', 'Vazgeçildi; sunucuya dokunulmadı.');
				});

				dugmeGeriAl.addEventListener('click', () => {
					geriAlOnay.hidden = false;
				});

				dugmeGeriAlVazgec.addEventListener('click', () => {
					geriAlOnay.hidden = true;
				});

				dugmeGeriAlOnayla.addEventListener('click', async () => {
					const kuru = kutuKuru.checked;
					geriAlOnay.hidden = true;
					kayitTemizle();
					const sonuc = await islemCalistir({ islem: 'geri-al', kuru: kuru });
					if (sonuc && !kuru) setTimeout(() => location.reload(), 2500);
				});
			})();
		</script>
	</body>
</html>
