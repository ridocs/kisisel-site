---
import { ozetGetir, GUN_SAYISI } from './kayitlar';
import Kabuk from '../panel/Kabuk.astro';

/*
  ZİYARETÇİ PANELİ

  Bu sayfa `src/pages/` altında DEĞİL; oraya konsaydı `astro build` onu üretir
  ve ziyaretçi verisi internete açılırdı. Rotayı `astro.config.cms.mjs`
  içindeki eklenti bağlıyor, o yapılandırmayı da yalnızca `npm run yazi`
  okuyor. Yayın derlemesi bu dosyayı hiç görmüyor.

  Veri her istekte yeniden çekiliyor: dev sunucusu bileşeni her açılışta
  çalıştırdığı için ayrıca bir tazeleme düzeneğine gerek yok.

  Belgenin kabuğu (üst şerit, tipografi, renk değişkenleri) `src/panel/`
  altında; üç panel ekranı da aynı kabuktan geçiyor. Grafikler saf CSS —
  kütüphane yok, ziyaretçiye de zaten hiçbir şey inmiyor.
*/
const sonuc = await ozetGetir();

// Çubukların yüksekliği en yoğun güne göre oranlanıyor; sabit bir tavan
// seçilseydi sakin bir haftada bütün çubuklar ezilmiş görünürdü.
const enYogunGun = sonuc.basarili
	? Math.max(1, ...sonuc.ozet.gunler.map((g) => g.goruntuleme))
	: 1;

/*
  Saat ve hafta günü grafikleri de kendi en yoğun değerlerine oranlanıyor,
  günlük grafiğin tavanına değil: 24 saate bölünmüş bir gün, günün kendisinden
  zorunlu olarak daha alçak çubuklar üretir ve ortak tavan hepsini ezerdi.
*/
const enYogunSaat = sonuc.basarili
	? Math.max(1, ...sonuc.ozet.saatler.map((s) => s.goruntuleme))
	: 1;
const enYogunHaftaGunu = sonuc.basarili
	? Math.max(1, ...sonuc.ozet.haftaGunleri.map((g) => g.goruntuleme))
	: 1;

/*
  Doruk noktaları ayrıca yazıyla söyleniyor. Trafik düşükken çubukların
  hepsi birbirine yakın kalıyor ve grafiğe bakarak "hangi saat" sorusunu
  yanıtlamak zor; tek cümlelik özet az veride grafiğin yapamadığını yapıyor.
*/
const dorukSaat =
	sonuc.basarili && sonuc.ozet.saatler.some((s) => s.goruntuleme > 0)
		? sonuc.ozet.saatler.reduce((a, b) => (b.goruntuleme > a.goruntuleme ? b : a))
		: null;
const dorukGun =
	sonuc.basarili && sonuc.ozet.haftaGunleri.some((g) => g.goruntuleme > 0)
		? sonuc.ozet.haftaGunleri.reduce((a, b) => (b.goruntuleme > a.goruntuleme ? b : a))
		: null;

function yuzde(sayi: number, toplam: number): string {
	if (!toplam) return '0';
	return ((sayi / toplam) * 100).toFixed(0);
}

/*
  Değişim yüzdesi. Önceki hafta sıfırsa `null` dönüyor: sıfıra bölme bir yana,
  "sonsuz artış" diye bir ölçü yok. Sayfa bu durumda yüzde yerine "geçen hafta
  kayıt yok" diyor — site 14 Eylül 2026'da yayına girdi, ilk haftalarda bu
  olağan.
*/
function degisim(simdi: number, once: number): number | null {
	if (once === 0) return null;
	return Math.round(((simdi - once) / once) * 100);
}

/*
  İşaret yüzde imininin ÖNÜNE yazılıyor ve sayı mutlak değerle basılıyor:
  Türkçede yüzde imi sayının başına geliyor, düz birleştirme "%-25" gibi
  okunmayan bir dizi üretiyordu.
*/
function degisimMetni(deger: number): string {
	if (deger === 0) return 'değişim yok';
	return `${deger > 0 ? '+' : '−'}%${Math.abs(deger)}`;
}

/*
  Değişim rozetinin yönü SİMGEYLE de söyleniyor (▲ ▼ =). Renk körü bir
  kullanıcı yeşil ile griyi ayırt edemeyebilir; ok ve işaret her koşulda
  okunuyor. Yalnızca artış renkli, düşüş nötr: düşüşü kırmızı boyamak sakin
  bir haftayı hata gibi gösterirdi.
*/
function degisimImi(deger: number): string {
	if (deger > 0) return '▲';
	if (deger < 0) return '▼';
	return '=';
}

const cekimAni = new Date().toLocaleString('tr-TR', {
	dateStyle: 'long',
	timeStyle: 'short',
});
---

<Kabuk
	baslik="Ziyaretçi istatistiği"
	aktif="istatistik"
	not={`twinshareapp.com/web-sitem · nginx erişim kayıtlarından · ${cekimAni}`}
>
	{
		!sonuc.basarili && (
			<div role="alert" class="p-uyari p-uyari--agir">
				<h2 class="p-uyari-baslik">
					<span class="p-im p-metin-agir" aria-hidden="true">
						✕
					</span>
					Kayıtlara ulaşılamadı
				</h2>
				<p class="p-not">{sonuc.hata}</p>
				<p class="p-not p-not--kisik">
					Sayfayı yenilemek yeniden dener. Kayıtlar sunucuda duruyor, bir şey
					kaybolmadı.
				</p>
			</div>
		)
	}

	{
		sonuc.basarili && (
			<div class="p-yigin">
				{/* ÖZET KUTULARI */}
				<section class="p-izgara p-izgara--4">
					<div class="p-kart p-kart--sikisik">
						<div class="p-olcu-sayi">{sonuc.ozet.toplamZiyaretci}</div>
						<div class="p-olcu-ad">Tekil ziyaretçi</div>
					</div>
					<div class="p-kart p-kart--sikisik">
						<div class="p-olcu-sayi">{sonuc.ozet.toplamGoruntuleme}</div>
						<div class="p-olcu-ad">Sayfa görüntüleme</div>
					</div>
					<div class="p-kart p-kart--sikisik">
						<div class="p-olcu-sayi">
							{sonuc.ozet.toplamZiyaretci
								? (sonuc.ozet.toplamGoruntuleme / sonuc.ozet.toplamZiyaretci).toFixed(1)
								: '0'}
						</div>
						<div class="p-olcu-ad">Kişi başına sayfa</div>
					</div>
					<div class="p-kart p-kart--sikisik">
						<div class="p-olcu-sayi">{GUN_SAYISI}</div>
						<div class="p-olcu-ad">Günlük pencere</div>
					</div>
				</section>

				{/* HAFTA KARŞILAŞTIRMASI — arşiv 14 gün, yani tam iki hafta */}
				<section class="p-kart">
					<h2 class="p-kart-baslik">Bu hafta / geçen hafta</h2>
					<p class="p-not">
						Son 7 gün, ondan önceki 7 güne karşı. Arşiv {GUN_SAYISI} gün tuttuğu için
						daha uzun bir dönem yok.
					</p>
					<div class="p-izgara p-izgara--2 p-kart-govde">
						{[
							{
								baslik: 'Sayfa görüntüleme',
								simdi: sonuc.ozet.karsilastirma.buHafta.goruntuleme,
								once: sonuc.ozet.karsilastirma.gecenHafta.goruntuleme,
							},
							{
								baslik: 'Tekil ziyaretçi',
								simdi: sonuc.ozet.karsilastirma.buHafta.ziyaretci,
								once: sonuc.ozet.karsilastirma.gecenHafta.ziyaretci,
							},
						].map((olcum) => {
							const fark = degisim(olcum.simdi, olcum.once);
							return (
								<div class="p-kart p-kart--sikisik">
									<div class="p-olcu-ad" style="margin-top: 0">
										{olcum.baslik}
									</div>
									<div class="p-kart-basi" style="margin-top: 6px">
										<span class="p-olcu-sayi p-olcu-sayi--orta">{olcum.simdi}</span>
										{/*
										  Karşılaştırma yapılamıyorsa rozet hiç basılmıyor:
										  altındaki satır zaten sebebini söylüyor, ikisi yan yana
										  aynı şeyi iki kez söylemiş oluyordu.
										*/}
										{fark !== null && (
											<span
												class={`p-rozet ${fark > 0 ? 'p-rozet--iyi' : 'p-rozet--notr'}`}
											>
												<span class="p-im" aria-hidden="true">
													{degisimImi(fark)}
												</span>
												{degisimMetni(fark)}
											</span>
										)}
									</div>
									<p class="p-not p-not--kisik">
										{olcum.once === 0
											? 'Geçen hafta kayıt yok'
											: `Geçen hafta: ${olcum.once}`}
									</p>
								</div>
							);
						})}
					</div>
				</section>

				{/* GÜNLÜK GRAFİK — saf CSS; kütüphane yok */}
				<section class="p-kart">
					<div class="p-kart-basi">
						<h2 class="p-kart-baslik">Son {GUN_SAYISI} gün</h2>
						<span class="p-not" style="margin-top: 0">
							Çubuk: görüntüleme · Alt rakam: o günün tekil ziyaretçisi
						</span>
					</div>
					<div class="p-grafik p-kart-govde">
						{sonuc.ozet.gunler.map((gun) => (
							<div class="p-sutun">
								<span class="p-sutun-ust">{gun.goruntuleme || ''}</span>
								{/*
								  Yükseklik satır içi stille veriliyor: değer veriden geliyor,
								  Tailwind sınıfı ya da hazır bir CSS sınıfı derleme anında
								  bilinemez. Sıfır günlerde 2 piksellik bir iz kalıyor ki eksen
								  boyunca günün var olduğu görünsün.
								*/}
								<div
									class={gun.goruntuleme ? 'p-cubuk' : 'p-cubuk p-cubuk--bos'}
									style={`height: ${Math.max(2, Math.round((gun.goruntuleme / enYogunGun) * 120))}px`}
									title={`${gun.etiket}: ${gun.goruntuleme} görüntüleme, ${gun.ziyaretci} ziyaretçi`}
								/>
								<span class="p-sutun-alt">{gun.etiket}</span>
								<span class="p-sutun-sayi">{gun.ziyaretci || '·'}</span>
							</div>
						))}
					</div>
				</section>

				{/* SAAT DAĞILIMI — yazıyı ne zaman paylaşmanın anlamlı olduğu */}
				<section class="p-kart">
					<h2 class="p-kart-baslik">Günün saatleri</h2>
					<p class="p-not">
						{dorukSaat
							? `En yoğun saat ${String(dorukSaat.saat).padStart(2, '0')}.00–${String(
									(dorukSaat.saat + 1) % 24,
								).padStart(2, '0')}.00 · ${dorukSaat.goruntuleme} görüntüleme`
							: 'Henüz saat dağılımı oluşacak kadar ziyaret yok.'}{' '}
						Saatler Türkiye saatiyle.
					</p>
					<div class="p-grafik p-grafik--sik p-kart-govde">
						{sonuc.ozet.saatler.map((dilim) => (
							<div class="p-sutun">
								{/*
								  Ziyaretsiz saatte 2 piksellik iz bırakılıyor ki eksen
								  kesintisiz görünsün — günlük grafikteki kuralın aynısı.
								*/}
								<div
									class={dilim.goruntuleme ? 'p-cubuk' : 'p-cubuk p-cubuk--bos'}
									style={`height: ${Math.max(2, Math.round((dilim.goruntuleme / enYogunSaat) * 90))}px`}
									title={`${String(dilim.saat).padStart(2, '0')}.00 — ${dilim.goruntuleme} görüntüleme`}
								/>
								{/*
								  Etiketler üçte bir seyreltiliyor: 24 rakam yan yana telefonda
								  okunmuyor, üst üste biniyordu.
								*/}
								<span class="p-sutun-alt">
									{dilim.saat % 3 === 0 ? String(dilim.saat).padStart(2, '0') : ''}
								</span>
							</div>
						))}
					</div>
				</section>

				<div class="p-izgara p-izgara--2">
					{/* HAFTANIN GÜNÜ — yatay çubuk: gün adları dikey eksende okunmuyordu */}
					<section class="p-kart">
						<h2 class="p-kart-baslik">Haftanın günü</h2>
						<p class="p-not">
							{dorukGun
								? `En yoğun gün ${dorukGun.ad} · ${dorukGun.goruntuleme} görüntüleme`
								: 'Henüz gün dağılımı oluşacak kadar ziyaret yok.'}
						</p>
						<ul class="p-liste p-kart-govde">
							{sonuc.ozet.haftaGunleri.map((gun) => (
								<li class="p-yatay">
									<span class="p-yatay-ad">{gun.ad}</span>
									<span class="p-yatay-oran">
										<span class="p-oran" style="margin-top: 0">
											<span
												class="p-oran-dolgu"
												style={`width: ${(gun.goruntuleme / enYogunHaftaGunu) * 100}%`}
											/>
										</span>
									</span>
									<span class="p-yatay-sayi">{gun.goruntuleme || '·'}</span>
								</li>
							))}
						</ul>
						<p class="p-not p-not--kisik p-ayrac">
							{GUN_SAYISI} günlük pencere her günü iki kez kapsıyor; ziyaret almamış
							günler boş kalıyor.
						</p>
					</section>

					{/* YENİ Mİ, DÖNEN Mİ — aynı karma birden fazla günde görüldüyse dönen */}
					<section class="p-kart">
						<h2 class="p-kart-baslik">Yeni mi, dönen mi</h2>
						<p class="p-not">
							Ayrı günlerde yeniden görünen ziyaretçi "dönen" sayılıyor
						</p>
						<div class="p-izgara p-izgara--2 p-kart-govde">
							<div>
								<div class="p-olcu-sayi">{sonuc.ozet.ziyaretciTuru.donen}</div>
								<div class="p-olcu-ad">Dönen ziyaretçi</div>
							</div>
							<div>
								<div class="p-olcu-sayi p-olcu-sayi--kisik">
									{sonuc.ozet.ziyaretciTuru.yeni}
								</div>
								<div class="p-olcu-ad">Tek gün görünen</div>
							</div>
						</div>
						{/* Tek çubuk iki payı da gösteriyor; iki ayrı çubuk oranı gizler,
						    asıl soru "kaçta kaçı" olduğu için yığılı duruyor. */}
						<div class="p-oran p-oran--kalin p-kart-govde">
							<span
								class="p-oran-dolgu"
								style={`width: ${yuzde(sonuc.ozet.ziyaretciTuru.donen, sonuc.ozet.toplamZiyaretci)}%`}
							/>
							<span
								class="p-oran-dolgu p-oran-dolgu--ikinci"
								style={`width: ${yuzde(sonuc.ozet.ziyaretciTuru.yeni, sonuc.ozet.toplamZiyaretci)}%`}
							/>
						</div>
						<p class="p-not p-not--kisik">
							{sonuc.ozet.toplamZiyaretci
								? `${sonuc.ozet.toplamZiyaretci} kişinin %${yuzde(
										sonuc.ozet.ziyaretciTuru.donen,
										sonuc.ozet.toplamZiyaretci,
									)}'i geri geldi.`
								: 'Henüz ziyaretçi yok.'}{' '}
							Ölçü {GUN_SAYISI} günlük pencereyle sınırlı: daha önce gelmiş biri
							pencerede yoksa yeni görünür.
						</p>
					</section>
				</div>

				{/* LİSTELER */}
				<div class="p-izgara p-izgara--2">
					<section class="p-kart">
						<h2 class="p-kart-baslik">En çok okunan sayfalar</h2>
						<ul class="p-liste p-kart-govde">
							{sonuc.ozet.sayfalar.map((satir) => (
								<li>
									<div class="p-kv">
										<span class="p-kv-ad">{satir.ad}</span>
										<span class="p-kv-deger">{satir.sayi}</span>
									</div>
									<div class="p-oran">
										<div
											class="p-oran-dolgu"
											style={`width: ${yuzde(satir.sayi, sonuc.ozet.toplamGoruntuleme)}%`}
										/>
									</div>
								</li>
							))}
						</ul>
					</section>

					{/* YAZI BAŞINA OKUNMA — sayfa listesinden ayrı: asıl merak edilen bu */}
					<section class="p-kart">
						<h2 class="p-kart-baslik">Yazı başına okunma</h2>
						<p class="p-not">
							Blog dizini değil, yazıların kendisi. Adlar dosya adı; başlıklar
							içerikte duruyor
						</p>
						{sonuc.ozet.yazilar.length === 0 ? (
							<p class="p-not p-not--kisik p-kart-govde">
								Bu pencerede hiçbir yazı açılmamış.
							</p>
						) : (
							<ul class="p-liste p-kart-govde">
								{sonuc.ozet.yazilar.map((satir) => (
									<li>
										<div class="p-kv">
											<span class="p-kv-ad">{satir.ad}</span>
											<span class="p-kv-deger">{satir.sayi}</span>
										</div>
										{/*
										  Oran yazılar arasında kuruluyor, toplam görüntülemeye göre
										  değil: en çok okunan yazı çubuğu doldursun, yoksa birkaç
										  okumalık bir listede bütün çubuklar görünmez bir çizgiye
										  iniyordu.
										*/}
										<div class="p-oran">
											<div
												class="p-oran-dolgu"
												style={`width: ${yuzde(satir.sayi, sonuc.ozet.yazilar[0].sayi)}%`}
											/>
										</div>
									</li>
								))}
							</ul>
						)}
					</section>

					<section class="p-kart">
						<h2 class="p-kart-baslik">Nereden geldiler</h2>
						<ul class="p-liste p-kart-govde">
							{sonuc.ozet.kaynaklar.map((satir) => (
								<li>
									<div class="p-kv">
										<span class="p-kv-ad">{satir.ad}</span>
										<span class="p-kv-deger">{satir.sayi}</span>
									</div>
									<div class="p-oran">
										<div
											class="p-oran-dolgu"
											style={`width: ${yuzde(satir.sayi, sonuc.ozet.toplamGoruntuleme)}%`}
										/>
									</div>
								</li>
							))}
						</ul>
					</section>

					{/* 404 — kırık bağlantılar. Sayfa görüntüleme sayımına girmiyor. */}
					<section class="p-kart">
						<h2 class="p-kart-baslik">404 alan adresler</h2>
						<p class="p-not">
							{sonuc.ozet.bulunamayanToplam} istek karşılık bulamadı. Bu sayılar
							yukarıdaki görüntülemelere dâhil değil
						</p>
						{sonuc.ozet.bulunamayanlar.length === 0 ? (
							<p class="p-not p-not--kisik p-kart-govde">
								Kırık bağlantı yok: bu pencerede hiçbir adres 404 vermedi.
							</p>
						) : (
							<ul class="p-liste p-kart-govde">
								{sonuc.ozet.bulunamayanlar.map((satir) => (
									<li>
										<div class="p-kv">
											<span class="p-kv-ad p-kv-ad--kod">{satir.yol}</span>
											<span class="p-kv-deger p-metin-dikkat">{satir.sayi}</span>
										</div>
										{/*
										  Kaynak burada rakam kadar önemli: "Site içi gezinme"
										  görünüyorsa kırık bağlantı bizim sayfamızda ve
										  düzeltilebilir; "Doğrudan" ise adres elle yazılmış.
										*/}
										<div class="p-not p-not--kisik" style="margin-top: 2px">
											Nereden: {satir.kaynaklar.join(', ')}
										</div>
									</li>
								))}
							</ul>
						)}
					</section>

					<section class="p-kart">
						<h2 class="p-kart-baslik">Cihaz</h2>
						<ul class="p-liste p-kart-govde">
							{sonuc.ozet.cihazlar.map((satir) => (
								<li class="p-kv">
									<span class="p-kv-ad">{satir.ad}</span>
									<span class="p-kv-deger">
										{satir.sayi}
										<span class="p-kv-yuzde">
											%{yuzde(satir.sayi, sonuc.ozet.toplamGoruntuleme)}
										</span>
									</span>
								</li>
							))}
						</ul>
					</section>

					<section class="p-kart">
						<h2 class="p-kart-baslik">Tarayıcı</h2>
						<ul class="p-liste p-kart-govde">
							{sonuc.ozet.tarayicilar.map((satir) => (
								<li class="p-kv">
									<span class="p-kv-ad">{satir.ad}</span>
									<span class="p-kv-deger">
										{satir.sayi}
										<span class="p-kv-yuzde">
											%{yuzde(satir.sayi, sonuc.ozet.toplamGoruntuleme)}
										</span>
									</span>
								</li>
							))}
						</ul>
					</section>
				</div>

				{/* ELEME DÖKÜMÜ — rakamın neyi saymadığı, rakamın kendisi kadar önemli */}
				<section class="p-kart">
					<h2 class="p-kart-baslik">Eleme dökümü</h2>
					<p class="p-not">
						Sunucudan gelen {sonuc.ozet.eleme.toplamSatir} satırın kaçı neden
						sayılmadı
					</p>
					<dl class="p-dokum p-kart-govde">
						<div class="p-dokum-satir">
							<dt>Robotlar</dt>
							<dd>−{sonuc.ozet.eleme.robot}</dd>
						</div>
						<div class="p-dokum-satir">
							<dt>Kendi testlerimiz</dt>
							<dd>−{sonuc.ozet.eleme.kendiIstegimiz}</dd>
						</div>
						<div class="p-dokum-satir">
							<dt>Statik dosyalar</dt>
							<dd>−{sonuc.ozet.eleme.varlik}</dd>
						</div>
						<div class="p-dokum-satir">
							{/* 404'ler bu kovanın içinde: yönlendirmeler ve hatalar da burada
							    sayıldığı için iki rakam birbirini tutmuyor görünebilir, bu
							    yüzden pay açıkça yazılıyor. */}
							<dt>
								Diğer durum kodları
								<span class="p-kv-yuzde">({sonuc.ozet.bulunamayanToplam}'i 404)</span>
							</dt>
							<dd>−{sonuc.ozet.eleme.durum}</dd>
						</div>
						<div class="p-dokum-satir p-dokum-satir--toplam">
							<dt>Sayılan</dt>
							<dd>{sonuc.ozet.eleme.kalan}</dd>
						</div>
					</dl>
				</section>

				<p class="p-dipnot">
					Tekil ziyaretçi, IP ve tarayıcı kimliğinin karmasıyla sayılıyor; ham IP
					hiçbir yere yazılmıyor. Kayıt aralığı: {sonuc.ozet.ilkKayit ?? '—'} →{' '}
					{sonuc.ozet.sonKayit ?? '—'}. Bu sayfa yalnızca panel kipinde var; yayın
					derlemesine girmiyor.
				</p>
			</div>
		)
	}
</Kabuk>
