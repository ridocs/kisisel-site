---
/*
  Tek talebin yazışması.

  `talepGetir` müşteri kimliği olmadan ÇAĞRILAMAZ: imzası iki argüman
  istiyor ve sorgu `WHERE id = ? AND musteri_id = ?` diyor. Başka bir
  müşterinin talep kimliği elle adres çubuğuna yazılsa bile buradan 404
  dönüyor; "var ama göremezsin" bile denmiyor.

  Yazışma baloncuk değil kart dizisi: panelde konuşulan şey çoğunlukla teknik
  ve uzun, baloncuk o metni okunmaz yapıyor. İki tarafı sol kenarlığın rengi
  ve her mesajda yazılı olan ad ayırıyor, yani ayrım yalnızca renge bağlı
  değil.
*/
import Kabuk from '../../duzen/Kabuk.astro';
import Canli from '../../duzen/Canli.astro';
import { ayarlar } from '../../sunucu/ayarlar.mjs';
import { islemAnahtariGecerliMi } from '../../sunucu/csrf.mjs';
import { panelVt } from '../../sunucu/veritabani.mjs';
import { makineZamani, zaman } from '../../sunucu/bicim.mjs';
import { METIN_EN_COK, mesajYaz, talepGetir, talepDurumEtiketi } from '../../sunucu/talepler.mjs';

export const prerender = false;

const taban = Astro.locals.taban ?? '';
const musteri = Astro.locals.musteri;
const db = panelVt();
const { id } = Astro.params;

let hata = '';
/* Hatada yazılan metin kaybolmasın diye geri basılıyor. */
let yazilan = '';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData().catch(() => null);
	const anahtar = form?.get('islem_anahtari');
	const metin = form?.get('metin');
	yazilan = typeof metin === 'string' ? metin : '';
	if (!islemAnahtariGecerliMi(Astro.locals.oturumKarmasi, ayarlar.gizli.csrf, typeof anahtar === 'string' ? anahtar : '')) {
		hata = 'Form doğrulanamadı. Sayfayı tazeleyip yeniden deneyin.';
	} else {
		const sonuc = mesajYaz(db, { musteriId: musteri.id, talepId: id, metin: yazilan });
		/*
		  Başarıda yönlendirme (POST sonrası GET): tazelemede mesajın ikinci
		  kez gönderilmesini engelliyor.
		*/
		if (sonuc.tamam) return Astro.redirect(`${taban}/talepler/${id}`, 303);
		hata = sonuc.hata;
	}
}

const talep = talepGetir(db, musteri.id, id);
if (!talep) return new Response('Bulunamadı', { status: 404 });

const kapali = talep.durum === 'kapandi';
const mesajSayisi = talep.mesajlar.length;

/*
  Canlı akışın başlangıç damgası: sayfaya basılmış en son hareket. Akış
  bundan öncesini tekrar göndermiyor, dolayısıyla açılışta liste ikilenmiyor.
  Talebin `guncellendi` değeri de hesaba katılıyor; mesajsız bir durum
  değişikliği yalnızca orada görünüyor.
*/
const sonMesajZamani = mesajSayisi > 0 ? talep.mesajlar[mesajSayisi - 1].zaman : talep.olusturuldu;
const bilinenDamga = sonMesajZamani > talep.guncellendi ? sonMesajZamani : talep.guncellendi;
---

<Kabuk baslik={talep.baslik} aktif="talepler">
	<p class="geri"><a href={`${taban}/talepler`}>← Bütün talepler</a></p>

	<div class="sayfa-bas">
		<p class="ust-etiket">DESTEK TALEBİ</p>
		<h1>{talep.baslik}</h1>
		<div class="cizgi" aria-hidden="true"></div>
		<div class="meta">
			<span class="rozet" data-durum={talep.durum} data-talep-rozet>
				{talepDurumEtiketi(talep.durum)}
			</span>
			{talep.is_adi && <p>İlgili iş: {talep.is_adi}</p>}
			<p>
				Açılış: <time datetime={makineZamani(talep.olusturuldu)}>{zaman(talep.olusturuldu)}</time>
			</p>
			<p data-mesaj-sayisi>{mesajSayisi === 1 ? '1 mesaj' : `${mesajSayisi} mesaj`}</p>
		</div>
	</div>

	<Canli kip="yazisma" talep={talep.id} bilinen={bilinenDamga} ad={musteri.gorunen_ad} />

	{
		hata && (
			<p class="bildirim" data-tur="hata" role="alert">
				{hata}
			</p>
		)
	}

	<ul class="mesajlar" aria-label="Yazışma">
		{
			talep.mesajlar.map((mesaj) => (
				/*
				  `data-mesaj-id`: akışla gelen bir mesajın zaten basılı olup
				  olmadığı buradan anlaşılıyor. Müşteri mesajını gönderdikten
				  sonra sayfa yeniden yükleniyor ve aynı mesaj akıştan da
				  gelebiliyor; kimlik olmadan ikilenirdi.
				*/
				<li class="mesaj" data-yazan={mesaj.yazan} data-mesaj-id={mesaj.id}>
					<div class="mesaj-bas">
						<span class="mesaj-yazan">
							{mesaj.yazan === 'musteri' ? musteri.gorunen_ad : 'Mustafa Eybek'}
						</span>
						{mesaj.yazan === 'musteri' && <span>siz</span>}
						<time datetime={makineZamani(mesaj.zaman)}>{zaman(mesaj.zaman)}</time>
					</div>
					<p class="mesaj-metin">{mesaj.metin}</p>
				</li>
			))
		}
	</ul>

	{
		kapali ? (
			<div class="bos dar">
				<strong class="bos-baslik">Bu talep kapandı.</strong>
				<p class="bos-metin">
					Kapanmış bir talebe mesaj yazılamıyor. Konu yeniden açılması
					gerekiyorsa yeni bir talep açın ve bu talebin başlığını yazın;
					yazışmanın tamamı burada duruyor.
				</p>
				<a class="dugme birincil" href={`${taban}/talepler#yeni-talep`}>
					Yeni talep açın
				</a>
			</div>
		) : (
			<section class="kart dar" aria-labelledby="yanit-basligi">
				<h2 id="yanit-basligi">Yanıt yazın</h2>
				<form method="post">
					<input type="hidden" name="islem_anahtari" value={Astro.locals.islemAnahtari} />
					<label class="alan">
						<span>Mesajınız</span>
						<textarea name="metin" maxlength={METIN_EN_COK} required aria-describedby="yanit-yardim"
							>{yazilan}</textarea
						>
						<span class="alan-yardim" id="yanit-yardim">
							Yazdığınızda talep yeniden açılır ve sıraya girer. En çok {METIN_EN_COK}{' '}
							karakter.
						</span>
					</label>
					<button class="dugme birincil" type="submit">Gönder</button>
				</form>
			</section>
		)
	}
</Kabuk>
