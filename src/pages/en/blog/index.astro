---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import YaziKarti from '../../../components/YaziKarti.astro';
import { cevirici, dilBul, yol } from '@/i18n/ceviriler';

const dil = dilBul(Astro.url);
const m = cevirici(dil);

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.dil === dil)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={m('blog.sayfaBasligi')} description={m('blog.aciklama')}>
	<h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">{m('blog.baslik')}</h1>

	<ul class="blog-izgara">
		{posts.map((post) => (
			<li>
				<YaziKarti yazi={post} />
			</li>
		))}
	</ul>

	<style>
		/* Ana sayfadaki Son yazılar ile aynı ızgara: iki yerde farklı bir kart
		   düzeni olsaydı aynı yazı iki farklı biçimde görünürdü. */
		.blog-izgara {
			list-style: none;
			padding: 0;
			margin: 2rem 0 0;
			display: grid;
			gap: 1rem;
			grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		}
	</style>
</BaseLayout>
