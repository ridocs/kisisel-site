---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjelerIcerik from '../../components/ProjelerIcerik.astro';
import { cevirici, dilBul } from '@/i18n/ceviriler';

/* Türkçe eşi: /projeler. Gövde aynı bileşen; dil `Astro.url`'den çözülüyor. */

const dil = dilBul(Astro.url);
const m = cevirici(dil);
---

<BaseLayout title={m('projeler.baslik')} description={m('projeler.aciklama')}>
	<ProjelerIcerik />
</BaseLayout>
