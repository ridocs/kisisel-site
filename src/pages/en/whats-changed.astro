---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DegisiklikIcerik from '../../components/DegisiklikIcerik.astro';
import { cevirici, dilBul } from '@/i18n/ceviriler';

/*
  Türkçe /neler-degisti sayfasının eşi. Gövde aynı bileşenden geliyor; dil yol
  adından (/en/...) çıkarılıyor, bu yüzden bileşene ayrıca bir şey
  geçirilmiyor.
*/

const dil = dilBul(Astro.url);
const m = cevirici(dil);
---

<BaseLayout title={m('degisiklik.sayfaBasligi')} description={m('degisiklik.aciklama')}>
	<DegisiklikIcerik />
</BaseLayout>
