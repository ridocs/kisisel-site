---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HakkimdaIcerik from '../../components/HakkimdaIcerik.astro';
import { cevirici, dilBul } from '@/i18n/ceviriler';

/*
  Türkçe /hakkimda sayfasının eşi. Gövde aynı bileşenden geliyor; iletişim
  çapası bileşen içinde dile göre `contact` oluyor — Navbar'daki İletişim
  düğmesi İngilizce'de oraya bakıyor.
*/

const dil = dilBul(Astro.url);
const m = cevirici(dil);
---

<BaseLayout title={m('hakkimda.sayfaBasligi')} description={m('hakkimda.aciklama')}>
	<HakkimdaIcerik />
</BaseLayout>
