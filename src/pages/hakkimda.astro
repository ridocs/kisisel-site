---
import BaseLayout from '../layouts/BaseLayout.astro';
import HakkimdaIcerik from '../components/HakkimdaIcerik.astro';
import { cevirici, dilBul } from '@/i18n/ceviriler';

/*
  Sayfanın gövdesi HakkimdaIcerik bileşeninde; İngilizce eşi (/en/about) da
  aynı bileşeni kullanıyor. İletişim çapası (#iletisim / #contact) orada dile
  göre seçiliyor.

  Tanıtım metinleri ve iletişim bilgileri YER TUTUCU — kullanıcı dolduracak.
  Metinler `src/i18n/ceviriler.ts`, adres ve numara `src/lib/iletisim.ts`.
*/

const dil = dilBul(Astro.url);
const m = cevirici(dil);
---

<BaseLayout title={m('hakkimda.sayfaBasligi')} description={m('hakkimda.aciklama')}>
	<HakkimdaIcerik />
</BaseLayout>
