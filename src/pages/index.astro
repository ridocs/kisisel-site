---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBolumu from '../components/HeroBolumu';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout title="Mustafa Eybek — Kişisel Site">
	{/*
	  Sayfadaki tek React adacığı. İmleç etkileşimi ilk ekranda olduğu için
	  client:load ile yükleniyor; sitenin diğer sayfaları JavaScript almıyor.
	*/}
	<HeroBolumu client:load slot="tam-genislik" />

	<section class="py-14">
		<h2 class="text-xl font-semibold text-slate-900 dark:text-white">Son yazılar</h2>
		<ul class="mt-6 space-y-6">
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`} class="group block">
							<h3 class="font-medium text-slate-900 group-hover:text-marka-600 dark:text-white dark:group-hover:text-marka-400">
								{post.data.title}
							</h3>
							<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{post.data.description}</p>
							<time datetime={post.data.pubDate.toISOString()} class="mt-1 block text-xs text-slate-500">
								{post.data.pubDate.toLocaleDateString('tr-TR', { dateStyle: 'long' })}
							</time>
						</a>
					</li>
				))
			}
		</ul>
		<a
			href="/blog"
			class="mt-8 inline-block text-sm font-medium text-marka-600 hover:underline dark:text-marka-400"
		>
			Tüm yazılar →
		</a>
	</section>
</BaseLayout>
