---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout title="Mustafa — Kişisel Site">
	<section class="space-y-4">
		<h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white">Merhaba, ben Mustafa</h1>
		<p class="text-lg text-slate-600 dark:text-slate-400">
			Buraya kendini tanıtan birkaç cümle yaz. Ne yaptığın, neyle ilgilendiğin, nasıl ulaşılacağı.
		</p>
	</section>

	<section class="mt-14">
		<h2 class="text-xl font-semibold text-slate-900 dark:text-white">Son yazılar</h2>
		<ul class="mt-5 space-y-5">
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`} class="group block">
							<h3 class="font-medium group-hover:text-marka-600 dark:group-hover:text-marka-400">
								{post.data.title}
							</h3>
							<p class="text-sm text-slate-600 dark:text-slate-400">{post.data.description}</p>
							<time datetime={post.data.pubDate.toISOString()} class="text-xs text-slate-500">
								{post.data.pubDate.toLocaleDateString('tr-TR', { dateStyle: 'long' })}
							</time>
						</a>
					</li>
				))
			}
		</ul>
		<a href="/blog" class="mt-6 inline-block text-sm text-marka-600 hover:underline dark:text-marka-400">
			Tüm yazılar →
		</a>
	</section>
</BaseLayout>
