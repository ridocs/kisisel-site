---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Blog — Mustafa" description="Yazılar.">
	<h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Blog</h1>

	<ul class="mt-8 space-y-8">
		{
			posts.map((post) => (
				<li class="border-b border-slate-200 pb-8 last:border-0 dark:border-slate-800">
					<a href={`/blog/${post.id}/`} class="group block space-y-1">
						<h2 class="text-lg font-medium group-hover:text-marka-600 dark:group-hover:text-marka-400">
							{post.data.title}
						</h2>
						<p class="text-slate-600 dark:text-slate-400">{post.data.description}</p>
						<div class="flex items-center gap-3 text-xs text-slate-500">
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('tr-TR', { dateStyle: 'long' })}
							</time>
							{post.data.tags.map((tag) => (
								<span class="rounded bg-slate-100 px-2 py-0.5 dark:bg-slate-800">#{tag}</span>
							))}
						</div>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
