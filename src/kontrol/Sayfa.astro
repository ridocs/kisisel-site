---
import { denetle, type Bulgu, type Onem } from './denetimler';
import Kabuk from '../panel/Kabuk.astro';

/*
  YAYIN ÖNCESİ KONTROL

  Bu sayfa `src/pages/` altında DEĞİL; oraya konsaydı `astro build` onu üretir
  ve sitenin bütün eksiklerini sıralayan bir sayfa internete açılırdı. Rotayı
  `astro.config.cms.mjs` içindeki eklenti bağlıyor, o yapılandırmayı da
  yalnızca `npm run yazi` okuyor. Yayın derlemesi bu dosyayı hiç görmüyor.

  Denetim her istekte yeniden çalışıyor: dev sunucusu bileşeni her açılışta
  çalıştırdığı için ayrıca bir tazeleme düzeneğine gerek yok — bir dosyayı
  düzeltip sayfayı yenilemek yeniden denetlemeye yetiyor.

  Belgenin kabuğu (üst şerit, tipografi, renk değişkenleri) `src/panel/`
  altında; üç panel ekranı da aynı kabuktan geçiyor.
*/
const rapor = await denetle();

/*
  Kovaların EKRANDAKİ SIRASI sabit ve önemli: önce yayını bozanlar.

  Sıra bulgu sayısına göre değişseydi (ör. "en kalabalık grup üstte") kullanıcı
  her açılışta listeyi baştan okumak zorunda kalırdı. Sabit sıra, ikinci
  açılışta doğrudan doğru yere bakmayı sağlıyor.
*/
const kovalar: { onem: Onem; baslik: string; aciklama: string }[] = [
	{
		onem: 'engel',
		baslik: 'Önce bunlar',
		aciklama: 'Ziyaretçinin gördüğü sayfayı bozuyor. Yayından önce düzeltilmeli.',
	},
	{
		onem: 'iyilestirme',
		baslik: 'İyileştirmeler',
		aciklama: 'Sayfa çalışıyor ama daha iyi olabilir. Acelesi yok.',
	},
	{
		onem: 'gozdenGecir',
		baslik: 'Gözden geçir',
		aciklama:
			'Araç bunlara karar veremedi; bilerek yapılmış da olabilir. Kararı siz verin.',
	},
];

/** Bir kovadaki bulguları denetim adına göre gruplar. */
function denetimeGore(bulgular: Bulgu[]): { ad: string; liste: Bulgu[] }[] {
	const gruplar = new Map<string, Bulgu[]>();
	for (const bulgu of bulgular) {
		const liste = gruplar.get(bulgu.denetim) ?? [];
		liste.push(bulgu);
		gruplar.set(bulgu.denetim, liste);
	}
	return [...gruplar.entries()]
		.map(([ad, liste]) => ({ ad, liste }))
		.sort((a, b) => b.liste.length - a.liste.length || a.ad.localeCompare(b.ad, 'tr'));
}

const sayilar = {
	engel: rapor.bulgular.filter((b) => b.onem === 'engel').length,
	iyilestirme: rapor.bulgular.filter((b) => b.onem === 'iyilestirme').length,
	gozdenGecir: rapor.bulgular.filter((b) => b.onem === 'gozdenGecir').length,
};

/*
  Önem düzeyinin GÖRSEL KARŞILIĞI tek yerde.

  Renk tek başına taşıyıcı değil: her düzeyin bir simge harfi (✕ ! ?) ve bir
  sözcüğü var. Renk körü bir kullanıcı da, ekranı gri basan bir çıktı da aynı
  bilgiyi okuyor. Renk üçüncü işaret, birinci değil.

  Koyu temada kova zeminleri nötr gri kalıyor; renk yalnızca ince kenarlıkta,
  rozette ve simgede duruyor — yoksa üç kova yan yana bir alarm panosuna
  dönüşüyordu.
*/
const GORUNUS: Record<Onem, { im: string; sozcuk: string; rozet: string; kenar: string }> =
	{
		engel: {
			im: '✕',
			sozcuk: 'Engel',
			rozet: 'p-rozet--agir',
			kenar: 'p-olcu--agir',
		},
		iyilestirme: {
			im: '!',
			sozcuk: 'İyileştirme',
			rozet: 'p-rozet--dikkat',
			kenar: 'p-olcu--dikkat',
		},
		gozdenGecir: {
			im: '?',
			sozcuk: 'Karar sizin',
			rozet: 'p-rozet--notr',
			kenar: 'p-olcu--notr',
		},
	};

const cekimAni = new Date().toLocaleString('tr-TR', {
	dateStyle: 'long',
	timeStyle: 'short',
});
---

<Kabuk
	baslik="Yayın öncesi kontrol"
	aktif="kontrol"
	not={`${rapor.yaziSayisi} yazı · ${rapor.sayfaSayisi} sayfa denetlendi · ${cekimAni}`}
>
	<div class="p-yigin">
		{/* ÖZET — üç kova, üç rakam; hangisinin acil olduğu simgeden de okunuyor */}
		<section class="p-izgara p-izgara--3">
			{
				kovalar.map((kova) => (
					<div class={`p-kart p-kart--sikisik ${GORUNUS[kova.onem].kenar}`}>
						<div class="p-kart-basi">
							<span class="p-olcu-sayi">{sayilar[kova.onem]}</span>
							<span class={`p-rozet ${GORUNUS[kova.onem].rozet}`}>
								<span class="p-im" aria-hidden="true">
									{GORUNUS[kova.onem].im}
								</span>
								{GORUNUS[kova.onem].sozcuk}
							</span>
						</div>
						<div class="p-olcu-ad">{kova.baslik}</div>
					</div>
				))
			}
		</section>

		{
			rapor.bulgular.length === 0 && (
				<section class="p-uyari p-uyari--iyi">
					<h2 class="p-uyari-baslik">
						<span class="p-im p-metin-iyi" aria-hidden="true">
							✓
						</span>
						Denetimler temiz
					</h2>
					<p class="p-not">
						{rapor.yaziSayisi} yazı ve {rapor.sayfaSayisi} sayfa tek tek bakıldı; bu
						araç hiçbir kusur bulamadı. Bakılan şeyler: gövdedeki ikinci başlık, dil
						değiştirme adresleri, başlık ve açıklama uzunlukları, taslak kalmış
						yazılar, görsellerin metin karşılıkları, iç bağlantılar, yinelenen başlık
						ve açıklamalar, tarihler, etiketler.
					</p>
					<p class="p-not p-not--kisik">
						Aşağıdaki "Bu araç neye bakmıyor" listesi de aynı ölçüde önemli: temiz bir
						rapor "her şey iyi" demek değil, "ölçülebilen her şey yerinde" demek.
					</p>
				</section>
			)
		}

		{/* BULGULAR */}
		{
			kovalar.map((kova) => {
				const bulgular = rapor.bulgular.filter((b) => b.onem === kova.onem);
				if (bulgular.length === 0) return null;
				const gruplar = denetimeGore(bulgular);
				/*
				  Kart üzerindeki sayı rozeti yalnızca birden fazla denetim grubu
				  varken anlamlı. Tek grupta bölüm başlığındaki rozetle aynı sayıyı
				  gösteriyor ve okuyucu iki ayrı şey sanıp arıyor.
				*/
				const kartRozetiGerekli = gruplar.length > 1;
				return (
					<section class="p-yigin">
						<div>
							<h2 class="p-kart-basi">
								<span class="p-kart-baslik">{kova.baslik}</span>
								<span class={`p-rozet ${GORUNUS[kova.onem].rozet}`}>
									<span class="p-im" aria-hidden="true">
										{GORUNUS[kova.onem].im}
									</span>
									{bulgular.length}
								</span>
							</h2>
							<p class="p-not">{kova.aciklama}</p>
						</div>

						{gruplar.map((grup) => (
							<article class={`p-kart ${GORUNUS[kova.onem].kenar}`}>
								<div class="p-kart-basi">
									<h3 class="p-kart-baslik">{grup.ad}</h3>
									{kartRozetiGerekli && (
										<span class={`p-rozet ${GORUNUS[kova.onem].rozet}`}>
											{grup.liste.length}
										</span>
									)}
								</div>

								{/*
								  "Neden" ve "nasıl" grubun BAŞINDA bir kez yazılıyor, her
								  satırda değil: aynı denetimin bulgularında ikisi de aynı ve
								  her satırda tekrar edilseydi liste okunmaz olurdu.
								  Satırlarda yalnızca dosyaya özgü olan duruyor.
								*/}
								<p class="p-not">{grup.liste[0].neden}</p>
								<p class="p-not" style="color: var(--p-metin)">
									<strong>Ne yapmalı:</strong> {grup.liste[0].cozum}
								</p>

								<ul class="p-liste p-ayrac">
									{grup.liste.map((bulgu) => (
										<li>
											<div class="p-kv">
												<span class="p-kv-ad p-kv-ad--kod">{bulgu.dosya}</span>
												{bulgu.satir && (
													<span class="p-kv-deger">{bulgu.satir}. satır</span>
												)}
											</div>
											<div style="margin-top: 2px">{bulgu.sorun}</div>
										</li>
									))}
								</ul>
							</article>
						))}
					</section>
				);
			})
		}

		{/* KAPSAM — "bulgu yok" ile "bakmadım" karışmasın */}
		<section class="p-kart">
			<h2 class="p-kart-baslik">Bu araç neye bakmıyor</h2>
			<ul class="p-liste p-kart-govde">
				{
					rapor.kapsamDisi.map((satir) => (
						<li class="p-kv">
							<span class="p-kv-ad" style="white-space: normal; color: var(--p-metin-2)">
								· {satir}
							</span>
						</li>
					))
				}
			</ul>
		</section>

		<p class="p-dipnot">
			Rapor her sayfa yenilemesinde dosyaların o anki hâlinden yeniden üretiliyor;
			bir dosyayı düzeltip buraya dönmek yeniden denetlemeye yetiyor. Bu sayfa
			yalnızca panel kipinde var; yayın derlemesine girmiyor.
		</p>
	</div>
</Kabuk>
