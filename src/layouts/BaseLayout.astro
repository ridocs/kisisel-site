---
import Navbar from '../components/Navbar.astro';
import SarmasikYazi from '../components/SarmasikYazi.astro';
import KaydirmaSeridi from '../components/KaydirmaSeridi.astro';
import Altbilgi from '../components/Altbilgi.astro';
import SosyalRay from '../components/SosyalRay.astro';
import { cevirici, digerDilYolu, dilBul, taban } from '@/i18n/ceviriler';
import { EPOSTA, GITHUB, TELEFON_GORUNEN, SOSYAL_ADRESLER } from '@/lib/iletisim';
import '../styles/global.css';
// ?url ile içe aktarıldığında Vite hash'li son adresi veriyor; önyükleme
// bağlantısı ile CSS'in istediği dosya birebir aynı olsun diye böyle.
import yaziTipiTemel from '../styles/yazitipi/inter-temel.woff2?url';
import yaziTipiEk from '../styles/yazitipi/inter-ek.woff2?url';

interface Props {
	title: string;
	description?: string;
	/**
	 * Altbilgi gösterilsin mi. Hata sayfası gibi tam ekran, tek ekranlık
	 * sayfalarda kapatılıyor: altbilgi orada yalnızca gereksiz bir kaydırma
	 * çubuğu üretiyor.
	 */
	altbilgi?: boolean;
	/**
	 * Yazı sayfalarında verilir. Verildiğinde og:type "article" olur, makale
	 * meta etiketleri basılır ve sayfaya BlogPosting yapılandırılmış verisi
	 * eklenir. Diğer sayfalarda boş kalır, onların çıktısı değişmez.
	 */
	/*
	  Dil bağları (`hreflang`) için öteki dilin adresi.

	  Durağan sayfalarda adres çevrilerek bulunabiliyor (`/hakkimda` ↔
	  `/en/about`), ama YAZILARDA bulunamıyor: çeviri adları farklı
	  (`merhaba-dunya` ↔ `hello-world`) ve bazı yazının çevirisi hiç yok.
	  Önce adres tahmin ediliyordu ve var olmayan sayfalar gösteriliyordu;
	  arama motoru iki dili birbirinin kopyası sayabiliyor. SEO paneli yedi
	  sayfada bunu ölçtü.

	  `null` verilirse dil bağı HİÇ BASILMIYOR. Yanlış bir adres göstermektense
	  hiç göstermemek doğru: arama motoru eksik bilgiyi yok sayar, yanlış
	  bilgiyi kullanır.

	  Verilmezse eski davranış sürüyor — durağan sayfalar için doğru olan o.
	*/
	dilBagi?: string | null;
	makale?: {
		/** Yazının kendi başlığı — sayfa <title>'ı site adını da içerdiği için ayrı. */
		baslik: string;
		yayin: Date;
		guncelleme?: Date;
	};
	/** Arama motoru dizinine girmemesi gereken sayfalar (404) için. */
	dizinDisi?: boolean;
}

const dil = dilBul(Astro.url);
const m = cevirici(dil);
const {
	title,
	description = m('site.aciklama'),
	altbilgi = true,
	dilBagi,
	makale,
	dizinDisi = false,
} = Astro.props;

// Varsayılan yuvada içerik yoksa <main> hiç çizilmiyor; boş bir main yalnızca
// dolgusu kadar yer kaplayıp sayfayı görünüm alanından uzatıyordu.
const icerikVar = Astro.slots.has('default');
const canonical = new URL(Astro.url.pathname, Astro.site);

// Arama motorlarına aynı sayfanın diğer dildeki karşılığını bildiriyoruz.
/*
  Dil bağları üç durumda farklı kuruluyor:

  - `dilBagi` verilmemişse (durağan sayfalar): adres çevrilerek bulunuyor.
  - `dilBagi` bir adresse (çevirisi olan yazı): o adres kullanılıyor.
  - `dilBagi` null ise (çevirisi olmayan yazı): bağ hiç basılmıyor.
*/
const dilBagiVerildi = dilBagi !== undefined;
const oteki = dilBagi ? new URL(dilBagi, Astro.site) : null;

const trYolu = dilBagiVerildi
	? dil === 'tr'
		? canonical
		: oteki
	: new URL(digerDilYolu(Astro.url, 'tr'), Astro.site);

const enYolu = dilBagiVerildi
	? dil === 'en'
		? canonical
		: oteki
	: new URL(digerDilYolu(Astro.url, 'en'), Astro.site);

const SITE_ADI = 'Mustafa Eybek';

/*
  Paylaşım kartı görseli. Tek ve sabit bir görsel kullanılıyor: sayfa başına
  görsel üretmek ek paket ve derleme adımı demek, kazancı ise bu boyuttaki bir
  sitede yok. 1200×630, mevcut portreden kırpıldı (public/og.jpg).

  Mutlak adres zorunlu: paylaşım kazıyıcıları göreli yolu çözmüyor. Alt dizinde
  yayınlandığı için `taban` öneki elle ekleniyor — `Astro.site` yalnızca alan adı.
*/
const ogGorsel = new URL(`${taban}/og.jpg`, Astro.site);
const ogYerel = dil === 'tr' ? 'tr_TR' : 'en_US';
const ogDigerYerel = dil === 'tr' ? 'en_US' : 'tr_TR';

// Yapılandırılmış verideki kimlikler dilden bağımsız tek bir kişiye ve tek bir
// siteye işaret etsin diye hep Türkçe köke bağlanıyor.
const kok = new URL(`${taban}/`, Astro.site).href;
const dilEtiketi = dil === 'tr' ? 'tr-TR' : 'en-US';

const kisi = {
	'@type': 'Person',
	'@id': `${kok}#kisi`,
	name: SITE_ADI,
	url: kok,
	image: new URL(`${taban}/mustafa-eybek.jpg`, Astro.site).href,
	jobTitle: m('iletisim.rol'),
	email: `mailto:${EPOSTA}`,
	telephone: TELEFON_GORUNEN,
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Kayseri',
		addressCountry: 'TR',
	},
	/*
	  Kimlik bağı: arama motoru bu sayfayı ve bu hesapları aynı kişiye
	  bağlıyor. `src/lib/iletisim.ts` içinde boş bırakılan profil buraya hiç
	  girmiyor — doğrulanamayan bir adres bildirmek, hiç bildirmemekten kötü.
	*/
	sameAs: SOSYAL_ADRESLER,
};

const siteVerisi = {
	'@type': 'WebSite',
	'@id': `${kok}#site`,
	url: kok,
	name: SITE_ADI,
	description: m('site.aciklama'),
	inLanguage: dilEtiketi,
	publisher: { '@id': `${kok}#kisi` },
};

const yaziVerisi = makale && {
	'@type': 'BlogPosting',
	'@id': `${canonical.href}#yazi`,
	headline: makale.baslik,
	description,
	datePublished: makale.yayin.toISOString(),
	dateModified: (makale.guncelleme ?? makale.yayin).toISOString(),
	author: { '@id': `${kok}#kisi` },
	publisher: { '@id': `${kok}#kisi` },
	image: ogGorsel.href,
	inLanguage: dilEtiketi,
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
};

/*
  JSON-LD veri bloğu; çalıştırılabilir betik değil, tarayıcı içeriğini
  yürütmüyor. "<" kaçırılıyor: veride bir "</script>" geçerse blok erkenden
  kapanır ve sayfanın kalanı bozulurdu.
*/
const yapilandirilmisVeri = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [kisi, siteVerisi, ...(yaziVerisi ? [yaziVerisi] : [])],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html
	lang={dil}
	class="scroll-smooth bg-white dark:bg-neutral-950"
	data-taban={taban}
>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${taban}/favicon.svg`} />
		{/*
		  Yazı tipini önden istiyoruz. Aksi hâlde sıra şöyle işliyordu:
		  HTML in → CSS in → CSS ayrıştır → yazı tipini iste. Üç ardışık
		  gidiş-dönüş; metin o süre boyunca yedek yazı tipiyle görünüp sonra
		  yerine oturuyordu. Yazı tipleri için crossorigin zorunlu.
		  Türkçe'ye özgü harfleri taşıyan ikinci dosya yalnızca Türkçe sayfalarda.
		*/}
		<link rel="preload" href={yaziTipiTemel} as="font" type="font/woff2" crossorigin />
		{dil === 'tr' && (
			<link rel="preload" href={yaziTipiEk} as="font" type="font/woff2" crossorigin />
		)}
		<link rel="canonical" href={canonical} />
		{trYolu && enYolu && (
			<>
				<link rel="alternate" hreflang="tr" href={trYolu} />
				<link rel="alternate" hreflang="en" href={enYolu} />
				<link rel="alternate" hreflang="x-default" href={trYolu} />
			</>
		)}
		<link
			rel="alternate"
			type="application/rss+xml"
			title={title}
			href={dil === 'en' ? `${taban}/en/rss.xml` : `${taban}/rss.xml`}
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{dizinDisi && <meta name="robots" content="noindex, follow" />}

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={makale ? 'article' : 'website'} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={SITE_ADI} />
		<meta property="og:locale" content={ogYerel} />
		<meta property="og:locale:alternate" content={ogDigerYerel} />
		<meta property="og:image" content={ogGorsel} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={m('tanitim.gorselAlt')} />

		{
			makale && (
				<>
					<meta property="article:author" content={SITE_ADI} />
					<meta
						property="article:published_time"
						content={makale.yayin.toISOString()}
					/>
					{makale.guncelleme && (
						<meta
							property="article:modified_time"
							content={makale.guncelleme.toISOString()}
						/>
					)}
				</>
			)
		}

		{/*
		  Bu `twitter:*` etiketleri ADI YANILTICI: X'e özel değiller. WhatsApp,
		  Slack, Discord ve LinkedIn bağlantı önizlemesini kurarken aynı
		  etiketlere bakıyor. X hesabı olmadığı için `twitter:creator`
		  yazılmıyor ama kartın kendisi duruyor — silinseydi önizleme her yerde
		  bozulurdu.
		*/}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogGorsel} />
		<meta name="twitter:image:alt" content={m('tanitim.gorselAlt')} />

		<script type="application/ld+json" set:html={yapilandirilmisVeri} is:inline />

		{/* Sayfa boyanmadan önce temayı uygular; böylece koyu temada beyaz ekran parlaması olmaz. */}
		<script is:inline>
			try {
				const kayitliTema = localStorage.getItem('tema');
				const koyu = kayitliTema
					? kayitliTema === 'koyu'
					: window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (koyu) document.documentElement.classList.add('dark');
			} catch {
				// Gizli sekmede localStorage engellenebilir; bu durumda varsayılan tema kullanılır.
			}
		</script>

		{/* Belirme efektinin başlangıç gizliliği yalnızca JavaScript çalışırken
		    uygulansın diye işaret. Stil hesaplanmadan önce ekleniyor. */}
		<script is:inline>
			document.documentElement.classList.add('js-var');
		</script>

		{/*
		  Cihaz diline göre yönlendirme. Site statik olduğu için sunucu tarafında
		  yapılamıyor; ilk ziyarette tarayıcı dili Türkçe değilse İngilizce sürüme
		  bir kez geçiliyor. Yalnızca ana sayfada çalışır — derin bağlantılarda
		  yönlendirme yapmak kullanıcıyı istediği sayfadan koparırdı. Kullanıcı dil
		  değiştiriciyi kullandığında tercihi saklanır ve bir daha araya girilmez.
		*/}
		<script is:inline>
			(function () {
				try {
					if (/bot|crawler|spider|lighthouse|pagespeed/i.test(navigator.userAgent)) return;
					if (localStorage.getItem('dil-secildi')) return;
					// Site bir alt dizinde yayınlanabiliyor; önek <html data-taban>
					// üzerinden okunuyor. Satır içi betikler derleyiciden geçmediği
					// için import.meta.env burada kullanılamaz.
					var taban = document.documentElement.getAttribute('data-taban') || '';
					if (window.location.pathname.replace(/\/+$/, '') !== taban) return;
					var tarayiciDili = (navigator.language || 'tr').toLowerCase();
					if (tarayiciDili.indexOf('tr') === 0) return;
					localStorage.setItem('dil-secildi', 'otomatik');
					window.location.replace(taban + '/en/');
				} catch (hata) {
					// localStorage engelliyse yönlendirme yapılmaz; Türkçe sürüm açılır.
				}
			})();
		</script>
	</head>
	{/* Zemin <html> üzerinde: sarmaşık katmanı `z-index: -1` ile içeriğin
	    arkasında duruyor ve zemin body'de kalsaydı onun da arkasına düşüp
	    görünmez olurdu. `relative` ise katmanın yaslandığı kutu. */}
	<body class="relative flex min-h-svh flex-col text-slate-800 antialiased dark:text-neutral-200">
		<SarmasikYazi metin={m('sarmasik.metin')} />
		<KaydirmaSeridi />
		<SosyalRay />

		<a
			href="#icerik"
			class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:rounded-lg focus:bg-marka-600 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
		>
			{m('nav.icerigeGec')}
		</a>

		<Navbar dilBagi={dilBagi === undefined ? undefined : (oteki ? oteki.pathname : null)} />

		{/* Kenardan kenara uzanması gereken bölümler (ör. hero) için: metin sütunu
		    genişliğiyle sınırlanmadan, main'in dışında render edilir. */}
		<slot name="tam-genislik" />

		{
			icerikVar && (
				<main
					id="icerik"
					{/*
					  Okuma sütunu her sayfada ortalanıyor.

					  Blog ve yazı sayfaları bir süre sola yaslıydı; geniş ekranda
					  sağda büyük bir boşluk bırakıp üst çubuk ve altbilgiyle
					  hizasız duruyordu — ikisi ortalı olduğu için sayfa kaymış
					  gibi okunuyordu. Metnin kendi hizası zaten sola dayalı,
					  değişen yalnızca sütunun sayfadaki yeri.
					*/}
					class="mx-auto max-w-3xl px-4 py-12"
				>
					<slot />
				</main>
			)
		}

		{
			altbilgi && <Altbilgi dilBagi={dilBagi === undefined ? undefined : (oteki ? oteki.pathname : null)} />
		}

		{/* Bölümler görünür alana girdikçe belirir. Bir kez göründükten sonra
		    izleme bırakılıyor; aşağı-yukarı kaydırmada tekrar tekrar oynamıyor. */}
		<script is:inline>
			(function () {
				var ogeler = document.querySelectorAll('[data-belir]');
				if (!ogeler.length) return;

				// IntersectionObserver yoksa (çok eski tarayıcı) hepsini görünür yap.
				if (!('IntersectionObserver' in window)) {
					ogeler.forEach(function (oge) {
						oge.setAttribute('data-gorunur', '');
					});
					return;
				}

				function goster(oge) {
					oge.setAttribute('data-gorunur', '');
				}

				// Eşik düşük tutuluyor: bölüm ekranın kenarından görünmeye
				// başladığında animasyon başlasın ki kaydırma yerine oturduğunda
				// içerik tam gelmiş olsun. Bölümler görünüm yüksekliğinden uzun
				// olabildiği için yüksek bir yüzde eşiği geç tetikleniyordu.
				var gozlemci = new IntersectionObserver(
					function (girisler) {
						girisler.forEach(function (giris) {
							if (!giris.isIntersecting) return;
							goster(giris.target);
							gozlemci.unobserve(giris.target);
						});
					},
					{ threshold: 0.08 },
				);

				ogeler.forEach(function (oge) {
					gozlemci.observe(oge);
				});

				// Güvenlik ağına gerek yok: içerik varsayılan olarak görünür,
				// `data-gorunur` yalnızca giriş animasyonunu oynatıyor. Gözlemci
				// hiç tetiklenmezse en kötü ihtimalle animasyon olmuyor.
			})();
		</script>

		{/*
		  Sayfa sayfa ilerleme: tekerlek ne kadar döndürülürse döndürülsün bir
		  hamlede bir bölüm ileri gidiliyor.

		  Sınırlar bilinçli:
		  - Fare tekerleği 768 piksel ve üzerinde; dokunmatik için ayrı bir
		    işleyici var (aşağıda), çünkü parmak hareketinde karar hareketin
		    başında bir kez verilmek zorunda.
		  - Bir bölüm ekrandan uzunsa, sonuna gelinene kadar normal kaydırma
		    çalışıyor; yoksa görülemeyen içerik kalırdı.
		  - Hareketi azaltılmış tercihte tamamen kapalı (kaydırmayı ele geçirmek
		    baş dönmesi yapabiliyor).
		  - Klavye ve ekran okuyucu akışına dokunulmuyor.
		*/}
		<script is:inline>
			(function () {
				var bolumler = [].slice.call(document.querySelectorAll('[data-sayfa]'));
				if (bolumler.length < 2) return;

				var genisMi = window.matchMedia('(min-width: 768px)');
				var azHareket = window.matchMedia('(prefers-reduced-motion: reduce)');

				// Bölümler arası geçiş süresi. Tarayıcının `behavior: 'smooth'`
				// süresi ayarlanamıyor ve mesafeye göre değişiyordu; geçiş burada
				// elle canlandırılıyor ki süre ve yumuşama denetlenebilsin.
				var GECIS_SURESI = 950;

				// Sıçrama sürerken gelen tekerlek olayları yok sayılıyor.
				var kilitBitis = 0;
				var sicramaAni = 0;

				// Başta hızlanıp sonda yavaşlayan eğri; sabit hızlı bir kaydırma
				// mekanik duruyor.
				function yumusat(o) {
					return o < 0.5 ? 4 * o * o * o : 1 - Math.pow(-2 * o + 2, 3) / 2;
				}

				function yumusakGit(hedef) {
					var baslangic = window.scrollY;
					var mesafe = hedef - baslangic;
					var ilkZaman = null;

					function adim(zaman) {
						if (ilkZaman === null) ilkZaman = zaman;
						var oran = Math.min((zaman - ilkZaman) / GECIS_SURESI, 1);
						// `behavior: 'instant'` şart: CSS'teki `scroll-behavior: smooth`
						// yüzünden her scrollTo çağrısı kendi başına da yumuşatılıyor
						// ve iki canlandırma birbiriyle çakışıyordu.
						window.scrollTo({
							top: Math.round(baslangic + mesafe * yumusat(oran)),
							behavior: 'instant',
						});
						if (oran < 1) window.requestAnimationFrame(adim);
					}

					window.requestAnimationFrame(adim);
				}

				function etkinMi() {
					return genisMi.matches && !azHareket.matches;
				}

				function enFazlaKaydirma() {
					return Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
				}

				// Bölümün belge içindeki üst konumu.
				//
				// getBoundingClientRect bilinçli olarak kullanılmıyor: belirme
				// efekti bölümleri `translateY(28px)` ile kaydırıyor ve ölçüm bu
				// dönüşümü içeriyor, yani daha belirmemiş bir bölüme 28 piksel
				// şaşarak gidilirdi. offsetTop düzen konumunu verir, dönüşümden
				// etkilenmez.
				//
				// scrollIntoView da kullanılmıyor: `scroll-padding-top` hedefi
				// 80 piksel aşağı kaydırıyor, bölüm ekrana sığmıyor sanılıyor ve
				// sonraki hamle olağan kaydırmaya düşüyordu.
				function belgeUstu(oge) {
					var y = 0;
					for (var n = oge; n; n = n.offsetParent) y += n.offsetTop;
					return y;
				}

				function konum(i) {
					return Math.round(Math.min(Math.max(belgeUstu(bolumler[i]), 0), enFazlaKaydirma()));
				}

				/*
				  Kaydırma çizgisinin İÇİNDE bulunduğu bölüm.

				  Önce "en yakın üst kenar" seçiliyordu. Ekrandan uzun bir bölümde
				  (mobilde Yetkinlikler 1043 piksel, görünüm 844) serbest kaydırmaya
				  izin verildiği anda hiza bozuluyor; o noktada hâlâ o bölümün
				  içindeyken bir SONRAKİ bölümün üst kenarı daha yakın kalıyordu.
				  Betik bir sonrakini "şu anki bölüm" sanıp onun taşıp taşmadığına
				  bakıyor, taşıyor bulunca ele geçirmeyi kapatıyordu — ve bir daha
				  açılmadığı için sayfa sayfa geçiş mobilde Tanıtım'dan sonra
				  tamamen kayboluyordu.
				*/
				function aktifIndeks() {
					for (var i = bolumler.length - 1; i >= 0; i--) {
						if (window.scrollY >= belgeUstu(bolumler[i]) - 2) return i;
					}
					return 0;
				}

				window.addEventListener(
					'wheel',
					function (olay) {
						if (!etkinMi() || olay.ctrlKey || !olay.deltaY) return;

						var simdi = performance.now();

						// Dokunmatik yüzeyin ataleti tek hareket için onlarca olay
						// üretiyor; hepsi yutulmazsa bir hamlede birkaç bölüm birden
						// atlanırdı. Kilit her olayda biraz uzuyor ama toplamı sınırlı:
						// kullanıcı gerçekten kaydırmayı sürdürüyorsa tıkanıp kalmıyor.
						if (simdi < kilitBitis) {
							kilitBitis = Math.min(simdi + 320, sicramaAni + 1500);
							olay.preventDefault();
							return;
						}

						var i = aktifIndeks();
						var ust = belgeUstu(bolumler[i]) - window.scrollY;
						var alt = ust + bolumler[i].offsetHeight;
						var yon = olay.deltaY > 0 ? 1 : -1;

						// Bölüm ekrana sığmıyorsa, kenarına gelene kadar olağan kaydırma.
						if (yon > 0 && alt > EKRAN_BOYU + 4) return;
						if (yon < 0 && ust < -4) return;

						var hedef = i + yon;
						if (hedef < 0 || hedef > bolumler.length - 1) return;

						var y = konum(hedef);
						// Gidilecek yer kalmadıysa (ör. son bölümün altındaki altbilgi)
						// olayı ele geçirmiyoruz; sayfa normal biçimde kaydırılabilsin.
						if (Math.abs(y - window.scrollY) < 2) return;

						olay.preventDefault();
						sicramaAni = simdi;
						kilitBitis = simdi + GECIS_SURESI + 150;
						yumusakGit(y);
					},
					{ passive: false },
				);


				/*
				  EN BÜYÜK GÖRÜNÜM YÜKSEKLİĞİ (lvh)

				  iOS Safari sayfayı alt araç çubuğunun ARKASINA da çiziyor.
				  `svh` çubuk açıkken kalan yeri, `lvh` çubuk çekilince açılan tam
				  yüksekliği veriyor; ikisi arasındaki ~100 piksellik şerit çubuğun
				  arkasında kalıyor ve bir sonraki bölümün başı oradan görünüyordu.

				  Tam ekran bölümler bu yüzden `lvh` ile ölçülüyor. "Bu bölüm bir
				  ekrana sığıyor mu" testinin de aynı ölçüye bakması gerekiyor:
				  `innerHeight` tarayıcı çubuğu yüzünden küçük kaldığında tam sığan
				  bir bölümü bile "taşıyor" sayıp sayfa sayfa geçişi kapatırdı.

				  Değer bir kez ölçülüyor; çubuk açılıp kapandıkça `lvh` değişmiyor.
				*/
				function enBuyukGorunum() {
					var olcer = document.createElement('div');
					olcer.style.cssText =
						'position:absolute;top:0;left:0;width:0;visibility:hidden;pointer-events:none;height:100lvh';
					document.body.appendChild(olcer);
					var boy = olcer.offsetHeight;
					olcer.remove();
					// `lvh` desteklenmiyorsa tarayıcı yüksekliği çözemez ve 0 döner.
					return boy > 0 ? boy : window.innerHeight;
				}

				var EKRAN_BOYU = enBuyukGorunum();

			})();
		</script>

		{/* Dil değiştiriciye tıklandığında tercih saklanır; böylece otomatik
		    yönlendirme bir daha araya girmez. */}
		<script is:inline>
			document.addEventListener('click', function (olay) {
				var hedef =
					olay.target instanceof Element ? olay.target.closest('[data-dil-secimi]') : null;
				if (!hedef) return;
				try {
					localStorage.setItem('dil-secildi', hedef.getAttribute('data-dil-secimi'));
				} catch (hata) {
					// localStorage engelliyse tercih saklanamaz; yönlendirme yine de
					// yalnızca ana sayfada ve bir kez çalışır.
				}
			});
		</script>
	</body>
</html>
