---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Kişisel tanıtım ve blog sitesi.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />

		{/* Sayfa boyanmadan önce temayı uygular; böylece koyu temada beyaz ekran parlaması olmaz. */}
		<script is:inline>
			try {
				const kayitliTema = localStorage.getItem('tema');
				const koyu = kayitliTema
					? kayitliTema === 'koyu'
					: window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (koyu) document.documentElement.classList.add('dark');
			} catch {
				// Gizli sekmede localStorage engellenebilir; bu durumda varsayılan tema kullanılır.
			}
		</script>
	</head>
	<body class="min-h-screen bg-white text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200">
		<a
			href="#icerik"
			class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:rounded-lg focus:bg-marka-600 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
		>
			İçeriğe geç
		</a>

		<Navbar />

		{/* Kenardan kenara uzanması gereken bölümler (ör. hero) için: metin sütunu
		    genişliğiyle sınırlanmadan, main'in dışında render edilir. */}
		<slot name="tam-genislik" />

		<main id="icerik" class="mx-auto max-w-3xl px-4 py-12">
			<slot />
		</main>

		<footer class="mx-auto max-w-3xl px-4 py-10 text-sm text-slate-500 dark:text-slate-400">
			&copy; {new Date().getFullYear()} — MIT lisansı ile yayımlanmıştır.
		</footer>
	</body>
</html>
