---
import { Icon } from 'astro-icon/components';
import { cevirici, dilBul } from '@/i18n/ceviriler';

const dil = dilBul(Astro.url);
const m = cevirici(dil);

/*
  YETKİNLİK İÇERİĞİ — düzenlenecek tek yer burası.

  Her satır:
    ad       : teknolojinin adı (çevrilmiyor, özel ad)
    ikon     : @iconify-json/logos içindeki ad; derleme sırasında gömülüyor
    oran     : 0-100 arası. Ekranda GÖRÜNMÜYOR; yalnızca kartların sırasını
                           belirliyor (büyükten küçüğe).
    sure     : { tr, en }  kartın altındaki not: kaç yıldır kullandığın
    tanim    : { tr, en }  kart seçilince panelde SOLDA çıkan tanım
    ilerleme : { tr, en }  panelde SAĞDA çıkan metin: projeler, nerede
                           kullandığın, nereye geldiğin

  Metinler YER TUTUCU. Sıralama burada değil bileşende yapılıyor — diziye
  istediğin sırayla yazabilirsin.
*/
const yetkinlikler = [
	{
		ad: 'Python',
		ikon: 'logos:python',
		oran: 85,
		sure: { tr: '4 yıl', en: '4 years' },
		tanim: {
			tr: 'Okunabilirliği öne alan, betikten veri işlemeye kadar geniş bir alanda kullanılan genel amaçlı dil.',
			en: 'A general-purpose language built around readability, used from scripting to data work.',
		},
		ilerleme: {
			tr: 'En rahat olduğum dil. Otomasyon betikleri, veri dönüştürme işleri ve küçük servisler yazdım; bu sitenin yazı tipi alt kümeleme aracı da Python ile.',
			en: 'The language I am most at home in. Automation scripts, data transforms and small services — even this site’s font-subsetting tool is Python.',
		},
	},
	{
		ad: 'JavaScript',
		ikon: 'logos:javascript',
		oran: 80,
		sure: { tr: '3 yıl', en: '3 years' },
		tanim: {
			tr: 'Tarayıcının kendi dili; sunucu tarafında da Node.js ile çalışıyor.',
			en: 'The browser’s own language; also runs server-side with Node.js.',
		},
		ilerleme: {
			tr: 'Arayüz tarafında günlük işim. Bu sitedeki kaydırma, menü ve etkileşim betikleri kütüphanesiz, saf JavaScript.',
			en: 'My daily work on the interface side. The scroll, menu and interaction scripts on this site are plain JavaScript, no libraries.',
		},
	},
	{
		ad: 'Dart',
		ikon: 'logos:dart',
		oran: 75,
		sure: { tr: '2 yıl', en: '2 years' },
		tanim: {
			tr: 'Flutter ile tek koddan mobil, masaüstü ve web arayüzü üretmek için tasarlanmış dil.',
			en: 'Designed for Flutter: one codebase for mobile, desktop and web interfaces.',
		},
		ilerleme: {
			tr: 'Mobil tarafta kullandığım dil. Flutter ile arayüz kurup durum yönetimi ve platform kanalları üzerine çalıştım.',
			en: 'My language on the mobile side. Built interfaces with Flutter and worked on state management and platform channels.',
		},
	},
	{
		ad: 'TypeScript',
		ikon: 'logos:typescript-icon',
		oran: 70,
		sure: { tr: '2 yıl', en: '2 years' },
		tanim: {
			tr: 'JavaScript’in tip sistemi eklenmiş hâli; hatayı çalışma anından derleme anına taşıyor.',
			en: 'JavaScript with a type system; moves errors from runtime to build time.',
		},
		ilerleme: {
			tr: 'Büyüyen web projelerinde tercihim. Bu sitenin çeviri katmanı ve bileşen arayüzleri TypeScript ile yazıldı.',
			en: 'My preference on growing web projects. This site’s translation layer and component interfaces are written in TypeScript.',
		},
	},
	{
		ad: 'Docker',
		ikon: 'logos:docker-icon',
		oran: 65,
		sure: { tr: '2 yıl', en: '2 years' },
		tanim: {
			tr: 'Uygulamayı bağımlılıklarıyla paketleyip her ortamda aynı şekilde çalıştıran kapsayıcı aracı.',
			en: 'Packages an app with its dependencies so it runs the same everywhere.',
		},
		ilerleme: {
			tr: 'Geliştirme ortamlarını ve küçük servisleri kapsayıcıya aldım; dağıtımda tekrarlanabilirliği buradan sağlıyorum.',
			en: 'Containerised dev environments and small services; this is how I keep deployments repeatable.',
		},
	},
	{
		ad: 'PostgreSQL',
		ikon: 'logos:postgresql',
		oran: 60,
		sure: { tr: '2 yıl', en: '2 years' },
		tanim: {
			tr: 'İlişkisel veritabanı; güçlü sorgu yetenekleri ve veri bütünlüğü güvenceleriyle biliniyor.',
			en: 'A relational database known for strong query capabilities and data-integrity guarantees.',
		},
		ilerleme: {
			tr: 'Şema tasarımı, indeksleme ve sorgu iyileştirme üzerine çalıştım; projelerde ana veri deposu olarak kullanıyorum.',
			en: 'Worked on schema design, indexing and query tuning; I use it as the primary data store in projects.',
		},
	},
];

/*
  Azalan sıralama: en çok çalışılan teknoloji ızgaranın ilk gözünde, açılışta
  seçili olan da o. Okuma sırası böylece kendiliğinden bir öncelik bildiriyor.
*/
const sirali = [...yetkinlikler].sort((a, b) => b.oran - a.oran);
---

{/*
  Yetkinlikler.

  Düzen: teknolojiler kart ızgarası olarak duruyor, seçilen kartın ayrıntısı
  altındaki panelde açılıyor. Sekme örüntüsü (tablist/tab/tabpanel) ve ok tuşu
  gezinmesi korundu; yalnızca tıklamayla çalışan bir arayüz klavye kullanıcısını
  dışarıda bırakırdı.

  Yüzde çubukları bilinçli olarak kaldırıldı: "%85 Python" doğrulanabilir bir
  şey söylemiyor, okuyan herkes farklı anlıyor. Yerine evrensel olarak okunan
  iki ölçü var — kaç yıldır kullanıldığı (kartta) ve nerede kullanıldığı
  (panelde). `oran` alanı yalnızca sıralamayı belirlemek için duruyor.
*/}
<section
	class="yetkinlik relative overflow-hidden py-10 sm:py-20 md:flex md:min-h-[100svh] md:items-center md:py-12"
	data-belir
	data-parcali
	data-sayfa
>
	<div class="mx-auto w-full max-w-3xl px-4 text-center lg:max-w-4xl">
		<p
			class="text-xs font-semibold tracking-[0.22em] text-muted-foreground"
			data-belir-oge
			style="--sira: 0"
		>
			{m('yetkinlik.ustBaslik')}
		</p>
		<h2
			class="baslik mt-3 font-bold tracking-tight text-foreground"
			data-belir-oge
			style="--sira: 1"
		>
			{m('yetkinlik.baslik')}
		</h2>
		<p
			class="mx-auto mt-3 max-w-xl text-muted-foreground"
			data-belir-oge
			style="--sira: 2"
		>
			{m('yetkinlik.metin')}
		</p>

		<div class="alan" data-yetkinlik-alani>
			<ul class="izgara" role="tablist" aria-label={m('yetkinlik.baslik')}>
				{
					sirali.map((y, sira) => (
						<li>
							<button
								type="button"
								class="kart"
								role="tab"
								id={`yetkinlik-sekme-${sira}`}
								aria-controls={`yetkinlik-panel-${sira}`}
								aria-selected={sira === 0 ? 'true' : 'false'}
								tabindex={sira === 0 ? 0 : -1}
								data-belir-oge
								style={`--sira: ${3 + sira}`}
							>
								<span class="simge" aria-hidden="true">
									<Icon name={y.ikon} class="size-6" />
								</span>
								<span class="ad">{y.ad}</span>
								<span class="sure">{y.sure[dil]}</span>
							</button>
						</li>
					))
				}
			</ul>

			{/* Izgaranın tıklanabilir olduğunu bir kez söylüyoruz; her kartta
			    tekrarlanan bir yönerge listeyi gürültülü yapıyordu. */}
			<p class="ipucu" data-belir-oge style={`--sira: ${3 + sirali.length}`}>
				<Icon name="lucide:pointer" class="size-3.5" aria-hidden="true" />
				<span>{m('yetkinlik.ipucu')}</span>
			</p>

			<div class="paneller">
				{
					sirali.map((y, sira) => (
						<div
							class="panel"
							role="tabpanel"
							id={`yetkinlik-panel-${sira}`}
							aria-labelledby={`yetkinlik-sekme-${sira}`}
							tabindex="0"
							hidden={sira !== 0}
						>
							<div>
								<div class="panel-ust">
									<span class="panel-simge" aria-hidden="true">
										<Icon name={y.ikon} class="size-5" />
									</span>
									<h3 class="panel-ad">{y.ad}</h3>
									<span class="panel-sure">{y.sure[dil]}</span>
								</div>
								<p class="panel-tanim">{y.tanim[dil]}</p>
							</div>

							<div>
								<p class="panel-etiket">{m('yetkinlik.ilerlemeBaslik')}</p>
								<p class="panel-metin">{y.ilerleme[dil]}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	/*
	  Başlık ekranın yüksekliğine göre ölçekleniyor. Yalnızca genişliğe bakan bir
	  ölçek 24 inç 1080p gibi "geniş ama alçak" ekranlarda en büyük değeri seçip
	  bölümü görünür alana sığmaz hâle getiriyordu.

	  clamp içinde rem bileşeni bilinçli: salt viewport birimiyle kurulan bir
	  ölçek kullanıcı yakınlaştırdığında büyümüyor ve WCAG 1.4.4'ü karşılamıyor.
	*/
	.baslik {
		font-size: clamp(1.5rem, 1.1rem + 1.6vh, 2.125rem);
		line-height: 1.2;
	}

	.alan {
		margin-top: 2rem;
	}

	/* --- Kart ızgarası --- */
	.izgara {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
	}

	.kart {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.375rem;
		width: 100%;
		height: 100%;
		padding: 0.875rem 0.625rem;
		border: 1px solid var(--border);
		border-radius: 1rem;
		background: color-mix(in oklab, var(--foreground) 2%, transparent);
		cursor: pointer;
		position: relative;
		transition:
			border-color 220ms ease-out,
			background-color 220ms ease-out,
			translate 260ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.kart:hover {
		border-color: color-mix(in oklab, var(--foreground) 22%, transparent);
		translate: 0 -3px;
	}

	.kart:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}

	/* Seçili kart: kenarlık markayla renkleniyor ve alt kenarda panele işaret
	   eden kısa bir şerit beliriyor. Bilgi yalnızca renge bırakılmıyor —
	   aria-selected ekran okuyucuya durumu ayrıca söylüyor.

	   Zemin bilinçli olarak nötr: marka tonundan bir dolgu koyu temada kartı
	   lacivert bir kutuya çeviriyordu. Renk yalnızca kenarlıkta ve şeritte. */
	.kart[aria-selected='true'] {
		border-color: color-mix(in oklab, var(--color-marka-500) 55%, transparent);
		background: color-mix(in oklab, var(--foreground) 7%, transparent);
	}

	.kart[aria-selected='true']::after {
		content: '';
		position: absolute;
		bottom: -1px;
		left: 50%;
		translate: -50% 0;
		width: 2.25rem;
		height: 2px;
		border-radius: 9999px;
		background: var(--color-marka-500);
	}

	.simge {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.75rem;
		background: color-mix(in oklab, var(--foreground) 5%, transparent);
		/* Seçili olmayan logolar bir tık geride duruyor; ızgara böylece tek tek
		   logo değil, bir bütün olarak okunuyor. */
		opacity: 0.8;
		transition:
			opacity 220ms ease-out,
			scale 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.kart:hover .simge,
	.kart[aria-selected='true'] .simge {
		opacity: 1;
		scale: 1.06;
	}

	.ad {
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--foreground);
	}

	.sure {
		font-size: 0.75rem;
		line-height: 1.4;
		color: var(--muted-foreground);
		font-variant-numeric: tabular-nums;
	}

	.ipucu {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		margin-top: 0.875rem;
		font-size: 0.75rem;
		color: var(--muted-foreground);
	}

	/* --- Ayrıntı paneli --- */
	.paneller {
		display: grid;
		margin-top: 1.25rem;
		border-top: 1px solid var(--border);
		padding-top: 1.5rem;
		text-align: start;
	}

	/* Paneller aynı ızgara gözünde: geçişte yükseklik zıplamıyor. */
	.panel {
		grid-area: 1 / 1;
		display: grid;
		gap: 1rem;
		animation: panel-belir 420ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.panel[hidden] {
		display: none;
	}

	@keyframes panel-belir {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
	}

	.panel-ust {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.panel-simge {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 0.625rem;
		background: color-mix(in oklab, var(--foreground) 6%, transparent);
	}

	.panel-ad {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--foreground);
	}

	.panel-sure {
		margin-inline-start: auto;
		font-size: 0.75rem;
		color: var(--muted-foreground);
		font-variant-numeric: tabular-nums;
	}

	.panel-tanim {
		margin-top: 0.75rem;
		color: var(--muted-foreground);
		line-height: 1.65;
	}

	.panel-etiket {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: var(--muted-foreground);
	}

	.panel-metin {
		margin-top: 0.625rem;
		color: var(--foreground);
		line-height: 1.7;
	}

	@media (min-width: 640px) {
		.izgara {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.625rem;
		}
	}

	@media (min-width: 768px) {
		.panel {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 3rem;
		}
	}

	@media (min-width: 1024px) {
		.alan {
			margin-top: 2.25rem;
		}

		.kart {
			padding: 1rem 0.75rem;
		}

		.ad {
			font-size: 0.9375rem;
		}

		.panel-ad {
			font-size: 1.25rem;
		}
	}

	/*
	  Alçak masaüstü pencereleri (yatay tablet, küçük dizüstü, yarıya bölünmüş
	  ekran). Bölüm burada `min-height: 100svh` ile ekrana kilitli olduğu için
	  içerik taşarsa görünmez kalıyor — sayfa sayfa ilerleme bir hamlede tam bir
	  bölüm atlıyor, taşan kısma kimse ulaşamıyor. Bu yüzden dolgular kısalıyor.
	*/
	@media (min-width: 768px) and (max-height: 700px) {
		.alan {
			margin-top: 1.25rem;
		}

		.kart {
			padding: 0.625rem 0.5rem;
		}

		.simge {
			width: 2rem;
			height: 2rem;
			border-radius: 0.625rem;
		}

		.ipucu {
			margin-top: 0.625rem;
		}

		.paneller {
			margin-top: 0.875rem;
			padding-top: 1rem;
		}
	}

	/*
	  Dar ekranda dolgular kısılıyor. Bölüm mobilde 100svh'ye kilitli değil ama
	  ekrandan uzun kaldığı sürece sayfa sayfa geçiş orada devreden çıkıyor —
	  şartnameye göre ekrandan uzun bir bölümün her noktası geçerli bir durak.
	  Boyu kısaltmak o serbest kaydırma aralığını daraltıyor.

	  Izgara sütun sayısına dokunulmadı: 3 sütun boyu daha çok kısaltırdı ama
	  kartları 111 piksele düşürüp onaylanmış mobil düzeni değiştirirdi.
	*/
	@media (max-width: 767px) {
		.alan {
			margin-top: 1.25rem;
		}

		.kart {
			padding: 0.625rem 0.5rem;
		}

		.ipucu {
			margin-top: 0.625rem;
		}

		.paneller {
			margin-top: 0.875rem;
			padding-top: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.panel {
			animation: none;
		}

		.kart,
		.simge {
			transition: none;
		}

		.kart:hover {
			translate: none;
		}

		.kart:hover .simge,
		.kart[aria-selected='true'] .simge {
			scale: none;
		}
	}
</style>

<script is:inline>
	(function () {
		var alan = document.querySelector('[data-yetkinlik-alani]');
		if (!alan) return;

		var sekmeler = [].slice.call(alan.querySelectorAll('[role="tab"]'));
		var paneller = [].slice.call(alan.querySelectorAll('[role="tabpanel"]'));
		if (!sekmeler.length) return;

		function sec(indeks, odakla) {
			for (var i = 0; i < sekmeler.length; i++) {
				var secili = i === indeks;
				sekmeler[i].setAttribute('aria-selected', secili ? 'true' : 'false');
				// Sekme dizisinde yalnızca seçili olan sırada; aralarında ok
				// tuşlarıyla geziliyor (WAI-ARIA sekme örüntüsü).
				sekmeler[i].tabIndex = secili ? 0 : -1;
				paneller[i].hidden = !secili;
			}
			if (odakla) sekmeler[indeks].focus();
		}

		sekmeler.forEach(function (sekme, i) {
			sekme.addEventListener('click', function () {
				sec(i, false);
			});
		});

		alan.addEventListener('keydown', function (olay) {
			var su = sekmeler.indexOf(document.activeElement);
			if (su < 0) return;

			var hedef = null;
			if (olay.key === 'ArrowDown' || olay.key === 'ArrowRight') hedef = (su + 1) % sekmeler.length;
			else if (olay.key === 'ArrowUp' || olay.key === 'ArrowLeft')
				hedef = (su - 1 + sekmeler.length) % sekmeler.length;
			else if (olay.key === 'Home') hedef = 0;
			else if (olay.key === 'End') hedef = sekmeler.length - 1;

			if (hedef === null) return;
			olay.preventDefault();
			sec(hedef, true);
		});
	})();
</script>
