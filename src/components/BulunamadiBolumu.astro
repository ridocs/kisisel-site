---
import { Icon } from 'astro-icon/components';
import { cevirici, dilBul, yol } from '@/i18n/ceviriler';

const dil = dilBul(Astro.url);
const m = cevirici(dil);
---

{/*
  404 ekranı.

  Tasarım kaynağı React + framer-motion + next/image ile yazılmıştı; burada saf
  Astro ve CSS ile üretiliyor. Gerekçe: bu site tarayıcıya hiç JavaScript
  göndermiyor (React ve WebGL düğme bilinçli olarak kaldırılmıştı) ve hata
  sayfası için onu geri getirmek, hatayla karşılaşan kullanıcıya en gereksiz
  yerde yük bindirmek olurdu. Basamaklı giriş animasyonu framer-motion
  variant'larının yaptığı işi `--sira` gecikmesiyle yapıyor.

  Hayalet dış bir CDN'den PNG olarak değil, gömülü SVG olarak çiziliyor:
  ek istek yok, ölçeklenebilir ve iki temaya da uyuyor.
*/}
{/*
  `-mt-16`: Navbar sabit konumlu olduğu için akışta 64 piksellik bir boşluk
  bırakıyor. Hero da aynı telafiyi yapıyor. Olmazsa sayfa tam o kadar uzuyor
  ve tek ekranlık bir hata sayfasında gereksiz kaydırma çubuğu çıkıyor.
*/}
<section class="bulunamadi relative -mt-16 flex min-h-[100svh] w-full items-center justify-center overflow-hidden bg-background px-4">
	<div class="relative z-10 text-center">
		<div class="mb-8 flex items-center justify-center gap-4 md:mb-12 md:gap-6">
			<span class="rakam sol select-none" style="--sira: 0" aria-hidden="true">4</span>

			<span class="hayalet-yuva block" style="--sira: 1" data-hayalet>
				<svg
					class="hayalet block size-20 md:size-[120px]"
					viewBox="0 0 120 120"
					role="img"
					aria-label={m('404.hayaletAlt')}
				>
					{/* Gövde: üstü kubbe, altı dalgalı etek */}
					<path
						d="M18 62a42 42 0 0 1 84 0v42c0 4-4.6 6.2-7.8 3.7l-7.4-5.8a5 5 0 0 0-6.3.2l-6.6 5.5a5 5 0 0 1-6.4 0l-6.6-5.5a5 5 0 0 0-6.3 0l-6.6 5.5a5 5 0 0 1-6.4 0l-6.6-5.5a5 5 0 0 0-6.3-.2l-7.4 5.8C21.1 110.2 18 108 18 104z"
						class="hayalet-govde"
					></path>
					{/* Yüz ayrı bir grupta: imleç takibinde gövde sabit kalıp
					    yalnızca yüz kayıyor, böylece hareket canlı ama abartısız. */}
					<g class="hayalet-yuz">
						<ellipse cx="45" cy="58" rx="6" ry="8" class="hayalet-goz"></ellipse>
						<ellipse cx="75" cy="58" rx="6" ry="8" class="hayalet-goz"></ellipse>
						{/* Şaşkın ağız */}
						<ellipse cx="60" cy="80" rx="7" ry="9" class="hayalet-agiz"></ellipse>
					</g>
				</svg>
			</span>

			<span class="rakam sag select-none" style="--sira: 2" aria-hidden="true">4</span>
		</div>

		{/* Ekran okuyucu için asıl başlık; görsel 404 yukarıda. */}
		<h1 class="belirt text-3xl font-bold tracking-tight text-foreground md:text-5xl" style="--sira: 3">
			<span class="sr-only">404 — </span>{m('404.baslik')}
		</h1>

		<p class="belirt mt-4 text-lg text-muted-foreground md:mt-6 md:text-xl" style="--sira: 4">
			{m('404.metin')}
		</p>

		<div class="belirt mt-10 flex justify-center md:mt-12" style="--sira: 5">
			<a class="akan-dugme group" href={yol(dil)}>
				{/* Soldaki ok: normalde kadrajın dışında, üzerine gelince içeri kayıyor */}
				<Icon name="lucide:arrow-right" class="ok ok-sol" aria-hidden="true" />
				<span class="etiket">{m('404.dugme')}</span>
				<span class="daire" aria-hidden="true"></span>
				<Icon name="lucide:arrow-right" class="ok ok-sag" aria-hidden="true" />
			</a>
		</div>

		<div class="belirt mt-10" style="--sira: 6">
			<a
				class="text-muted-foreground underline underline-offset-4 transition-opacity hover:text-foreground"
				href={yol(dil, 'blog')}
			>
				{m('404.ikincilBag')}
			</a>
		</div>
	</div>
</section>

<style>
	/* Ölçüler ekran genişliğiyle akıyor; sabit kademeler 24 inçlik ekranda
	   kaba duruyordu (sitenin geri kalanıyla aynı yaklaşım). */
	.rakam {
		font-size: clamp(5rem, 11vw, 7.5rem);
		font-weight: 700;
		line-height: 1;
		color: var(--foreground);
		opacity: 0.7;
	}

	.hayalet-govde {
		fill: var(--foreground);
		opacity: 0.85;
	}

	.hayalet-goz,
	.hayalet-agiz {
		fill: var(--background);
	}

	/* İmleç takibi: betik yalnızca bu iki değişkeni yazıyor, yerleşim hiç
	   hesaplanmıyor. Yüz gövdeden bağımsız kaydığı için hareket canlı duruyor. */
	.hayalet-yuz {
		translate: var(--bakis-x, 0) var(--bakis-y, 0);
		transition: translate 260ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.hayalet-yuva {
		display: inline-block;
		rotate: var(--egim, 0deg);
		transition:
			rotate 420ms cubic-bezier(0.22, 1, 0.36, 1),
			scale 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	/* Üzerine gelince büyüyor — özgün tasarımdaki whileHover'ın karşılığı. */
	.hayalet-yuva:hover {
		scale: 1.12;
	}

	/* --- Giriş animasyonu ---
	   framer-motion'daki containerVariants/itemVariants basamaklanmasının
	   karşılığı. Gecikme `--sira` ile veriliyor; `backwards` dolgusu gecikme
	   boyunca ögeyi başlangıç durumunda tutuyor. */
	.rakam,
	.hayalet-yuva,
	.belirt {
		animation: bulunamadi-belir 620ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
		animation-delay: calc(var(--sira, 0) * 90ms);
	}

	/* Rakamlar dışarıdan içeri süzülüyor (özgün tasarımdaki numberVariants). */
	.rakam.sol {
		animation-name: rakam-sol;
	}

	.rakam.sag {
		animation-name: rakam-sag;
	}

	/* Hayalet giriş bittikten sonra yavaşça süzülmeye devam ediyor. */
	.hayalet {
		animation: hayalet-suzul 2.4s ease-in-out infinite alternate;
		animation-delay: 800ms;
	}

	@keyframes bulunamadi-belir {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
	}

	@keyframes rakam-sol {
		from {
			opacity: 0;
			transform: translate(-40px, 15px) rotate(-5deg);
		}
		to {
			opacity: 0.7;
			transform: none;
		}
	}

	@keyframes rakam-sag {
		from {
			opacity: 0;
			transform: translate(40px, 15px) rotate(5deg);
		}
		to {
			opacity: 0.7;
			transform: none;
		}
	}

	@keyframes hayalet-suzul {
		from {
			transform: translateY(-5px);
		}
		to {
			transform: translateY(5px);
		}
	}

	/* --- Akan düğme ---
	   Özgün FlowButton'ın davranışı: üzerine gelince ortadaki daire büyüyüp
	   düğmeyi dolduruyor, yazı sağa kayıyor, oklar yer değiştiriyor. */
	.akan-dugme {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		overflow: hidden;
		border-radius: 100px;
		border: 1.5px solid color-mix(in oklab, var(--foreground) 40%, transparent);
		padding: 0.75rem 2rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--foreground);
		text-decoration: none;
		isolation: isolate;
		transition:
			border-color 600ms cubic-bezier(0.23, 1, 0.32, 1),
			color 600ms cubic-bezier(0.23, 1, 0.32, 1),
			border-radius 600ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	.akan-dugme:hover,
	.akan-dugme:focus-visible {
		border-color: transparent;
		border-radius: 12px;
		color: var(--background);
	}

	.akan-dugme:active {
		transform: scale(0.95);
	}

	.akan-dugme:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}

	.etiket {
		position: relative;
		z-index: 1;
		transform: translateX(-0.75rem);
		transition: transform 800ms ease-out;
	}

	.akan-dugme:hover .etiket,
	.akan-dugme:focus-visible .etiket {
		transform: translateX(0.75rem);
	}

	.daire {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 1rem;
		height: 1rem;
		translate: -50% -50%;
		border-radius: 50%;
		background: var(--foreground);
		opacity: 0;
		transition:
			width 800ms cubic-bezier(0.19, 1, 0.22, 1),
			height 800ms cubic-bezier(0.19, 1, 0.22, 1),
			opacity 800ms cubic-bezier(0.19, 1, 0.22, 1);
	}

	.akan-dugme:hover .daire,
	.akan-dugme:focus-visible .daire {
		width: 220px;
		height: 220px;
		opacity: 1;
	}

	.ok {
		position: absolute;
		z-index: 9;
		width: 1rem;
		height: 1rem;
		color: var(--foreground);
		transition:
			left 800ms cubic-bezier(0.34, 1.56, 0.64, 1),
			right 800ms cubic-bezier(0.34, 1.56, 0.64, 1),
			color 800ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.ok-sol {
		left: -25%;
	}

	.ok-sag {
		right: 1rem;
	}

	.akan-dugme:hover .ok-sol,
	.akan-dugme:focus-visible .ok-sol {
		left: 1rem;
		color: var(--background);
	}

	.akan-dugme:hover .ok-sag,
	.akan-dugme:focus-visible .ok-sag {
		right: -25%;
		color: var(--background);
	}

	@media (prefers-reduced-motion: reduce) {
		.rakam,
		.hayalet-yuva,
		.belirt,
		.hayalet {
			animation: none;
		}

		.rakam {
			opacity: 0.7;
		}

		.akan-dugme,
		.etiket,
		.daire,
		.ok,
		.hayalet-yuz,
		.hayalet-yuva {
			transition: none;
		}

		.hayalet-yuva {
			rotate: 0deg;
		}
	}
</style>

<script is:inline>
	(function () {
		var yuva = document.querySelector('[data-hayalet]');
		if (!yuva) return;

		var yuz = yuva.querySelector('.hayalet-yuz');
		var inceIsaretci = window.matchMedia('(pointer: fine)');
		var azHareket = window.matchMedia('(prefers-reduced-motion: reduce)');

		// En fazla kayma: SVG kullanıcı birimi (viewBox 120). Küçük tutuluyor,
		// gözler yüzün dışına taşmasın.
		var BAKIS = 5;
		var EGIM = 6; // derece

		function etkinMi() {
			return inceIsaretci.matches && !azHareket.matches;
		}

		// Merkez yalnızca yeniden boyutlanma ve kaydırmada ölçülüyor; her fare
		// hareketinde getBoundingClientRect çağırmak zorunlu yeniden yerleşim
		// demekti (hero'daki simgelerde aynı hata ölçülmüştü).
		var merkez = null;

		function olc() {
			var k = yuva.getBoundingClientRect();
			merkez = { x: k.left + k.width / 2, y: k.top + k.height / 2 };
		}

		olc();
		window.addEventListener('resize', olc, { passive: true });
		window.addEventListener('scroll', olc, { passive: true });

		window.addEventListener(
			'mousemove',
			function (olay) {
				if (!etkinMi() || !merkez) return;

				var dx = olay.clientX - merkez.x;
				var dy = olay.clientY - merkez.y;
				var uzaklik = Math.hypot(dx, dy) || 1;

				// Yakınlaştıkça etki artıyor ama hiçbir zaman BAKIS'ı aşmıyor:
				// oran, uzaklığın 260 pikselde doyuma ulaşan hâli.
				var oran = Math.min(uzaklik / 260, 1);
				var bx = (dx / uzaklik) * BAKIS * oran;
				var by = (dy / uzaklik) * BAKIS * oran;

				yuz.style.setProperty('--bakis-x', bx.toFixed(2) + 'px');
				yuz.style.setProperty('--bakis-y', by.toFixed(2) + 'px');
				yuva.style.setProperty('--egim', ((dx / uzaklik) * EGIM * oran).toFixed(2) + 'deg');
			},
			{ passive: true },
		);

		// İmleç pencereden çıkınca hayalet düz bakışa dönüyor.
		document.addEventListener('mouseleave', function () {
			yuz.style.setProperty('--bakis-x', '0px');
			yuz.style.setProperty('--bakis-y', '0px');
			yuva.style.setProperty('--egim', '0deg');
		});
	})();
</script>
