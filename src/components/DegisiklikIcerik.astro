---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { ceviriler, cevirici, dilBul, yol } from '@/i18n/ceviriler';
import { degisiklikCevirisi } from '@/lib/degisiklik-ceviri';
import { siteGunlugu, surumBul } from '@/lib/surum';

/*
  SÜRÜM GÜNLÜĞÜNÜN GÖVDESİ — iki dil de bu bileşeni kullanıyor.

  Gizlilik sayfasıyla aynı gerekçe: iki sayfanın düzeni birebir aynı, yalnızca
  çerçeve metinleri değişiyor. Ayrı yazmak, zamanla iki listenin birbirinden
  ayrı düşmesini garanti ederdi.

  Sayfa ekrana kilitlenmiyor (`data-sayfa` yok): bu bir okuma sayfası, hamle
  başına bir bölüm ilerlemek uzun bir listeyi okunmaz yapardı.
*/

const dil = dilBul(Astro.url);
const m = cevirici(dil);
const yerel = dil === 'en' ? 'en-GB' : 'tr-TR';

const surum = surumBul();
const gunler = siteGunlugu();
const toplamKayit = gunler.reduce((toplam, gun) => toplam + gun.kayitlar.length, 0);

/*
  Eklenen yazının adını göstermek için yazının KENDİSİ gerekiyor; commit'te
  yalnızca dosya adı var. Koleksiyondan kurulan bu sözlük iki işi birden
  görüyor:

  1. Yazının gerçek başlığını ve adresini veriyor.
  2. Sonradan silinmiş bir yazıyı kendiliğinden eliyor — koleksiyonda yoksa
     sözlükte de yok, günlükte de görünmüyor. Silinmiş bir yazıyı "yeni yazı"
     diye listeleyip 404'e bağlamak, listenin kendisine olan güveni bitirirdi.

  Süzgeç sayfanın diline göre: İngilizce sayfada Türkçe bir yazı başlığı
  göstermek, ziyaretçiyi okuyamayacağı bir metne yollamak olurdu.
*/
const yazilar = new Map(
	(await getCollection('blog', ({ data }) => !data.draft && data.dil === dil)).map((yazi) => [
		yazi.id,
		{ baslik: yazi.data.title, adres: yol(dil, `blog/${yazi.id}/`) },
	]),
);

/*
  Tarih ISO metninden okunuyor ve saat bilerek eklenmiyor: "2026-09-14" tek
  başına verildiğinde UTC gece yarısı sayılıyor ve doğu saat dilimlerinde
  tarih bir gün kayabiliyor. Yerel gece yarısı bu kaymayı kapatıyor.
*/
function gunAdi(tarih: string): string {
	return new Date(`${tarih}T00:00:00`).toLocaleDateString(yerel, { weekday: 'long' });
}

/*
  KATKI IZGARASI: sayfanın üstündeki yoğunluk haritası.

  Önce solda yıl/ay/gün ağacı vardı. Liste 130 kayda çıkınca sayfa çok
  uzadı ve ağaç da onunla birlikte uzadı; ikisi aynı derdi paylaşıyordu.
  Izgara aynı işi tek bakışta yapıyor: hangi gün ne kadar iş yapıldığı
  renkten okunuyor, kareye basınca o günün kayıtlarına gidiliyor.

  ARALIK VERİYE GÖRE BÜYÜYOR. Github bunu hep 52 haftada gösteriyor, ama
  bu sitenin geçmişi henüz bir haftalık: 52 hafta çizmek 358 boş kare
  demekti. Aralık en eski kayda göre hesaplanıyor, en az 26 hafta (daha
  dar bir ızgara geniş ekranda pano değil ince bir şerit gibi duruyordu)
  en çok 53 hafta (bir yıldan eskisi ilgi çekmiyor).
*/
const IZGARA_EN_AZ_HAFTA = 26;
const IZGARA_EN_COK_HAFTA = 53;
const HAFTANIN_GUNU = 7;

interface IzgaraGunu {
	/** Gelecekteki kareler boş kalıyor; onlarda tarih yok. */
	tarih: string | null;
	sayi: number;
	/** 0 boş, 1..4 yoğunluk basamağı. */
	seviye: number;
}

/** Bir güne çapa kimliği. `id` rakamla başlayamayacağı için önek var. */
function gunCapa(tarih: string): string {
	return `gun-${tarih}`;
}

function isoGun(d: Date): string {
	const yil = d.getFullYear();
	const ay = String(d.getMonth() + 1).padStart(2, '0');
	const gun = String(d.getDate()).padStart(2, '0');
	return `${yil}-${ay}-${gun}`;
}

function gunEkle(d: Date, adet: number): Date {
	const yeni = new Date(d);
	yeni.setDate(yeni.getDate() + adet);
	return yeni;
}

function izgaraKur() {
	if (gunler.length === 0) return null;

	const sayilar = new Map(gunler.map((g) => [g.tarih, g.kayitlar.length]));
	const enEski = gunler[gunler.length - 1].tarih;

	const bugun = new Date();
	bugun.setHours(0, 0, 0, 0);

	/*
	  Son sütun içinde bulunulan haftanın tamamı: ızgara sağdan hizalı
	  duruyor ve "bugün" her zaman en sağdaki sütunda oluyor. Hafta
	  pazartesi başlıyor (ISO); `getDay()` pazarı 0 saydığı için kaydırma
	  gerekiyor.
	*/
	const haftaninGunu = (bugun.getDay() + 6) % 7;
	const sonPazar = gunEkle(bugun, 6 - haftaninGunu);

	const gecenGun = Math.round(
		(sonPazar.getTime() - new Date(`${enEski}T00:00:00`).getTime()) / 86_400_000,
	);
	const haftaSayisi = Math.min(
		Math.max(Math.ceil((gecenGun + 1) / HAFTANIN_GUNU), IZGARA_EN_AZ_HAFTA),
		IZGARA_EN_COK_HAFTA,
	);

	const ilkPazartesi = gunEkle(sonPazar, -(haftaSayisi * HAFTANIN_GUNU - 1));

	const kareler: IzgaraGunu[] = [];
	const ayEtiketleri: { sutun: number; ad: string }[] = [];
	let oncekiAy = '';

	for (let hafta = 0; hafta < haftaSayisi; hafta++) {
		for (let gun = 0; gun < HAFTANIN_GUNU; gun++) {
			const tarih = gunEkle(ilkPazartesi, hafta * HAFTANIN_GUNU + gun);
			const ileride = tarih.getTime() > bugun.getTime();
			const iso = isoGun(tarih);
			kareler.push({
				tarih: ileride ? null : iso,
				sayi: ileride ? 0 : (sayilar.get(iso) ?? 0),
				seviye: 0,
			});
		}

		/*
		  Ay etiketi sütunun ilk gününe bakıyor. Ay ortasında başlayan bir
		  sütun bir öncekine yazılırsa etiket bir hafta erken görünüyordu.
		*/
		const sutunBasi = gunEkle(ilkPazartesi, hafta * HAFTANIN_GUNU);
		const ayAnahtari = `${sutunBasi.getFullYear()}-${sutunBasi.getMonth()}`;
		if (ayAnahtari !== oncekiAy) {
			/*
			  Ay adı sütundan geniş. İki etiket üç sütundan yakınsa ikincisi
			  atlanıyor, yoksa yan yana yazılıp birbirine giriyorlar
			  ("MarNis" diye okunuyordu).
			*/
			const sonEtiket = ayEtiketleri.at(-1);
			/*
			  İlk sütun neredeyse hiç ayın 1'ine denk gelmiyor: aralık bugüne
			  göre geriye sayıldığı için ayın ortasından başlıyor. Oraya ay
			  adı yazmak hem yanlış yeri işaret ediyor hem de bir sonraki
			  gerçek ay başlangıcını aralık kuralına takılıp sildiriyordu.
			*/
			if (hafta > 0 && (!sonEtiket || hafta - sonEtiket.sutun >= 3)) {
				ayEtiketleri.push({
					sutun: hafta,
					ad: sutunBasi.toLocaleDateString(yerel, { month: 'short' }),
				});
			}
			oncekiAy = ayAnahtari;
		}
	}

	/*
	  Basamaklar EN YOĞUN GÜNE göre bölünüyor, sabit eşiklerle değil. Sabit
	  eşik (1, 3, 6, 10 gibi) bu sitede her günü en koyu basamağa atardı:
	  yedi günde 130 kayıt var, yani günde yaklaşık yirmi.
	*/
	const enCok = Math.max(0, ...sayilar.values());
	for (const kare of kareler) {
		if (kare.sayi > 0 && enCok > 0) {
			kare.seviye = Math.min(4, Math.ceil((kare.sayi / enCok) * 4));
		}
	}

	/* Satır etiketleri dilden geliyor: "Pzt" ile "Mon" aynı yerde durmuyor. */
	const satirAdlari = Array.from({ length: HAFTANIN_GUNU }, (_, i) =>
		gunEkle(ilkPazartesi, i).toLocaleDateString(yerel, { weekday: 'short' }),
	);

	return { kareler, ayEtiketleri, haftaSayisi, satirAdlari, enCok };
}

const izgara = izgaraKur();

/** Kare ipucu: "14 Eylül 2026, 39 değişiklik". Ekran okuyucu da bunu okuyor. */
function kareNotu(kare: IzgaraGunu): string {
	if (!kare.tarih) return '';
	return `${uzunTarih(kare.tarih)}, ${kare.sayi} ${m('degisiklik.kunyeKayit').toLocaleLowerCase(yerel)}`;
}

/*
  ÇERÇEVE METNİNİ ESNEK OKUMA.

  Aşağıdaki dil rozeti için `degisiklik` bölümünde henüz bir anahtar
  olmayabilir — o dosya ayrı bir iş olarak düzenleniyor. Anahtar gelince
  kendiliğinden kullanılsın, gelmediği sürece de sayfa derlensin diye metin
  sözlükten esnek okunuyor: yoksa ya da boşsa yedek metin basılıyor.

  `cevirici` burada kullanılamıyor, çünkü tipi yalnızca var olan anahtarları
  kabul ediyor; olmayan bir anahtar derlemeyi durdururdu.
*/
function esnekMetin(anahtar: string, yedek: string): string {
	const deger = (ceviriler[dil] as Record<string, string | undefined>)[anahtar];
	return deger && deger.trim() !== '' ? deger : yedek;
}

/*
  KAYIT BAŞLIĞININ SAYFANIN DİLİNDEKİ HÂLİ.

  Başlıklar git'ten geliyor ve Türkçe yazılıyor. İngilizce sayfada
  `src/icerik/degisiklik-cevirileri.json` sözlüğünden geçiyorlar; sözlükte
  karşılığı olmayan başlık Türkçe kalıyor ve dil kodu bunu söylüyor.
  Gerekçesi `src/lib/degisiklik-ceviri.ts` başında.
*/
function kayitBasligi(baslik: string): { metin: string; dilKodu: 'tr' | 'en' } {
	if (dil !== 'en') return { metin: baslik, dilKodu: 'tr' };
	const ceviri = degisiklikCevirisi(baslik);
	return ceviri ? { metin: ceviri, dilKodu: 'en' } : { metin: baslik, dilKodu: 'tr' };
}

function uzunTarih(tarih: string): string {
	return new Date(`${tarih}T00:00:00`).toLocaleDateString(yerel, {
		day: 'numeric',
		month: 'long',
		year: 'numeric',
	});
}
---

{/*
  1) Giriş. Gizlilik sayfasıyla aynı açılış ölçüsü: üst başlık, ad, marka
  renginde kısa çizgi, sonra künye. Künye burada "hangi sürüm yayında"
  sorusunun cevabı — altbilgideki kısa kimliğin uzun hâli.
*/}
<section class="bolum giris-bolum" data-belir data-parcali>
	<p class="ust-baslik" data-belir-oge style="--sira: 0">{m('degisiklik.ustBaslik')}</p>

	<h1 class="ana-baslik" data-belir-oge style="--sira: 1">{m('degisiklik.baslik')}</h1>

	<div class="cizgi" data-belir-oge data-belir-cizgi style="--sira: 2" aria-hidden="true"></div>

	<p class="giris-cumle" data-belir-oge style="--sira: 3">{m('degisiklik.giris')}</p>
	<p class="paragraf" data-belir-oge style="--sira: 4">{m('degisiklik.metin')}</p>

	<dl class="kunye" data-belir-oge style="--sira: 5">
		{
			/* Sürüm satırı yalnızca okunabildiyse basılıyor. Boş bir "—" koymak,
			   bilgi yokken bilgi varmış gibi bir satır bırakmak olurdu. */
			surum && (
				<div class="kunye-satir">
					<dt>{m('degisiklik.kunyeSurum')}</dt>
					<dd class="tek-aralik">{surum.kimlik}</dd>
				</div>
			)
		}
		{
			gunler.length > 0 && (
				<div class="kunye-satir">
					<dt>{m('degisiklik.kunyeTarih')}</dt>
					<dd>{uzunTarih(gunler[0].tarih)}</dd>
				</div>
			)
		}
		{
			toplamKayit > 0 && (
				<div class="kunye-satir">
					<dt>{m('degisiklik.kunyeKayit')}</dt>
					<dd class="tek-aralik">{toplamKayit}</dd>
				</div>
			)
		}
	</dl>

	<p class="not" data-belir-oge style="--sira: 6">{m('degisiklik.dilNotu')}</p>
</section>

{/*
  2) Katkı ızgarası: hangi gün ne kadar iş yapıldığı.

  Betik YOK. Kareler `<a>`, hedefleri aynı sayfadaki gün çapaları; yumuşak
  kaydırmayı CSS yapıyor. Kaydı olmayan gün `<span>` kalıyor, çünkü hiçbir
  yere gitmeyen bir bağlantı klavyeyle gezene boşa durak.

  Dar ekranda ızgara yatay kayıyor (`overflow-x`) ve sağdan başlıyor: en
  yeni hafta ilk görünen sütun oluyor.
*/}
{
	izgara && (
		<section class="izgara-alan" data-belir data-parcali>
			<p class="izgara-baslik" data-belir-oge style="--sira: 0">
				{m('degisiklik.izgaraBaslik')}
			</p>

			<div class="izgara-kart" data-belir-oge style="--sira: 1">
			<div class="izgara-kaydir">
				<div class="izgara" style={`--hafta: ${izgara.haftaSayisi}`}>
					<div class="izgara-aylar" aria-hidden="true">
						{izgara.ayEtiketleri.map((ay) => (
							<span class="ay-etiket" style={`--sutun: ${ay.sutun + 1}`}>
								{ay.ad}
							</span>
						))}
					</div>

					{/* Satır adları: yedi etiket bu boyutta üst üste bindiği için
					    biri atlanarak basılıyor. Son satır (pazar) boş bırakıldı,
					    etiketi ölçek satırına değiyordu. */}
					<div class="izgara-satirlar" aria-hidden="true">
						{izgara.satirAdlari.map((ad, sira) => (
							<span class="satir-etiket" style={`--satir: ${sira + 1}`}>
								{sira % 2 === 0 && sira < 6 ? ad : ''}
							</span>
						))}
					</div>

					<div class="izgara-kareler">
						{izgara.kareler.map((kare) =>
							kare.tarih && kare.sayi > 0 ? (
								<a
									class="kare"
									href={`#${gunCapa(kare.tarih)}`}
									data-seviye={kare.seviye}
									title={kareNotu(kare)}
									aria-label={kareNotu(kare)}
								/>
							) : (
								<span class="kare" data-seviye="0" aria-hidden="true" />
							),
						)}
					</div>
				</div>
			</div>

			<p class="izgara-olcek">
				<span>{m('degisiklik.izgaraAz')}</span>
				<span class="olcek-kutulari" aria-hidden="true">
					<span class="kare" data-seviye="0" />
					<span class="kare" data-seviye="1" />
					<span class="kare" data-seviye="2" />
					<span class="kare" data-seviye="3" />
					<span class="kare" data-seviye="4" />
				</span>
				<span>{m('degisiklik.izgaraCok')}</span>
			</p>
			</div>
		</section>
	)
}

<div class="gunluk-duzen">
	<div class="gunluk-akis">
{
	/*
	  git okunamadıysa liste boş kalıyor ve sayfa bunu kendi söylüyor.
	  Sessizce boş bir sayfa göstermek, ziyaretçiye "hiç değişiklik olmadı"
	  demekle aynı kapıya çıkardı — oysa olan şey başka.
	*/
	gunler.length === 0 ? (
		<section class="bolum" data-belir data-parcali>
			<h2 class="baslik" data-belir-oge style="--sira: 0">
				{m('degisiklik.bosBaslik')}
			</h2>
			<p class="bolum-metin" data-belir-oge style="--sira: 1">
				{m('degisiklik.bosMetin')}
			</p>
		</section>
	) : (
		gunler.map((gun, sira) => (
			/*
			  Her gün katlanabilir. Yalnızca EN YENİ gün açık geliyor: yedi
			  günde 130 kayıt var ve hepsi açıkken sayfa yirmi ekran
			  sürüyordu. Kapalı günler ızgaradan ya da başlığa basılarak
			  açılıyor.

			  Çapa `<details>` üzerinde: tarayıcı çapaya giderken kapalı bir
			  `<details>` içindeki hedefi kendiliğinden açıyor, ama hedefin
			  kendisi kapalı öğeyse zaten görünür oluyor.
			*/
			<details class="bolum gun-kutusu" id={gunCapa(gun.tarih)} open={sira === 0} data-belir data-parcali>
				<summary class="gun-ozet" data-belir-oge style="--sira: 0">
					<Icon name="lucide:chevron-right" class="gun-ok" aria-hidden="true" />
					<span class="gun-metin">
						<span class="ust-baslik">{gunAdi(gun.tarih)}</span>
						<span class="baslik">
							<time datetime={gun.tarih}>{uzunTarih(gun.tarih)}</time>
						</span>
					</span>
					<span class="gun-sayac">{gun.kayitlar.length}</span>
				</summary>

				{/*
				  Basamaklı belirme listenin TAMAMINA bir kez uygulanıyor, kaleme
				  kalem değil: kalabalık bir günde yirmi kalem × 70 ms, son satırı
				  bir buçuk saniye geciktirirdi.
				*/}
				<ul class="kayitlar" data-belir-oge style="--sira: 2">
					{gun.kayitlar.map((kayit) => {
						const govde = kayitBasligi(kayit.baslik);
						// Sayfanın dilinden başka bir dilde kalan başlık işaretleniyor:
						// `lang` ekran okuyucunun doğru sesletmesi için (WCAG 3.1.2),
						// rozet de ziyaretçinin metnin neden yabancı olduğunu görmesi
						// için. Aynı dildeyse ikisi de basılmıyor.
						const yabanci = govde.dilKodu !== dil;

						return (
							<li class="kayit">
								<span class="im" aria-hidden="true" />
								<div class="kayit-govde">
									<p class="kayit-baslik" lang={yabanci ? govde.dilKodu : undefined}>
										{govde.metin}
										{yabanci && (
											/* Rozet ekran okuyucudan gizli: aynı bilgi `lang`
											   özniteliğiyle zaten veriliyor, iki kez duyurmak
											   başlığı gürültüye boğardı. */
											<span class="dil-rozeti" aria-hidden="true">
												{esnekMetin('degisiklik.cevrilmedi', govde.dilKodu.toUpperCase())}
											</span>
										)}
									</p>
									{kayit.yeniYazilar
										.map((adres) => yazilar.get(adres))
										.filter((yazi) => yazi !== undefined)
										.map((yazi) => (
											<a class="yazi" href={yazi.adres}>
												<Icon name="lucide:file-text" class="size-4 yazi-simge" aria-hidden="true" />
												<span class="yazi-etiket">{m('degisiklik.yeniYazi')}</span>
												<span class="yazi-baslik">{yazi.baslik}</span>
											</a>
										))}
								</div>
							</li>
						);
					})}
				</ul>
			</details>
		))
	)
}
	</div>
</div>

<style>
	/* ------------------------------------------------------------------ *
	 * Katkı ızgarası
	 * ------------------------------------------------------------------ */

	.izgara-alan {
		padding-block: 1.25rem 2rem;
	}

	/*
	  Izgara çerçeveli bir kartın içinde. Çerçevesiz hâlde sayfanın geri
	  kalanıyla aynı düzlemde duruyordu ve kareler başıboş görünüyordu;
	  kart onları tek bir nesne yapıyor.
	*/
	.izgara-kart {
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		padding: 1rem;
		background: color-mix(in oklab, var(--foreground) 2%, transparent);
		/*
		  TAŞMA KESİCİ.

		  `body` bir flex kapsayıcı ve `main` onun öğesi; flex öğesinin
		  varsayılan `min-width: auto` değeri "içeriğin tamamı kadar geniş ol"
		  demek. Izgara `max-content` genişliğinde olduğu için bu zincir
		  yukarı doğru itiliyor ve dar ekranda SAYFANIN TAMAMI taşıyordu
		  (390 piksellik ekranda belge 486 piksel ölçüldü).

		  `min-width: 0` tek başına yetmedi. Kart bir ızgara kapsayıcısına
		  çevrildi ve tek sütunu `minmax(0, 1fr)` oldu: sütunun en küçük
		  genişliği açıkça sıfır olunca içerik onu genişletemiyor, taşma
		  kaydırma kutusunun içinde kalıyor.
		*/
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		min-width: 0;
	}

	.izgara-baslik {
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted-foreground);
		margin-bottom: 0.75rem;
	}

	/*
