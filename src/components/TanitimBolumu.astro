---
import { Icon } from 'astro-icon/components';
import { cevirici, dilBul, yol } from '@/i18n/ceviriler';

const dil = dilBul(Astro.url);
const m = cevirici(dil);
const hakkimdaYolu = yol(dil, dil === 'en' ? 'about' : 'hakkimda');

/*
  Yer tutucu görsel. Kendi fotoğrafın hazır olduğunda bu satırı değiştirmen
  yeterli; en iyi sonuç için dikey (4:5) bir kare veya portre kullan.
  Yerel bir dosya koyacaksan public/ altına atıp "/fotograf.jpg" yazabilirsin.
*/
const gorsel =
	'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=900&q=80&auto=format&fit=crop';
---

{/*
  Masaüstünde bölüm ekranı tam kaplıyor: sayfa sayfa ilerleme ancak her bölüm
  bir ekran boyunda olduğunda anlamlı. Mobilde doğal akış korunuyor —
  içeriği zorla ekrana yaymak küçük ekranda boşluk ve kayma üretiyordu.
*/}
<section
	class="relative overflow-hidden py-20 sm:py-28 md:grid md:min-h-[100svh] md:place-items-center md:py-24"
	data-belir
	data-parcali
	data-sayfa
>
	{/* Arkadaki yumuşak parıltı; içeriğin okunmasını engellemesin diye çok soluk. */}
	<div
		class="tanitim-isik pointer-events-none absolute inset-0 -z-10"
		aria-hidden="true"
	>
	</div>

	{/*
	  Maske SVG ile tanımlı: clip-path'in polygon() biçimi köşe yuvarlatamıyor.
	  clipPathUnits="objectBoundingBox" sayesinde koordinatlar 0-1 arası oranlar,
	  yani şekil görselin boyutuyla birlikte ölçekleniyor.
	*/}
	<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
		<defs>
			<clipPath id="tanitim-maskesi" clipPathUnits="objectBoundingBox">
				<path
					d="M0.32 0 L0.96 0 Q1 0 1 0.04 L1 0.74 Q1 0.78 0.96 0.78 L0.76 0.78 Q0.72 0.78 0.72 0.82 L0.72 0.96 Q0.72 1 0.68 1 L0.04 1 Q0 1 0 0.96 L0 0.26 Q0 0.22 0.04 0.22 L0.24 0.22 Q0.28 0.22 0.28 0.18 L0.28 0.04 Q0.28 0 0.32 0 Z"
				></path>
			</clipPath>
		</defs>
	</svg>

	<div
		class="mx-auto flex w-full max-w-5xl flex-col items-center gap-12 px-4 md:flex-row md:gap-16 lg:max-w-6xl lg:gap-20 xl:max-w-7xl xl:gap-24"
	>
		{/* Görsel: dikdörtgen yerine organik bir maske ile şekillendirildi. */}
		<div class="relative shrink-0" data-belir-oge data-belir-gorsel style="--sira: 0">
			{/* Arkadaki katman aynı şekli alıp sağ-aşağı kaydırılıyor; clip-path
			    gölgeyi kırptığı için derinlik buradan geliyor. */}
			<div
				class="gorsel-maske pointer-events-none absolute inset-0 -z-10 translate-x-4 translate-y-4 bg-gradient-to-br from-marka-500/40 to-marka-400/15"
				aria-hidden="true"
			>
			</div>
			<img
				src={gorsel}
				alt={m('tanitim.gorselAlt')}
				width="380"
				height="475"
				loading="lazy"
				decoding="async"
				class="gorsel-maske w-[min(250px,62vw)] object-cover sm:w-[320px] lg:w-[440px] xl:w-[500px]"
			/>
		</div>

		<div class="max-w-lg lg:max-w-2xl">
			<h2
				class="text-sm font-semibold tracking-[0.18em] text-slate-500 lg:text-base dark:text-neutral-400"
				data-belir-oge
				style="--sira: 1"
			>
				{m('tanitim.ustBaslik')}
			</h2>
			<div
				class="mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-marka-600 to-marka-400 lg:w-32"
				data-belir-oge
				data-belir-cizgi
				style="--sira: 2"
			>
			</div>

			<p
				class="mt-8 text-slate-600 lg:text-lg lg:leading-relaxed dark:text-neutral-300"
				data-belir-oge
				style="--sira: 3"
			>{m('tanitim.paragraf1')}</p>
			<p
				class="mt-4 text-slate-600 lg:text-lg lg:leading-relaxed dark:text-neutral-300"
				data-belir-oge
				style="--sira: 4"
			>{m('tanitim.paragraf2')}</p>
			<p
				class="mt-4 text-slate-600 lg:text-lg lg:leading-relaxed dark:text-neutral-300"
				data-belir-oge
				style="--sira: 5"
			>{m('tanitim.paragraf3')}</p>

			<a
				href={hakkimdaYolu}
				data-belir-oge
				style="--sira: 6"
				class="mt-8 inline-flex items-center gap-2 rounded-full bg-slate-900 px-7 py-3 text-sm font-medium text-white transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current motion-reduce:transition-none dark:bg-white dark:text-neutral-900"
			>
				<span>{m('tanitim.dugme')}</span>
				<Icon name="lucide:arrow-right" class="size-4" />
			</a>
		</div>
	</div>
</section>

<style>
	/* Bulanıklık süzgeci yerine gradyan: 520 piksellik bir daireye 160 piksel
	   bulanıklık iOS'ta pahalıya mal oluyordu. Görünüm aynı, maliyeti yok. */
	.tanitim-isik {
		background: radial-gradient(34rem 28rem at 50% 0%, oklch(0.62 0.18 250 / 0.12), transparent 70%);
	}

	/*
	  İki dikdörtgenin birleşimi: biri sol-altta, diğeri sağ-üstte ve birbirinin
	  içine geçmiş. Nokta sırası saat yönünde, sağ üstteki dikdörtgenin sol
	  kenarından başlıyor:

	     ┌───────┐  <- sağ üstteki dikdörtgen
	     │       │
	  ┌──┤       │
	  │      ────┘
	  │          │
	  └──────┘     <- sol alttaki dikdörtgen

	  clip-path gölgeyi de kırptığı için derinlik, arkadaki katmanın aynı
	  şekille biraz kaydırılmasından geliyor.
	*/
	.gorsel-maske {
		aspect-ratio: 4 / 5;
		clip-path: url(#tanitim-maskesi);
	}
</style>
