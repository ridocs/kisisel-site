---
import { Image } from 'astro:assets';
import AkanDugme from './AkanDugme.astro';
import { cevirici, dilBul, yol } from '@/i18n/ceviriler';
import portre from '@/assets/mustafa-eybek.jpg';

const dil = dilBul(Astro.url);
const m = cevirici(dil);
const hakkimdaYolu = yol(dil, dil === 'en' ? 'about' : 'hakkimda');

/*
  Portre. `public/` yerine `src/assets/` altında: oradaki dosyalar olduğu gibi
  kopyalanıyor, buradakiler derleme sırasında işleniyor. 888×1489'luk özgün
  JPEG 233 KB'tı ve tarayıcıya aynen iniyordu; oysa görsel ekranda en fazla
  400 piksel genişlikte duruyor. Ölçüler ve WebP karşılığı artık derlemede
  üretiliyor, tarayıcı da kendi genişliğine uyanı indiriyor.

  Fotoğrafı değiştirmek için bu dosyanın üzerine yazmak yeterli; boyutlandırma
  ve biçim dönüşümü kendiliğinden yeniden yapılıyor.

  Özgün oran maskenin 4:5'inden daha dar ve uzun. Kırpma `object-position` ile
  yukarı kaydırıldı; ortadan kırpınca kadraj göbekten başlıyordu.
*/
const GENISLIKLER = [250, 300, 400, 500, 600, 800];
const OLCU = '(min-width: 768px) 25rem, (min-width: 640px) 300px, min(250px, 62vw)';
---

{/*
  Masaüstünde bölüm ekranı tam kaplıyor: sayfa sayfa ilerleme ancak her bölüm
  bir ekran boyunda olduğunda anlamlı. Mobilde doğal akış korunuyor —
  içeriği zorla ekrana yaymak küçük ekranda boşluk ve kayma üretiyordu.
*/}
<section
	class="relative overflow-hidden py-16 sm:py-20 md:grid md:min-h-[100svh] md:place-items-center md:py-12"
	data-belir
	data-parcali
	data-sayfa
>
	{/* Arkadaki yumuşak parıltı; içeriğin okunmasını engellemesin diye çok soluk. */}
	<div
		class="tanitim-isik pointer-events-none absolute inset-0 -z-10"
		aria-hidden="true"
	>
	</div>

	{/*
	  Maske SVG ile tanımlı: clip-path'in polygon() biçimi köşe yuvarlatamıyor.
	  clipPathUnits="objectBoundingBox" sayesinde koordinatlar 0-1 arası oranlar,
	  yani şekil görselin boyutuyla birlikte ölçekleniyor.
	*/}
	<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
		<defs>
			<clipPath id="tanitim-maskesi" clipPathUnits="objectBoundingBox">
				<path
					d="M0.32 0 L0.96 0 Q1 0 1 0.04 L1 0.74 Q1 0.78 0.96 0.78 L0.76 0.78 Q0.72 0.78 0.72 0.82 L0.72 0.96 Q0.72 1 0.68 1 L0.04 1 Q0 1 0 0.96 L0 0.26 Q0 0.22 0.04 0.22 L0.24 0.22 Q0.28 0.22 0.28 0.18 L0.28 0.04 Q0.28 0 0.32 0 Z"
				></path>
			</clipPath>
		</defs>
	</svg>

	<div
		class="relative z-10 mx-auto flex w-full max-w-5xl flex-col items-center gap-10 px-4 md:flex-row md:gap-12 lg:gap-16"
	>
		{/* Görsel: dikdörtgen yerine organik bir maske ile şekillendirildi. */}
		<div class="relative shrink-0" data-belir-oge data-belir-gorsel style="--sira: 0">
			{/* Arkadaki katman aynı şekli alıp sağ-aşağı kaydırılıyor; clip-path
			    gölgeyi kırptığı için derinlik buradan geliyor. */}
			<div
				class="gorsel-maske pointer-events-none absolute inset-0 -z-10 translate-x-4 translate-y-4 bg-gradient-to-br from-marka-500/40 to-marka-400/15"
				aria-hidden="true"
			>
			</div>
			<Image
				src={portre}
				alt={m('tanitim.gorselAlt')}
				widths={GENISLIKLER}
				sizes={OLCU}
				format="webp"
				loading="lazy"
				decoding="async"
				class="gorsel-maske object-cover object-[50%_30%]"
			/>
		</div>

		<div class="max-w-lg lg:max-w-xl">
			<h2
				class="text-sm font-semibold tracking-[0.18em] text-slate-500 dark:text-neutral-400"
				data-belir-oge
				style="--sira: 1"
			>
				{m('tanitim.ustBaslik')}
			</h2>
			<div
				class="mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-marka-600 to-marka-400 lg:w-28"
				data-belir-oge
				data-belir-cizgi
				style="--sira: 2"
			>
			</div>

			<p
				class="mt-6 text-slate-600 leading-relaxed dark:text-neutral-300"
				data-belir-oge
				style="--sira: 3"
			>{m('tanitim.paragraf1')}</p>
			<p
				class="mt-4 text-slate-600 leading-relaxed dark:text-neutral-300"
				data-belir-oge
				style="--sira: 4"
			>{m('tanitim.paragraf2')}</p>
			<p
				class="mt-4 text-slate-600 leading-relaxed dark:text-neutral-300"
				data-belir-oge
				style="--sira: 5"
			>{m('tanitim.paragraf3')}</p>

			{/*
			  Sitedeki öbür düğmelerle aynı akan düğme. `aria-label` korundu:
			  görünen metin tek başına ("Devamını oku") nereye gittiğini
			  söylemiyor, ekran okuyucuya hedef sayfa da veriliyor.
			*/}
			<AkanDugme
				href={hakkimdaYolu}
				agirlik="dolu"
				class="mt-7"
				data-belir-oge
				style="--sira: 6"
				aria-label={`${m('tanitim.dugme')}, ${m('nav.hakkimda')}`}
			>
				{m('tanitim.dugme')}
			</AkanDugme>
		</div>
	</div>
</section>

<style>
	/* Bulanıklık süzgeci yerine gradyan: 520 piksellik bir daireye 160 piksel
	   bulanıklık iOS'ta pahalıya mal oluyordu. Görünüm aynı, maliyeti yok. */
	.tanitim-isik {
		background: radial-gradient(34rem 28rem at 50% 0%, oklch(0.62 0.18 250 / 0.12), transparent 70%);
	}

	/*
	  İki dikdörtgenin birleşimi: biri sol-altta, diğeri sağ-üstte ve birbirinin
	  içine geçmiş. Nokta sırası saat yönünde, sağ üstteki dikdörtgenin sol
	  kenarından başlıyor:

	     ┌───────┐  <- sağ üstteki dikdörtgen
	     │       │
	  ┌──┤       │
	  │      ────┘
	  │          │
	  └──────┘     <- sol alttaki dikdörtgen

	  clip-path gölgeyi de kırptığı için derinlik, arkadaki katmanın aynı
	  şekille biraz kaydırılmasından geliyor.
	*/
	.gorsel-maske {
		aspect-ratio: 4 / 5;
		clip-path: url(#tanitim-maskesi);
	}

	/* Ölçü yalnızca görselde: arkadaki katman `absolute inset-0` ile zaten
	   görselin kapladığı alanı alıyor, ona ayrıca genişlik vermek iki kısıtı
	   çakıştırırdı. */
	img.gorsel-maske {
		width: min(250px, 62vw);
	}

	@media (min-width: 640px) {
		img.gorsel-maske {
			width: 300px;
		}
	}

	/*
	  Masaüstünde genişlik ekranın YÜKSEKLİĞİNE bağlı. Görsel 4:5 olduğu için
	  boyu genişliğinin 1.25 katı; genişliği yalnızca ekran genişliğine
	  bağlamak 24 inç 1080p gibi "geniş ama alçak" ekranlarda 625 piksellik
	  bir fotoğraf üretiyordu — görünür alanın yaklaşık dörtte üçü.

	  clamp içinde rem bileşeni bilinçli: salt viewport birimiyle kurulan bir
	  ölçek kullanıcı yakınlaştırdığında büyümüyor ve WCAG 1.4.4'ü karşılamıyor.
	  Üst sınır alt sınırın 1.5 katı, yani ölçek zoom altında güvenli.
	*/
	@media (min-width: 768px) {
		img.gorsel-maske {
			width: clamp(17rem, 12rem + 20vh, 25rem);
		}
	}
</style>
