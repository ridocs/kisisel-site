---
/*
  Her logo kendi yönüne ve genliğine sahip olsun diye küçük birer desen.
  Hepsi aynı yöne süzülünce hareket tekdüze ve mekanik görünüyordu.
  Yalnızca transform değerleri; boyama maliyeti yok.
*/
const KAY_X = [12, -14, 9, -11, 15, -8, 13, -15];
const KAY_Y = [-18, -13, -22, -16, -11, -20, -14, -19];
const DON = [6, -5, 4, -7, 5, -4, 7, -6];

import { Icon } from 'astro-icon/components';

interface Props {
	baslik: string;
	altBaslik: string;
	birincilMetin: string;
	birincilHedef: string;
	ikincilMetin: string;
	ikincilHedef: string;
}

const { baslik, altBaslik, birincilMetin, birincilHedef, ikincilMetin, ikincilHedef } =
	Astro.props;

/*
  Bu bölüm React'ten Astro'ya taşındı. Önceden framer-motion ve React DOM
  yalnızca bu animasyonlar için indiriliyordu (yaklaşık 155 KB). Yüzme ve giriş
  animasyonları artık saf CSS; imleçten kaçma küçük bir betikle yapılıyor.

  Logolar Iconify "logos" setinden, derleme sırasında satır içi SVG olarak
  gömülüyor. `tersle` işaretli olanlar koyu zeminde kaybolduğu için koyu temada
  ters çevriliyor.
*/
const ikonlar = [
	// --- Dar ekranda da görünen çekirdek (10) ---
	{ ad: 'Astro', ikon: 'logos:astro-icon', tersle: true, sinif: 'top-[26%] left-[6%] md:top-[20%] md:left-[6%]' },
	{ ad: 'TypeScript', ikon: 'logos:typescript-icon', sinif: 'top-[22%] right-[7%] md:top-[18%] md:right-[6%]' },
	{ ad: 'Tailwind CSS', ikon: 'logos:tailwindcss-icon', sinif: 'bottom-[14%] left-[10%] md:bottom-[12%] md:left-[9%]' },
	{ ad: 'React', ikon: 'logos:react', sinif: 'bottom-[16%] right-[9%] md:bottom-[12%] md:right-[9%]' },
	{ ad: 'JavaScript', ikon: 'logos:javascript', sinif: 'top-[42%] left-[4%] md:top-[40%] md:left-[4%]' },
	{ ad: 'Docker', ikon: 'logos:docker-icon', sinif: 'top-[46%] right-[4%] md:top-[44%] md:right-[4%]' },
	{ ad: 'HTML5', ikon: 'logos:html-5', sinif: 'bottom-[6%] left-[30%] md:bottom-[5%] md:left-[32%]' },
	{ ad: 'CSS3', ikon: 'logos:css-3', sinif: 'bottom-[7%] right-[29%] md:bottom-[5%] md:right-[32%]' },
	{ ad: 'Node.js', ikon: 'logos:nodejs-icon', sinif: 'top-[13%] left-[18%] md:top-[10%] md:left-[16%]' },
	{ ad: 'Git', ikon: 'logos:git-icon', sinif: 'top-[12%] right-[19%] md:top-[9%] md:right-[16%]' },

	// --- md (768) ---
	{ ad: 'Google Cloud', ikon: 'logos:google-cloud', sinif: 'top-[60%] left-[8%] hidden md:block' },
	{ ad: 'Go', ikon: 'logos:go', sinif: 'top-[62%] right-[8%] hidden md:block' },

	// --- lg (1024) ---
	{ ad: 'Kubernetes', ikon: 'logos:kubernetes', sinif: 'top-[32%] left-[13%] hidden lg:block' },
	{ ad: 'Linux', ikon: 'logos:linux-tux', sinif: 'top-[30%] right-[13%] hidden lg:block' },
	{ ad: 'Vite', ikon: 'logos:vitejs', sinif: 'bottom-[22%] left-[18%] hidden lg:block' },
	{ ad: 'Vercel', ikon: 'logos:vercel-icon', tersle: true, sinif: 'bottom-[24%] right-[18%] hidden lg:block' },

	// --- xl (1280) ---
	{ ad: 'Rust', ikon: 'logos:rust', sinif: 'top-[8%] left-[9%] hidden xl:block' },
	{ ad: 'PHP', ikon: 'logos:php', sinif: 'top-[7%] right-[9%] hidden xl:block' },
	{ ad: 'npm', ikon: 'logos:npm-icon', sinif: 'bottom-[8%] left-[18%] hidden xl:block' },
	{ ad: 'Markdown', ikon: 'logos:markdown', tersle: true, sinif: 'bottom-[9%] right-[18%] hidden xl:block' },

	// --- 1600 ---
	{ ad: 'Ubuntu', ikon: 'logos:ubuntu', sinif: 'top-[52%] left-[12%] hidden min-[1600px]:block' },
	{ ad: 'Nginx', ikon: 'logos:nginx', sinif: 'top-[54%] right-[12%] hidden min-[1600px]:block' },
	{ ad: 'GitLab', ikon: 'logos:gitlab-icon', sinif: 'top-[18%] left-[25%] hidden min-[1600px]:block' },
	{ ad: 'PostgreSQL', ikon: 'logos:postgresql', sinif: 'top-[16%] right-[25%] hidden min-[1600px]:block' },
	{ ad: 'Cloudflare', ikon: 'logos:cloudflare-icon', sinif: 'bottom-[16%] left-[26%] hidden min-[1600px]:block' },
	{ ad: 'Swift', ikon: 'logos:swift', sinif: 'bottom-[18%] right-[26%] hidden min-[1600px]:block' },

	// --- 2100 ---
	{ ad: 'VS Code', ikon: 'logos:visual-studio-code', sinif: 'bottom-[4%] left-[44%] hidden min-[1600px]:block' },
	{ ad: 'MongoDB', ikon: 'logos:mongodb-icon', sinif: 'top-[70%] left-[6%] hidden min-[2100px]:block' },
	{ ad: 'Kotlin', ikon: 'logos:kotlin-icon', sinif: 'top-[72%] right-[6%] hidden min-[2100px]:block' },
	{ ad: 'Flutter', ikon: 'logos:flutter-icon', sinif: 'top-[5%] left-[20%] hidden min-[2100px]:block' },
	{ ad: 'GitHub Actions', ikon: 'logos:github-actions', sinif: 'top-[5%] right-[20%] hidden min-[2100px]:block' },
	{ ad: 'Terraform', ikon: 'logos:terraform-icon', sinif: 'bottom-[6%] left-[22%] hidden min-[2100px]:block' },
	{ ad: 'Ansible', ikon: 'logos:ansible', tersle: true, sinif: 'bottom-[7%] right-[22%] hidden min-[2100px]:block' },
	{ ad: 'Jenkins', ikon: 'logos:jenkins', sinif: 'top-[38%] left-[20%] hidden min-[2100px]:block' },
	{ ad: 'Bash', ikon: 'logos:bash-icon', sinif: 'top-[40%] right-[20%] hidden min-[2100px]:block' },
];
---

<section
	data-sayfa class="bolum relative -mt-16 flex h-[100lvh] w-full items-center justify-center overflow-hidden bg-background md:min-h-[700px]"
>
	{/* Renk katmanları: düşük opaklık, yüksek bulanıklık; metin kontrastını
	    düşürmeden zemine derinlik veriyor. */}
	<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
		{/*
		  Renk katmanları radyal gradyanla çiziliyor, filter: blur() ile değil.
		  Önceki hâlde 544-576 piksellik üç daireye 110-130 piksel Gauss
		  bulanıklığı uygulanıyordu; iOS'ta piksel oranı 3 olduğu için bu
		  ~1600 piksellik yüzeylere çok pahalı bir bulanıklık geçişi demekti
		  ve sayfa saniyelerce takılıyordu. Gradyan görsel olarak aynı yumuşak
		  geçişi veriyor ama bulanıklık geçişi hiç çalışmıyor.
		*/}
		<div class="hero-isik absolute inset-0"></div>
	</div>

	<div id="logo-kabi" class="absolute inset-0 h-full w-full">
		{
			ikonlar.map((veri, sira) => (
				<div
					class:list={['logo-yuva absolute', veri.sinif]}
					style={`--gecikme:${(sira % 8) * 15}ms; --sure:${5 + (sira % 4)}s; --kay-x:${KAY_X[sira % 8]}px; --kay-y:${KAY_Y[sira % 8]}px; --don:${DON[sira % 8]}deg`}
				>
					<span class="logo-balon" aria-hidden="true">{veri.ad}</span>
					<div class="logo-kart flex size-12 items-center justify-center rounded-xl border border-black/5 bg-white/95 p-2 shadow-lg md:size-14 dark:border-white/10 dark:bg-neutral-800/90">
						<Icon
							name={veri.ikon}
							class:list={['size-6 md:size-7', veri.tersle && 'dark:invert']}
						/>
						<span class="sr-only">{veri.ad}</span>
					</div>
				</div>
			))
		}
	</div>

	<div class="relative z-10 -translate-y-6 px-4 text-center md:-translate-y-10">
		<h1
			class="animate-parilti bg-gradient-to-r from-foreground/55 via-foreground to-foreground/55 bg-clip-text bg-[length:200%_100%] text-[clamp(2.25rem,4.2vw,4.75rem)] leading-[1.05] font-bold tracking-tight text-transparent motion-reduce:animate-none"
		>
			{baslik}
		</h1>
		<p class="mx-auto mt-6 max-w-[min(36rem,90vw)] text-[clamp(1rem,1.15vw,1.2rem)] text-muted-foreground">
			{altBaslik}
		</p>
		<div class="mt-10 flex flex-wrap items-center justify-center gap-3">
			<a
				href={birincilHedef}
				class="inline-flex items-center rounded-lg bg-primary px-8 py-4 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
			>
				{birincilMetin}
			</a>
			<a
				href={ikincilHedef}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center rounded-lg bg-slate-900 px-8 py-4 text-base font-semibold text-white transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current dark:bg-white dark:text-neutral-900 dark:hover:bg-white/85"
			>
				{ikincilMetin}
				<span class="sr-only"> (yeni sekmede açılır)</span>
			</a>
		</div>
	</div>
</section>

<style>
	/* Arka plandaki renk katmanları. Gradyan durakları yumuşak olduğu için
	   bulanıklık süzgecine gerek yok; maliyeti de yok. */
	/* Bölge bölge renk: beş ayrı, birbirine karışmayan leke. Yarıçaplar
	   küçültülüp duraklar sıkılaştırıldı ki her biri kendi bölgesi gibi
	   okunsun; buna karşılık opaklık düşürüldü, toplamda daha hafif.
	   Metnin üstünden geçen bölge yok — kontrast korunuyor. */
	.hero-isik {
		pointer-events: none;
		z-index: -10;
		background:
			radial-gradient(26rem 22rem at 12% 6%, oklch(0.62 0.18 250 / 0.22), transparent 58%),
			radial-gradient(22rem 20rem at 88% 14%, oklch(0.75 0.14 230 / 0.2), transparent 58%),
			radial-gradient(24rem 20rem at 74% 82%, oklch(0.68 0.16 275 / 0.19), transparent 58%),
			radial-gradient(20rem 18rem at 26% 88%, oklch(0.7 0.15 200 / 0.17), transparent 58%),
			radial-gradient(18rem 16rem at 52% 40%, oklch(0.72 0.12 260 / 0.1), transparent 62%);
	}

	:global(.dark) .hero-isik {
		background:
			radial-gradient(26rem 22rem at 12% 6%, oklch(0.62 0.18 250 / 0.3), transparent 58%),
			radial-gradient(22rem 20rem at 88% 14%, oklch(0.7 0.15 230 / 0.26), transparent 58%),
			radial-gradient(24rem 20rem at 74% 82%, oklch(0.62 0.17 275 / 0.25), transparent 58%),
			radial-gradient(20rem 18rem at 26% 88%, oklch(0.66 0.15 200 / 0.22), transparent 58%),
			radial-gradient(18rem 16rem at 52% 40%, oklch(0.66 0.12 260 / 0.14), transparent 62%);
	}

	/* Giriş ve sürekli yüzme animasyonları saf CSS. Her logo kendi gecikme ve
	   süresini satır içi değişkenlerden alıyor, böylece hareket tekdüze olmuyor. */
	/* Giriş süresi ve basamaklanması bilinçli olarak kısa: logolar sırası
	   gelene kadar görünmez (`both` + opacity 0). İlk sürümde son logolar
	   1370 ms'de tamamlanıyordu ve sayfa "geç yükleniyor" gibi görünüyordu;
	   şimdi en geç 405 ms'de hepsi yerinde. Basamaklanma korunuyor ama göz
	   onu gecikme olarak değil, akış olarak okuyor.
	   will-change kaldırıldı: süresiz çalışan bir animasyonu tarayıcı
	   zaten katmanlıyor, 35 öge için elle katman istemek boşuna bellek. */
	.logo-yuva {
		animation:
			logo-giris 300ms cubic-bezier(0.22, 1, 0.36, 1) both,
			logo-yuzme var(--sure, 7s) ease-in-out infinite alternate;
		animation-delay: var(--gecikme, 0ms), calc(var(--gecikme, 0ms) + 300ms);
	}

	@keyframes logo-giris {
		from {
			opacity: 0;
			scale: 0.5;
		}
		to {
			opacity: 1;
			scale: 1;
		}
	}

	@keyframes logo-yuzme {
		from {
			translate: 0 0;
			rotate: calc(var(--don, 5deg) * -1);
		}
		to {
			translate: var(--kay-x, 10px) var(--kay-y, -16px);
			rotate: var(--don, 5deg);
		}
	}

	/* İmleçten kaçma: betik yalnızca bu iki değişkeni yazıyor. */
	.logo-kart {
		translate: var(--kacis-x, 0) var(--kacis-y, 0);
		transition: translate 380ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* Ad balonu: JavaScript gerekmeden hover ve odakla açılıyor. */
	.logo-balon {
		position: absolute;
		bottom: calc(100% + 10px);
		left: 50%;
		translate: -50% 6px;
		z-index: 10;
		white-space: nowrap;
		border-radius: 0.5rem;
		background: var(--color-slate-900, #0f172a);
		padding: 0.375rem 0.625rem;
		font-size: 0.75rem;
		font-weight: 500;
		color: #fff;
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 160ms ease,
			translate 160ms ease;
	}

	:global(.dark) .logo-balon {
		background: #fff;
		color: var(--color-slate-900, #0f172a);
	}

	.logo-yuva:hover .logo-balon,
	.logo-yuva:focus-within .logo-balon {
		opacity: 1;
		translate: -50% 0;
	}

	.logo-yuva:hover {
		z-index: 20;
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-yuva {
			animation: none;
			opacity: 1;
		}
		.logo-kart {
			transition: none;
		}
	}
</style>

<script>
	// İmleçten kaçma. Konumlar önbellekte; her fare hareketinde yeniden yerleşim
	// tetiklenmiyor.
	const kap = document.getElementById('logo-kabi');
	if (kap) {
		const ETKI = 170;
		const GUC = 75;
		const kartlar = [...kap.querySelectorAll<HTMLElement>('.logo-kart')];
		let merkezler: { x: number; y: number }[] = [];

		const olc = () => {
			merkezler = kartlar.map((kart) => {
				const r = kart.getBoundingClientRect();
				return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
			});
		};

		olc();
		window.setTimeout(olc, 1400);
		window.addEventListener('resize', olc, { passive: true });
		window.addEventListener('scroll', olc, { passive: true });

		const sifirla = () => {
			for (const kart of kartlar) {
				kart.style.setProperty('--kacis-x', '0px');
				kart.style.setProperty('--kacis-y', '0px');
			}
		};

		window.addEventListener(
			'mousemove',
			(olay) => {
				/*
				  Mobil menü açıkken kaçma etkisi kapalı. Dokunmatikte tarayıcı,
				  bir ögeye dokunulduğunda tıklamadan önce sentetik bir mousemove
				  üretiyor; bu betik onu gerçek imleç sanıp menünün arkasındaki
				  ikonları itiyordu. Menüdeki bir seçeneğe dokunmak arka plandaki
				  ikonları oynatmamalı.
				*/
				if (document.documentElement.classList.contains('menu-acik')) {
					sifirla();
					return;
				}

				for (let i = 0; i < kartlar.length; i++) {
					const m = merkezler[i];
					if (!m) continue;
					const dx = olay.clientX - m.x;
					const dy = olay.clientY - m.y;
					const uzaklik = Math.hypot(dx, dy);
					if (uzaklik < ETKI) {
						const aci = Math.atan2(dy, dx);
						const kuvvet = (1 - uzaklik / ETKI) * GUC;
						kartlar[i].style.setProperty('--kacis-x', `${-Math.cos(aci) * kuvvet}px`);
						kartlar[i].style.setProperty('--kacis-y', `${-Math.sin(aci) * kuvvet}px`);
					} else {
						kartlar[i].style.setProperty('--kacis-x', '0px');
						kartlar[i].style.setProperty('--kacis-y', '0px');
					}
				}
			},
			{ passive: true },
		);
	}
</script>
