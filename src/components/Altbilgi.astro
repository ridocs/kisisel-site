---
import { Icon } from 'astro-icon/components';
import { cevirici, dilBul, taban, yol } from '@/i18n/ceviriler';
import { EPOSTA, KONUM, SOSYAL, TELEFON_GORUNEN, WHATSAPP } from '@/lib/iletisim';
import { surumBul } from '@/lib/surum';

const dil = dilBul(Astro.url);
const m = cevirici(dil);
/*
  DİL DEĞİŞTİRİCİ BURADA YOK (2026-09-20'de kaldırıldı).

  Aynı düğme üst çubukta da duruyordu; sayfa başında ve sonunda iki ayrı
  yerde aynı işi yapıyordu. Üst çubuktaki her sayfada, kaydırırken de
  görünür durumda — altbilgiye inmek gerekmiyor. Yeniden eklenecekse
  ikisinden biri seçilsin, ikisi birden değil.
*/
interface Props {
	/**
	 * Altbilgi kendi ekranını alsın mı.
	 *
	 * Ana sayfa bölüm bölüm kaydırılıyor ve altbilgi son bölümün kuyruğuna
	 * iliştiğinde iletişim kartıyla aynı ekranı paylaşıyor, ikisi de yarım
	 * kalıyordu. Açıkken altbilgi `data-sayfa` listesine giriyor: kaydırmanın
	 * son durağı oluyor ve ekranın tamamını kullanıyor.
	 *
	 * Yazı ve iç sayfalarda KAPALI. Uzun bir metnin altında ekran boyu bir
	 * altbilgi, okuma bittikten sonra bir ekran daha kaydırmak demekti.
	 */
	sayfa?: boolean;
}

const { sayfa = false } = Astro.props;

const baglantilar = [
	{ etiket: m('nav.anasayfa'), yol: yol(dil, '') },
	{ etiket: m('nav.hizmetler'), yol: yol(dil, dil === 'en' ? 'services' : 'hizmetler') },
	{
		etiket: m('nav.projeler'),
		yol: yol(dil, dil === 'en' ? 'projects' : 'projeler'),
	},
	{ etiket: m('nav.blog'), yol: yol(dil, 'blog') },
	{ etiket: m('nav.hakkimda'), yol: yol(dil, dil === 'en' ? 'about' : 'hakkimda') },
	{ etiket: m('nav.kullandiklarim'), yol: yol(dil, dil === 'en' ? 'uses' : 'kullandiklarim') },
	/*
	  Son iki kalem künye niteliğinde: üst gezinmede yer almıyorlar, tek girişleri
	  burası. Sıra "önce okunacak sayfalar, sonra sitenin kendisi hakkındakiler".
	*/
	{
		etiket: m('nav.nelerDegisti'),
		yol: yol(dil, dil === 'en' ? 'whats-changed' : 'neler-degisti'),
	},
	{ etiket: m('nav.gizlilik'), yol: yol(dil, dil === 'en' ? 'privacy' : 'gizlilik') },
];

/*
  RSS burada `yol()` ile kurulmuyor. O yardımcı SAYFA adresleri için: sonuna
  eğik çizgi ekliyor ve `/rss.xml/` 404 veriyordu — akış bir sayfa değil, dosya.
  Üst çubuk ve `<head>` içindeki akış bağlantısı zaten `taban` ile kuruluyor,
  burası onlardan ayrı düşmüştü.

  GitHub adresi de elle yazılıydı; `iletisim.ts` içindeki tek kaynaktan
  alınıyor. İki yerde durursa biri güncellenip diğeri unutuluyor.
*/
/*
  Sosyal profiller de burada olmak ZORUNDA. Sağ kenardaki ray 1024 pikselin
  altında hiç basılmıyor (dar ekranda içeriğin üstüne biniyordu), dolayısıyla
  telefonda tek erişim yolu altbilgi. Ray yalnızca GitHub'ı yinelediği sürece
  LinkedIn ve Instagram mobilde hiçbir yerden ulaşılamıyordu.

  Adresler yine `SOSYAL` nesnesinden; boş olan satır basılmıyor.

  RSS en sonda: o bir profil değil, akış aboneliği.
*/
const disBaglantilar = [
	{ etiket: 'GitHub', adres: SOSYAL.github, ikon: 'lucide:github' },
	{ etiket: 'LinkedIn', adres: SOSYAL.linkedin, ikon: 'lucide:linkedin' },
	{ etiket: 'Instagram', adres: SOSYAL.instagram, ikon: 'lucide:instagram' },
	{ etiket: m('nav.rss'), adres: dil === 'en' ? `${taban}/en/rss.xml` : `${taban}/rss.xml`, ikon: 'lucide:rss' },
].filter((b) => b.adres);

/*
  Derleme zamanı. Site statik olduğu için bu değer sayfanın üretildiği andır —
  "ne zaman güncellendi" sorusunun dürüst cevabı. Çalışma anında hesaplansaydı
  ziyaretçinin saatini gösterirdi ve hiçbir şey anlatmazdı.
*/
const derlemeZamani = new Date();
const derlemeEtiketi = derlemeZamani.toISOString().slice(0, 10);
const yil = derlemeZamani.getFullYear();

/*
  Yayındaki sürüm. Derleme tarihi "ne zaman" sorusunu, kısa commit kimliği
  "hangi kaynaktan" sorusunu cevaplıyor; ikisi bir arada "şu an yayında olan
  sürüm hangisi" sorusunu kapatıyor.

  `null` olabilir: git bulunamayan bir derlemede (yayın yordamının kopyası gibi)
  satır eskisi gibi, kimliksiz basılıyor. Sürüm bilgisi olmadığı için altbilgi
  bozulmuyor — bkz. `src/lib/surum.ts`.

  Kimlik aynı zamanda sürüm günlüğünün bağlantısı: "hangi sürüm" ile "o sürümde
  ne değişti" birbirinin devamı, ayrı iki yere konmaları gerekmiyor. Altbilgi
  gezinme listesine yeni bir satır eklenmedi; oradaki hizalama uzun uğraşla
  ayarlandı ve tek satır bile sütun yüksekliğini kaydırıyor.
*/
const surum = surumBul();
const gunlukYolu = yol(dil, dil === 'en' ? 'whats-changed' : 'neler-degisti');

/*
  İLETİŞİM SÜTUNU.

  Altbilgi eskiden yalnızca gezinme ve profillerden ibaretti; adresi öğrenmek
  için ana sayfanın iletişim kartına dönmek gerekiyordu. İç sayfalarda o kart
  hiç yok, dolayısıyla bir yazıyı okuyan kişinin ulaşabileceği tek adres
  altbilgideydi ve orada da yazmıyordu.

  Değerler `lib/iletisim.ts` içindeki tek kaynaktan; burada ikinci bir kopya
  tutulmuyor. WhatsApp boşsa satır hiç basılmıyor — iletişim kartındaki kural
  ile aynı.
*/
const iletisimKalemleri = [
	{ etiket: EPOSTA, adres: `mailto:${EPOSTA}`, ikon: 'lucide:mail' },
	WHATSAPP
		? { etiket: TELEFON_GORUNEN, adres: `https://wa.me/${WHATSAPP}`, ikon: 'lucide:message-circle' }
		: null,
].filter((k) => k !== null);
---

<footer class:list={['altbilgi', sayfa && 'altbilgi-sayfa']} data-sayfa={sayfa ? true : undefined}>
	<div class="mx-auto w-full max-w-3xl px-4 lg:max-w-4xl">
		<div class="ust">
			{/*
			  Uçbirim bloğu: sitenin ne olduğunu yazılımcı diliyle söylüyor.
			  Süs değil, taklit de değil — gerçek bir komut çıktısı gibi okunan
			  üç satır. Tamamı metin, ekran okuyucu da aynı şeyi okuyor.
			*/}
			<div class="ucbirim">
				<div class="ucbirim-cubuk" aria-hidden="true">
					<span class="lamba lamba-a"></span>
					<span class="lamba lamba-b"></span>
					<span class="lamba lamba-c"></span>
					<span class="ucbirim-ad">~/mustafa-eybek</span>
				</div>
				<pre class="ucbirim-govde"><code><span class="istem">$</span> whoami
<span class="cikti">{m('altbilgi.tanim')}</span>

<span class="istem">$</span> stack --list
<span class="cikti">astro · typescript · tailwind · postgres · docker</span>

<span class="istem">$</span> cat build.txt
<span class="cikti">{derlemeEtiketi} · {surum && <><a class="surum" href={gunlukYolu} aria-label={`${surum.kimlik} — ${m('nav.nelerDegisti')}`}>{surum.kimlik}</a>{' · '}</>}{m('altbilgi.sifirJs')}</span></code></pre>
			</div>

			<div class="yan-sutun">
				<nav aria-label={m('altbilgi.gezinme')}>
					<p class="baslik">{m('altbilgi.gezinmeBaslik')}</p>
					<ul class="baglantilar">
						{
							baglantilar.map((b) => (
								<li>
									<a href={b.yol}>
										<span class="ok" aria-hidden="true">
											&rsaquo;
										</span>
										<span>{b.etiket}</span>
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				{/*
				  Profiller artık etiketleriyle birlikte. Yalnızca ikon basan
				  eski hâlinde hangi kutucuğun hangi ağ olduğu ikonu tanımaya
				  bağlıydı ve dört küçük kare altbilginin sağ üstünde adsız bir
				  küme gibi duruyordu; adı yazınca sütun hem okunur oldu hem de
				  yanındaki gezinme listesiyle aynı ritmi tutturdu.
				*/}
				<div>
					<p class="baslik">{m('altbilgi.baglantiBaslik')}</p>
					<ul class="baglantilar">
						{
							disBaglantilar.map((b) => (
								<li>
									<a
										href={b.adres}
										{...(b.adres.startsWith('http') ? { rel: 'noopener' } : {})}
									>
										<Icon name={b.ikon} class="size-[15px] dis-ikon" />
										<span>{b.etiket}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>

				<div>
					<p class="baslik">{m('iletisim.ustBaslik')}</p>
					<ul class="baglantilar">
						{
							iletisimKalemleri.map((k) => (
								<li>
									<a
										href={k.adres}
										{...(k.adres.startsWith('http') ? { rel: 'noopener' } : {})}
									>
										<Icon name={k.ikon} class="size-[15px] dis-ikon" />
										<span>{k.etiket}</span>
									</a>
								</li>
							))
						}
						{/* Konum bir bağlantı değil: tıklanacak bir yeri yok. */}
						<li class="duz">
							<Icon name="lucide:map-pin" class="size-[15px] dis-ikon" />
							<span>{KONUM[dil]}</span>
						</li>
					</ul>
				</div>
			</div>
		</div>

		<div class="alt">
			<p><span class="kod">&copy; {yil}</span> Mustafa Eybek</p>
			{/*
			  Sürüm burada İKİNCİ kez görünüyor; terminal bloğundaki satırda da
			  var. Orası sitenin künyesi gibi okunuyor ve göz oraya her zaman
			  gitmiyor; alt şerit ise altbilginin en çok bakılan yeri. Tekrar
			  bilinçli.

			  Sürüm yoksa (derleme deposuz bir yerde yapıldıysa) satır hiç
			  basılmıyor — boş bir ayraç bırakmaktansa yokluğu belli olsun.
			*/}
			{surum && (
				<p class="kod surum-alt">
					<a href={gunlukYolu}>{m('altbilgi.surum')} {surum.kimlik}</a>
					<span class="ayrac" aria-hidden="true">·</span>
					{surum.tarih}
				</p>
			)}
			<p class="kod lisans">{m('altbilgi.lisans')}</p>
		</div>
	</div>
</footer>

<style>
	.altbilgi {
		/* Sayfa kısaysa altbilgi ortada asılı kalmasın: gövde sütun düzeninde
		   ve bu `auto` pay onu görünüm alanının dibine itiyor. */
		margin-top: auto;
		border-top: 1px solid var(--border);
		padding-block: 2.5rem 2rem;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}

	/*
	  ALTBİLGİ KENDİ EKRANINDA (yalnızca ana sayfa).

	  `data-sayfa` ile kaydırmanın son durağı olduğu için ekranın tamamını
	  kaplıyor ve içerik dikeyde ortalanıyor; yarım görünen bir altbilgiyle
	  biten sayfa yerine kapanışı olan bir sayfa çıkıyor.

	  Yükseklik telefonda da zorlanıyor: altbilgi `data-sayfa` listesinde
	  olduğu için dokunmatik kaydırma da onu bir durak sayıyor, yarım ekranlık
	  bir durak ise geçişi yarıda kesilmiş gösterirdi. `min-height` olduğundan
	  içerik ekrandan uzunsa blok esniyor ve kaydırma sistemi o durumda zaten
	  bölümü olağan biçimde kaydırtıyor.
	*/
	.altbilgi-sayfa {
		margin-top: 0;
		display: flex;
		align-items: center;
		min-height: 100svh;
		padding-block: 3rem;
	}

	.altbilgi-sayfa > div {
		width: 100%;
	}

	@media (min-width: 768px) {
		.altbilgi-sayfa {
			padding-block: 4rem;
		}

		/*
		  Tam ekranda bloklar yan yana değil, alt alta.

		  Yan yana dizildiklerinde üç sütun genişliğin çoğunu alıyor ve
		  uçbirim bloğuna dar bir şerit kalıyordu: içindeki komut satırları
		  sarıyor, bir uçbirim penceresi gibi okunmayı bırakıyordu. Ekranın
		  tamamı zaten elimizdeyken sıkıştırmanın bir sebebi yok — uçbirim
		  üstte tam genişlikte duruyor, sütunlar altında yayılıyor.
		*/
		.altbilgi-sayfa .ust {
			flex-direction: column;
			align-items: stretch;
			gap: 3.5rem;
		}

		/* Sütunlar artık uçbirimle genişlik yarışmıyor, o yüzden yan yana
		   düzenin genişlik sınırı burada geçerli değil: üçü satırın tamamına
		   yayılıyor. */
		.altbilgi-sayfa .yan-sutun {
			min-width: 0;
			max-width: none;
		}

		.altbilgi-sayfa .alt {
			margin-top: 3rem;
		}
	}

	.ust {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	/* --- Uçbirim bloğu --- */
	.ucbirim {
		border: 1px solid var(--border);
		border-radius: 0.875rem;
		overflow: hidden;
		background: color-mix(in oklab, var(--foreground) 3%, transparent);
		flex: 1 1 auto;
		min-width: 0;
	}

	.ucbirim-cubuk {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.55rem 0.75rem;
		border-bottom: 1px solid var(--border);
		background: color-mix(in oklab, var(--foreground) 4%, transparent);
	}

	.lamba {
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 9999px;
		flex: none;
	}

	/* macOS pencere düğmelerinin kendi renkleri. Doygunluk biraz kısık:
	   tam parlak hâlleri tek renkli bir altbilgide gözü kendine çekiyor,
	   oysa bunlar başlık çubuğunun süsü. */
	.lamba-a {
		background: oklch(0.68 0.18 25);
	}

	.lamba-b {
		background: oklch(0.79 0.15 80);
	}

	.lamba-c {
		background: oklch(0.74 0.17 145);
	}

	.ucbirim-ad {
		margin-inline-start: 0.4rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		color: var(--muted-foreground);
	}

	/*
	  `white-space: pre-wrap`: satır sonları korunuyor ama uzun satırlar dar
	  ekranda sarıyor. Düz `pre` olsaydı telefonda yatay kaydırma açardı.
	*/
	.ucbirim-govde {
		margin: 0;
		padding: 0.875rem 0.75rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.8125rem;
		line-height: 1.7;
		white-space: pre-wrap;
		word-break: break-word;
		overflow-wrap: anywhere;
	}

	.istem {
		color: color-mix(in oklab, var(--color-marka-500) 85%, var(--foreground));
		font-weight: 700;
		user-select: none;
	}

	.cikti {
		color: var(--foreground);
	}

	/*
	  Sürüm kimliği bir bağlantı ama uçbirim çıktısının parçası gibi duruyor:
	  alt çizgisi noktalı ve soluk. Düz mavi bir bağlantı, komut çıktısını taklit
	  eden bu bloğun içinde yamalı görünüyordu.
	*/
	.surum {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px dotted color-mix(in oklab, var(--foreground) 35%, transparent);
		transition: color 200ms ease-out;
	}

	.surum:hover {
		color: color-mix(in oklab, var(--color-marka-500) 85%, var(--foreground));
		border-bottom-color: currentColor;
	}

	.surum:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
		border-radius: 2px;
	}

	/*
	  Yan sütun: Sayfalar ve Bağlantılar HER GENİŞLİKTE yan yana.
	  Alt alta dururken altbilgi gereksiz uzuyor ve iki kısa liste tek bir
	  sütuna dizilince yan taraf boş kalıyordu.

	  Dar ekranda aralık daralıyor ama sütunlar bölünmüyor: ikisi birlikte
	  320 pikselde bile satıra sığıyor (ölçüldü). `auto auto` yerine
	  `max-content auto` kullanılıyor — Sayfalar sütunu kendi metnine göre
	  daralsın, kalan yeri düğmeler alsın.
	*/
	/*
	  Üç sütun: Sayfalar, Bağlantılar, İletişim.

	  İki sütunken ikisi kendi kenarlarına yaslanıyor, aradaki boşluk
	  esniyordu — sağdaki sütunun metni de bu yüzden sağa hizalıydı. Üçüncü
	  sütun gelince o düzen tutmuyor: ortadaki sütunun hizası belirsiz
	  kalıyor. Artık üçü de eşit genişlikte ve hepsi baştan hizalı, listeler
	  aynı çizgiden başlıyor.
	*/
	.yan-sutun {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		align-items: start;
		flex: none;
	}

	@media (min-width: 480px) {
		.yan-sutun {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2rem;
		}
	}

	.baslik {
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted-foreground);
		margin-bottom: 0.625rem;
	}

	.baglantilar {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.15rem;
		justify-items: start;
	}

	.baglantilar a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2rem;
		color: inherit;
		text-decoration: none;
		transition: color 200ms ease-out;
	}

	/* Konum satırının tıklanacak yeri yok; listedeki bağlantılarla aynı
	   ölçüde duruyor ki sütun hizası kaymasın. */
	.baglantilar .duz {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2rem;
	}

	/* Profil ve iletişim ikonları, gezinme listesindeki okla aynı vurgu
	   renginde: üç sütun tek bir işaret diliyle okunuyor. */
	.dis-ikon {
		color: color-mix(in oklab, var(--color-marka-500) 85%, var(--foreground));
		flex: none;
	}

	/* Ok imleç gelince içeri kayıyor: bağlantının canlandığını alt çizgi
	   eklemeden söylüyor, altbilgi sade kalıyor. */
	.ok {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		color: color-mix(in oklab, var(--color-marka-500) 85%, var(--foreground));
		transition: translate 200ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.baglantilar a:hover {
		color: var(--foreground);
	}

	.baglantilar a:hover .ok {
		translate: 3px 0;
	}

	/* Dokunma hedefi 40 piksel: WCAG 2.2 web için 24 istiyor, dokunmatikte
	   bu aralık isabet hatasını belirgin azaltıyor. */
	.simge {
		display: grid;
		place-items: center;
		min-width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.625rem;
		border: 1px solid var(--border);
		color: inherit;
		text-decoration: none;
		transition:
			background-color 200ms ease-out,
			color 200ms ease-out;
	}

	.simge:hover {
		background: color-mix(in oklab, var(--foreground) 6%, transparent);
		color: var(--foreground);
	}

	.simge:focus-visible,
	.baglantilar a:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}

	/* --- Alt satır --- */
	.alt {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		justify-content: space-between;
		margin-top: 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
		font-size: 0.8125rem;
	}

	/*
	  Dar ekran: tek sütun ve ortalı. Sarmalanan iki metin sola yaslı durunca
	  altbilgi eğri bitiyordu.

	  Lisans cümlesi mobilde hiç basılmıyor. `display: none` yerine bileşeni
	  koşullu render etmek gerekmiyor — metin zaten süs değil ama telefonda
	  ekranın son satırını dolduracak kadar önemli de değil; masaüstünde
