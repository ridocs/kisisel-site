---
/**
 * Akan düğme.
 *
 * Üzerine gelince ortadaki daire büyüyüp düğmeyi dolduruyor, köşeler
 * yuvarlaktan köşeliye geçiyor, yazı sağa kayıyor ve iki simge yer
 * değiştiriyor: soldaki kadrajın dışından içeri giriyor, sağdaki dışarı
 * çıkıyor.
 *
 * İki simge de seçilebilir. Varsayılan ikisinde de sağ ok — "git" anlamı.
 * Ama simgeler ayrılabildiği için düğme iki şey birden anlatabiliyor:
 * durağan hâlde NE YAPACAĞIN (yazmak), üzerine gelince NEREDE olacağı
 * (WhatsApp, posta kutusu). Hizmetler kapanışındaki iki düğme bunu kullanıyor.
 *
 * Önce yalnızca 404 sayfasında duruyordu; hero de aynı düğmeyi isteyince
 * stil kopyalanmak yerine buraya taşındı. İki yerde duran bir animasyon
 * kaçınılmaz olarak birbirinden ayrı düşerdi.
 *
 * Tamamı CSS — tarayıcıya betik inmiyor.
 */
import { Icon } from 'astro-icon/components';

interface Props {
	/** Bağlantı hedefi. */
	href: string;
	/**
	 * Görsel ağırlık.
	 *
	 * `hatli` (varsayılan): saydam zemin, ince kenarlık. İkincil eylemler.
	 * `dolu`: zemin dolu, yazı ters renkte. Sayfadaki BİR eylem için —
	 * ikisini de dolu yapmak hangisinin asıl eylem olduğunu siliyor.
	 */
	agirlik?: 'hatli' | 'dolu';
	/**
	 * Renk ailesi.
	 *
	 * `notr` (varsayılan): metin rengi — sayfanın geri kalanıyla aynı dil.
	 * `marka`: site mavisi. Sayfadaki tek bir eylemi öne çıkarmak için;
	 * her düğme mavi olursa hiçbiri öne çıkmıyor.
	 */
	ton?: 'notr' | 'marka';
	/**
	 * Durağan hâlde sağda duran simge (astro-icon adı).
	 * Kullanıcı düğmeye basmadan önce gördüğü şey.
	 */
	simge?: string;
	/**
	 * Üzerine gelince soldan giren simge.
	 * Verilmezse durağan simgenin aynısı kullanılıyor.
	 */
	simgeUzerinde?: string;
	/** Yeni sekmede açılacaksa; `rel` ve ekran okuyucu notu buna bağlı. */
	disBaglanti?: boolean;
	/** Ekran okuyucuya "yeni sekmede açılır" bilgisini veren çeviri metni. */
	yeniSekmeMetni?: string;
	/** Ek sınıflar (yerleşim için). */
	class?: string;
	/*
	  Kalan her öznitelik olduğu gibi bağlantıya geçiyor. Buna ihtiyaç var
	  çünkü düğmeler farklı bağlamlarda ek bilgi taşıyor: belirme
	  animasyonunun `data-belir-oge` ve `--sira` değerleri, bağlam ekleyen
	  bir `aria-label`, bazen bir `id`. Hepsi için ayrı prop açmak yerine
	  geçirgen bırakıldı.
	*/
	[key: string]: unknown;
}

const {
	href,
	agirlik = 'hatli',
	ton = 'notr',
	simge = 'lucide:arrow-right',
	simgeUzerinde,
	disBaglanti = false,
	yeniSekmeMetni,
	class: ekSinif,
	...kalanOzellikler
} = Astro.props;

const disOzellikler = disBaglanti
	? { target: '_blank', rel: 'noopener noreferrer' }
	: {};

/* Tek simge verildiyse iki tarafta da o duruyor: eski davranış bozulmasın. */
const girenSimge = simgeUzerinde ?? simge;
---

<a
	class:list={[
		'akan-dugme',
		agirlik === 'dolu' && 'dolu',
		ton === 'marka' && 'marka',
		ekSinif,
	]}
	href={href}
	{...disOzellikler}
	{...kalanOzellikler}
>
	{/* Soldaki simge normalde kadrajın dışında; üzerine gelince içeri kayıyor. */}
	<Icon name={girenSimge} class="simge simge-sol" aria-hidden="true" />
	<span class="etiket"><slot /></span>
	<span class="daire" aria-hidden="true"></span>
	<Icon name={simge} class="simge simge-sag" aria-hidden="true" />
	{disBaglanti && yeniSekmeMetni && <span class="sr-only"> {yeniSekmeMetni}</span>}
</a>

<style>
	/*
	  Özgün FlowButton'ın davranışı. Ölçüler ve süreler 404 sayfasındaki ilk
	  uygulamadan geliyor; oradan taşındı.
	*/
	.akan-dugme {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		overflow: hidden;
		border-radius: 100px;
		border: 1.5px solid color-mix(in oklab, var(--foreground) 40%, transparent);
		padding: 0.75rem 2rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--foreground);
		text-decoration: none;
		isolation: isolate;
		transition:
			border-color 600ms cubic-bezier(0.23, 1, 0.32, 1),
			background-color 600ms cubic-bezier(0.23, 1, 0.32, 1),
			color 600ms cubic-bezier(0.23, 1, 0.32, 1),
			border-radius 600ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	/*
	  DOLU VARYANT — sayfadaki asıl eylem.

	  Zemin baştan dolu; üzerine gelindiğinde açılan daire ile YER DEĞİŞTİRİYOR
	  (daire zemin renginde, yazı koyuya dönüyor). Böylece animasyon hatlı
	  varyantla birebir aynı hareketi yapıyor ama düğme durağan hâlinde de
	  ağırlığını koruyor.
	*/
	.dolu {
		background: var(--foreground);
		border-color: var(--foreground);
		color: var(--background);
	}

	.akan-dugme:hover,
	.akan-dugme:focus-visible {
		border-color: transparent;
		border-radius: 12px;
		color: var(--background);
	}

	.dolu:hover,
	.dolu:focus-visible {
		color: var(--foreground);
	}

	.akan-dugme:active {
		transform: scale(0.95);
	}

	.akan-dugme:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}

	.etiket {
		position: relative;
		z-index: 1;
		transform: translateX(-0.75rem);
		transition: transform 800ms ease-out;
	}

	.akan-dugme:hover .etiket,
	.akan-dugme:focus-visible .etiket {
		transform: translateX(0.75rem);
	}

	.daire {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 1rem;
		height: 1rem;
		translate: -50% -50%;
		border-radius: 50%;
		background: var(--foreground);
		opacity: 0;
		transition:
			width 800ms cubic-bezier(0.19, 1, 0.22, 1),
			height 800ms cubic-bezier(0.19, 1, 0.22, 1),
			opacity 800ms cubic-bezier(0.19, 1, 0.22, 1);
	}

	/* Dolu varyantta daire zemin renginde: dolu düğmenin içinde açılan açık
	   bir alan, hatlı varyantın tam tersi. */
	.dolu .daire {
		background: var(--background);
	}

	.akan-dugme:hover .daire,
	.akan-dugme:focus-visible .daire {
		width: 220px;
		height: 220px;
		opacity: 1;
	}

	.simge {
		position: absolute;
		z-index: 9;
		width: 1rem;
		height: 1rem;
		color: var(--foreground);
		transition:
			left 800ms cubic-bezier(0.34, 1.56, 0.64, 1),
			right 800ms cubic-bezier(0.34, 1.56, 0.64, 1),
			color 800ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.dolu .simge {
		color: var(--background);
	}

	.simge-sol {
		left: -25%;
	}

	.simge-sag {
		right: 1rem;
	}

	.akan-dugme:hover .simge-sol,
	.akan-dugme:focus-visible .simge-sol {
		left: 1rem;
		color: var(--background);
	}

	.akan-dugme:hover .simge-sag,
	.akan-dugme:focus-visible .simge-sag {
		right: -25%;
		color: var(--background);
	}

	.dolu:hover .simge-sol,
	.dolu:focus-visible .simge-sol,
	.dolu:hover .simge-sag,
	.dolu:focus-visible .simge-sag {
		color: var(--foreground);
	}

	/* ------------------------------------------------------------------ *
	 * MARKA TONU
	 *
	 * Nötr metin rengi yerine site mavisi. Hareket birebir aynı; yalnızca
	 * iki renk değişiyor: zemin `--primary`, üzerindeki her şey
	 * `--primary-foreground`. Açık/koyu temada ikisi birlikte dönüyor,
	 * dolayısıyla kontrast iki temada da korunuyor.
	 *
	 * Bu kurallar nötr olanlardan SONRA geliyor: eşit özgüllükteki
	 * `:hover` kurallarını sıra belirliyor.
	 * ------------------------------------------------------------------ */
	.marka {
		border-color: color-mix(in oklab, var(--primary) 55%, transparent);
		color: var(--primary);
	}

	/*
	  Kenarlık üzerine gelindiğinde de duruyor — nötr varyanttan bilerek
	  farklı. Açılan daire `--primary-foreground` renginde, yani sayfa
	  zeminine çok yakın; kenarlık da kalksaydı düğme fare üzerine gelince
	  zeminde eriyip kaybolurdu. Ölçüldü: koyu temada ikisi neredeyse aynı
	  renk çıkıyor.
	*/
	.marka.dolu {
		background: var(--primary);
		border-color: var(--primary);
		color: var(--primary-foreground);
	}

	.marka .daire {
		background: var(--primary);
	}

	.marka.dolu .daire {
		background: var(--primary-foreground);
	}

	.marka:hover,
	.marka:focus-visible {
		color: var(--primary-foreground);
	}

	.marka.dolu:hover,
	.marka.dolu:focus-visible {
		color: var(--primary);
	}

	.marka .simge {
		color: var(--primary);
	}

	.marka.dolu .simge {
		color: var(--primary-foreground);
	}

	.marka:hover .simge-sol,
	.marka:focus-visible .simge-sol,
	.marka:hover .simge-sag,
	.marka:focus-visible .simge-sag {
		color: var(--primary-foreground);
	}

	.marka.dolu:hover .simge-sol,
	.marka.dolu:focus-visible .simge-sol,
	.marka.dolu:hover .simge-sag,
	.marka.dolu:focus-visible .simge-sag {
		color: var(--primary);
	}

	/*
	  Hareketi azaltılmış tercihte geçişler kapalı; düğme yine de durumunu
	  gösteriyor (daire anında beliriyor), yalnızca yol alması kalkıyor.
	*/
	@media (prefers-reduced-motion: reduce) {
		.akan-dugme,
		.etiket,
		.daire,
		.simge {
			transition: none;
		}

		.akan-dugme:active {
			transform: none;
		}
	}
</style>
