---
import YaziKarti from './YaziKarti.astro';
import { cevirici, dilBul, yol } from '@/i18n/ceviriler';

interface Props {
	/** Gösterilecek yazılar; sayfa `getCollection` ile süzüp sıralayıp veriyor. */
	yazilar: {
		id: string;
		body?: string;
		data: {
			title: string;
			description: string;
			pubDate: Date;
			tags?: string[];
			kapak?: string;
			kapakAlt?: string;
		};
	}[];
}

const { yazilar } = Astro.props;

const dil = dilBul(Astro.url);
const m = cevirici(dil);
---

{/*
  Yazılar.

  Kapak görselli kart ızgarası. Yetkinlikler'in logo döşemesinden ve
  Çalışmalar'ın numaralı ince satırlarından ayrışıyor: buradaki kartların
  ağırlık merkezi görsel.

  Sütunlar `auto-fit` ile daralıyor, sabit üç sütun değil — tek yazı varken
  sabit ızgara iki boş göz bırakıyordu.
*/}
<section
	class="yazi relative overflow-hidden py-16 sm:py-20 md:flex md:min-h-[100svh] md:items-center md:py-12"
	data-belir
	data-parcali
	data-sayfa
>
	<div class="mx-auto w-full max-w-3xl px-4 lg:max-w-4xl">
		<div class="ust">
			<div>
				<p
					class="text-xs font-semibold tracking-[0.22em] text-muted-foreground"
					data-belir-oge
					style="--sira: 0"
				>
					{m('yazi.ustBaslik')}
				</p>
				<h2
					class="baslik mt-3 font-bold tracking-tight text-foreground"
					data-belir-oge
					style="--sira: 1"
				>
					{m('anasayfa.sonYazilar')}
				</h2>
			</div>

			{/* Dar ekranda başlığın altına iniyor; yanında durunca sıkışıyordu. */}
			<a class="tumu" href={yol(dil, 'blog')} data-belir-oge style="--sira: 2">
				<span>{m('anasayfa.tumYazilar')}</span>
			</a>
		</div>

		{
			yazilar.length === 0 ? (
				/* Dürüst boş durum: uydurma bir yazı listesi göstermektense
				   bölümün neden boş olduğunu söylemek doğru. */
				<p class="bos" data-belir-oge style="--sira: 3">
					{m('yazi.bos')}
				</p>
			) : (
				<ul class="izgara">
					{yazilar.map((y, sira) => (
						<li data-belir-oge style={`--sira: ${3 + sira}`}>
							<YaziKarti yazi={y} />
						</li>
					))}
				</ul>
			)
		}
	</div>
</section>

<style>
	/* Diğer bölüm başlıklarıyla aynı ölçek; clamp içindeki rem bileşeni zoom
	   altında ölçeğin büyümesini sağlıyor (WCAG 1.4.4). */
	.baslik {
		font-size: clamp(1.5rem, 1.1rem + 1.6vh, 2.125rem);
		line-height: 1.2;
	}

	.ust {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.tumu {
		display: inline-flex;
		align-items: center;
		align-self: flex-start;
		gap: 0.4rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--foreground);
		text-decoration: none;
		border-bottom: 1px solid color-mix(in oklab, var(--foreground) 30%, transparent);
		padding-bottom: 0.15rem;
		transition: border-color 200ms ease-out;
	}

	.tumu:hover {
		border-bottom-color: var(--foreground);
	}

	.tumu:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 3px;
	}

	/* Referanstaki gibi kart ızgarası. Tek yazıyla da boş satır bırakmasın
	   diye sütunlar `auto-fit` ile daralıyor: iki yazı varsa iki sütun,
	   bir yazı varsa tek ve tam genişlik yerine sınırlı bir kart. */
	.izgara {
		list-style: none;
		padding: 0;
		margin: 2rem 0 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
	}










	.bos {
		margin-top: 2rem;
		padding: 1.5rem;
		border: 1px dashed var(--border);
		border-radius: 1rem;
		color: var(--muted-foreground);
	}

	/* Geniş ekranda "tüm yazılar" başlığın karşısına geçiyor. */
	@media (min-width: 640px) {
		.ust {
			flex-direction: row;
			align-items: flex-end;
			justify-content: space-between;
		}
	}

	@media (min-width: 1024px) {
		.izgara {
			margin-top: 2.5rem;
			gap: 1.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tumu {
			transition: none;
		}
	}
</style>
