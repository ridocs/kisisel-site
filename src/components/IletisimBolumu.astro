---
import { Icon } from 'astro-icon/components';
import QRCode from 'qrcode';
import { cevirici, dilBul, taban } from '@/i18n/ceviriler';
/*
  İletişim bilgisi artık burada değil, `@/lib/iletisim` içinde: aynı bilgiyi
  Hakkımda sayfasındaki kanal listesi de kullanıyor ve iki kopya kaçınılmaz
  olarak birbirinden ayrı düşerdi. Yer tutucuların açıklaması o dosyada.
*/
import { EPOSTA, KONUM, QR_ICERIK, WHATSAPP, WHATSAPP_MESAJ } from '@/lib/iletisim';

const dil = dilBul(Astro.url);
const m = cevirici(dil);

/*
  QR'ın ne işe yaradığı ve içeriğinin nereden geldiği.

  İçerik PANELDEN geliyor ("İletişim bilgileri" → Kare kod içeriği). Boş
  bırakılırsa sitenin kendi adresi kodlanıyor — en sık istenen davranış bu:
  masaüstünde siteyi gösterirken karşıdaki telefonuyla okutup açıyor.

  Yedek adres ELLE YAZILMIYOR, `Astro.site` + `base` üzerinden türetiliyor.
  Elle yazılmış hâli site başka bir alan adına taşındığında sessizce eski
  adrese işaret etmeye devam ederdi — kod okunur, doğru görünür, yanlış yere
  gider.

  Panelde yazılan içerik adres olmak zorunda değil: telefon, e-posta, kablosuz
  ağ bilgisi ya da düz metin de kodlanabilir. Matris her derlemede yeniden
  üretiliyor, yani içerik değişince kod da değişiyor.
*/
/*
  WhatsApp bağlantısı, panelde yazılan hazır mesajla birlikte.

  `?text=` ile gönderilen metin sohbet açıldığında yazı kutusunda hazır
  bekliyor; kişi isterse silip kendi yazıyor. Mesaj boşsa parametre hiç
  eklenmiyor — boş bir `?text=` adresi uzatmaktan başka bir işe yaramıyor.

  `encodeURIComponent` şart: boşluk, soru işareti ve Türkçe harfler
  kodlanmadan gönderilirse bağlantı bozuluyor.
*/
const whatsappMesaji = WHATSAPP_MESAJ[dil];
const whatsappBaglantisi = `https://wa.me/${WHATSAPP}${
	whatsappMesaji ? `?text=${encodeURIComponent(whatsappMesaji)}` : ''
}`;

const qrIcerik = QR_ICERIK || new URL(`${taban}/`, Astro.site).href;

/*
  Matris derleme sırasında üretiliyor: tarayıcıya ne kütüphane ne de görsel
  iniyor, QR sayfanın içinde SVG olarak duruyor. Ölçek ve renk CSS'ten
  geldiği için koyu temada da doğru görünüyor.

  Hata düzeltme 'M'. Bir üst seviye ('H') matrisi 29×29'dan 37×37'ye
  çıkarıyor ve aynı kutuda modüller 4.3 pikselden 3.6 piksele düşüp
  bulanıklaşıyordu — okunmayan ama sağlam bir kod işe yaramaz.
*/
const qr = QRCode.create(qrIcerik, { errorCorrectionLevel: 'M' });
const boyut = qr.modules.size;

/*
  Sessiz alan (quiet zone): kodun çevresinde boş bırakılması gereken pay.
  Şartname 4 modül istiyor; okuyucular kodun nerede bittiğini buradan
  anlıyor. Kutunun CSS dolgusuna bırakılmıştı ama o pay ölçeğe göre değişiyor
  ve 4 modülün altında kalıyordu — bu yüzden viewBox'a katıldı.
*/
const SESSIZ_ALAN = 4;

/*
  KABARTMA (3B)

  Her modül iki kez çiziliyor: önce aşağı-sağa kaydırılmış koyu bir gövde,
  üstüne asıl yüz. Aradaki fark modülü bir küpün üst yüzü gibi gösteriyor.

  Köşe işaretçileri AYRI bir şekille çizilmiyor, bütün modüller aynı
  geometriyle basılıyor. Önceki sürümde işaretçiler elle çiziliyordu ve
  merkez kare bir modül eksik kalmıştı; matrisin kendisini olduğu gibi
  basmak bu sınıf hataları tamamen ortadan kaldırıyor.

  Derinlik ve boşluk modül biriminde: SVG ölçeklendiğinde oran korunuyor.
*/
const DERINLIK = 0.26;
/*
  MODÜLLER BİTİŞİK — aralarında boşluk YOK.

  Önceden her modül biraz küçültülüyordu (0.035 birim pay) ve aralarında ince
  beyaz çizgiler kalıyordu. Göze hoş görünüyordu ama KOD OKUNMUYORDU: aynı
  içerikten üretilen üç çizim jsQR ile tek tek denendi —

    boşluklu (+ kabartmalı)  okunamadı
    boşluklu, kabartmasız    okunamadı
    bitişik                  okundu
    bitişik + kabartmalı     okundu

  Yani suçlu boşluktu, kabartma değil. Okuyucu modül ızgarasını örnekleyerek
  buluyor; modüller birbirine değmeyince ızgara adımı kayıyor ve matris
  çözülemiyor.

  Kabartma bu yüzden olduğu gibi kaldı: bitişik hâliyle de okunuyor, üstelik
  gövde katmanı üst yüzün arkasından taşarak derinliği veriyor.
*/
const BOSLUK = 0;
const YUZ = 1;

/*
  İKİ PATH, 858 DİKDÖRTGEN DEĞİL.

  Her modül ayrı bir <rect> iken bu bölüm tek başına 858 element basıyordu
  (429 modül × iki katman) ve Lighthouse sayfanın DOM'unu "aşırı büyük"
  bulup buraya işaret ediyordu. Aynı geometri tek bir path verisiyle
  çiziliyor: element sayısı 858'den 2'ye, HTML'deki karşılığı da yaklaşık
  üçte birine iniyor.

  Köşe yuvarlaması (eski rx=0.12) bu sırada düştü. 168 pikselde bir modül
  4.3 piksel, yuvarlaklığı yarım pikseldi — path'e arc olarak yazmak modül
  başına dört komut daha demekti, karşılığında gözle görülmeyen bir fark.

  Sayılar iki ondalığa yuvarlanıyor; 29×29'luk bir ızgarada daha fazlası
  aynı pikseli işaret ediyor.
*/
function pathVerisi(kaydir: number): string {
	const parcalar: string[] = [];
	const en = YUZ.toFixed(2);
	for (let satir = 0; satir < boyut; satir++) {
		for (let sutun = 0; sutun < boyut; sutun++) {
			if (qr.modules.get(satir, sutun) !== 1) continue;
			const x = (sutun + BOSLUK + kaydir).toFixed(2);
			const y = (satir + BOSLUK + kaydir).toFixed(2);
			parcalar.push(`M${x} ${y}h${en}v${en}h-${en}z`);
		}
	}
	return parcalar.join('');
}

const qrGovdeYolu = pathVerisi(DERINLIK);
const qrYuzYolu = pathVerisi(0);
---

{/*
  İletişim.

  Referans karttan alınanlar: durum rozeti, ad + rol, iki eylem düğmesi ve
  altta vurgu şeridi. Canlı saat alınmadı — JavaScript gerektiriyor ve saat
  ziyaretçiye hiçbir şey anlatmıyor; yerine konum yazıyor.
*/}
<section
	class="iletisim relative overflow-hidden py-10 sm:py-20 md:flex md:min-h-[100svh] md:items-center md:py-12"
	data-belir
	data-parcali
	data-sayfa
	id="iletisim"
>
	{/*
	  Kartın genişliği 4xl'de (896px) kalıyor, ama artık boşlukla değil
	  ayraçla bölünüyor: eskiden düğmelerle QR arasındaki o fazlalık ölü bir
	  alana dönüşüyordu. Daraltmak boşluğu kapatıyor fakat bu kez üç düğme
	  tek satıra sığmıyordu — bölmeyi çizgiyle ayırmak ikisini birden çözdü.
	*/}
	<div class="mx-auto w-full max-w-3xl px-4 lg:max-w-4xl">
		<p
			class="text-xs font-semibold tracking-[0.22em] text-muted-foreground"
			data-belir-oge
			style="--sira: 0"
		>
			{m('iletisim.ustBaslik')}
		</p>
		<h2
			class="baslik mt-3 font-bold tracking-tight text-foreground"
			data-belir-oge
			style="--sira: 1"
		>
			{m('iletisim.baslik')}
		</h2>

		<div class="kart" data-belir-oge style="--sira: 2">
			<div class="kart-govde">
				<div class="kart-sol">
					<div class="durum">
						<span class="nokta" aria-hidden="true"></span>
						<span>{m('iletisim.durum')}</span>
					</div>

					<div class="kimlik">
						<span class="bas-harf" aria-hidden="true">ME</span>
						<div class="kimlik-metin">
							<p class="ad">Mustafa Eybek</p>
							{/*
							  Rol ve konum tek satırda, aralarında bir ayraç. Konum eskiden
							  durum satırının sağ ucuna `margin-inline-start: auto` ile
							  itiliyordu; satır sarıldığında sola düşüp hizasız kalıyordu ve
							  zaten kimliğe ait bir bilgiyi kartın öbür ucunda tutuyordu.
							*/}
							<p class="rol">
								<span>{m('iletisim.rol')}</span>
								<span class="ayrac" aria-hidden="true">·</span>
								<span>{KONUM[dil]}</span>
							</p>
							{/*
							  Adres ad ve rolle AYNI SÜTUNDA: kimlik metninin içinde
							  duruyor. Kimliğin dışındayken baş harf dairesinin altına
							  düşüyor ve soldan hizası kayıyordu.
							*/}
							<p class="adres">
								<a href={`mailto:${EPOSTA}`}>{EPOSTA}</a>
							</p>
						</div>
					</div>

					<div class="dugmeler">
						<a class="dugme birincil" href={`mailto:${EPOSTA}`}>
							<Icon name="lucide:mail" class="size-4" />
							<span>{m('iletisim.yaz')}</span>
						</a>

						{/* Numara boşsa düğme hiç basılmıyor. */}
						{WHATSAPP && (
							<a
								class="dugme whatsapp"
								href={whatsappBaglantisi}
								rel="noopener"
								target="_blank"
							>
								<Icon name="lucide:message-circle" class="size-4" />
								<span>WhatsApp</span>
							</a>
						)}

						{/*
						  Kopyala düğmesi JavaScript gerektiriyor; bu yüzden varsayılan
						  olarak gizli ve yalnızca betik çalıştığında (`js-var`)
						  görünüyor. Böylece betik çalışmazsa tıklayınca hiçbir şey
						  yapmayan bir düğme kalmıyor — e-posta zaten aşağıda yazılı.
						*/}
						<button
							class="dugme ikincil kopyala"
							type="button"
							data-kopyala={EPOSTA}
							data-kopyalandi={m('iletisim.kopyalandi')}
						>
							<Icon name="lucide:copy" class="size-4" />
							<span data-kopyala-etiket>{m('iletisim.kopyala')}</span>
						</button>
					</div>

				</div>

				<div class="kart-sag">
					<div class="qr-kutu">
						<svg
							class="qr"
							viewBox={`${-SESSIZ_ALAN} ${-SESSIZ_ALAN} ${boyut + SESSIZ_ALAN * 2} ${boyut + SESSIZ_ALAN * 2}`}
							role="img"
							aria-label={m('iletisim.qrAlt')}
						>
							{/* Gövde: kaydırılmış alt katman, kabartmanın yan yüzü. */}
							<path class="qr-govde" d={qrGovdeYolu} />

							{/* Üst yüz: okunan katman bu. */}
							<path class="qr-yuz" d={qrYuzYolu} />
						</svg>
					</div>
					<p class="qr-not">{m('iletisim.qrNot')}</p>
				</div>
			</div>

			<div class="serit">
				<Icon name="lucide:zap" class="size-4" />
				<span>{m('iletisim.serit')}</span>
			</div>
		</div>
	</div>
</section>

<style>
	.baslik {
		font-size: clamp(1.5rem, 1.1rem + 1.6vh, 2.125rem);
		line-height: 1.2;
		/* Başlık iki satıra düştüğünde satırlar dengeli bölünsün; dar ekranda
		   tek kelimelik bir alt satır kalmıyor. */
		text-wrap: balance;
	}

	/*
	  VURGU TONU — kartta tek bir yeşil var.

	  Önceden üç ayrı yeşil yan yana duruyordu: durum noktası, WhatsApp
	  düğmesi ve alt şerit. Üçü birbirine yakın ama aynı değildi, bu yüzden
	  kalibresiz görünüyordu. WhatsApp kendi marka yeşilini koruyor (düğmenin
	  ne olduğunu yazıdan önce söylüyor), kartın geri kalanı tek tondan
	  besleniyor.
	*/
	.kart {
		--vurgu: oklch(0.82 0.19 130);
	}

	/*
	  Kart her iki temada da KOYU — referanstaki gibi. Sayfanın geri kalanı
	  açık temada beyazken bu blok koyu kalıyor ve bölüm sayfanın sonunda bir
	  durak gibi okunuyor. Renkler bu yüzden temaya bağlı değişkenlerden değil
	  doğrudan veriliyor; `--foreground` kullanılsaydı açık temada kart
	  beyazlayıp vurgusunu kaybederdi.
	*/
	/*
	  Kart koyu temada sayfa zeminiyle neredeyse aynı koyulukta kalıyor. Eski
	  hâlde bunu fark ettirmeyen şey alt şeridin parlak yeşiliydi: kartın
	  sınırını o çiziyordu. Şerit nötrleşince kart zeminde eriyip gitti, bu
	  yüzden sınırını artık kendisi taşıyor — bir tık açık zemin, çevresinde
	  ince bir çerçeve ve açık temada onu kâğıttan ayıran yumuşak bir gölge.
	*/
	.kart {
		margin-top: 2rem;
		border-radius: 1.5rem;
		overflow: hidden;
		background: oklch(0.19 0 0);
		box-shadow:
			0 1px 0 oklch(1 0 0 / 0.08) inset,
			0 0 0 1px oklch(1 0 0 / 0.1),
			0 12px 32px oklch(0 0 0 / 0.14);
	}

	.kart-govde {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		padding: 1.5rem;
	}

	.kart-sol {
		min-width: 0;
		flex: 1;
	}

	.durum {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.8125rem;
		color: oklch(0.85 0 0);
	}

	.nokta {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 9999px;
		background: var(--vurgu);
		flex: none;
	}

	.kimlik-metin {
		min-width: 0;
	}

	.ayrac {
		margin-inline: 0.45rem;
		color: oklch(0.5 0 0);
	}

	.kimlik {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		margin-top: 1.25rem;
	}

	/* Fotoğraf yerine baş harfler: sitedeki portre hâlâ yer tutucu, aynı yer
	   tutucuyu ikinci kez göstermek yerine nötr bir işaret duruyor. */
	.bas-harf {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 9999px;
		background: oklch(0.26 0 0);
		color: oklch(0.92 0 0);
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		flex: none;
	}

	.ad {
		font-size: 1.25rem;
		font-weight: 700;
		color: oklch(0.98 0 0);
		line-height: 1.2;
	}

	.rol {
		margin-top: 0.15rem;
		font-size: 0.875rem;
		color: oklch(0.68 0 0);
	}

	/*
	  Dar ekranda düğmeler ızgaraya giriyor: birincil eylem üstte tam
	  genişlikte, diğer ikisi altında eşit iki sütun. `flex-wrap` ile üçü
	  sarıldığında satır sonlarına göre rastgele genişlikler oluşuyordu —
	  "E-postayı kopyala" tek başına kalıp birincil düğmeden geniş
	  görünüyordu ve ağırlık sırası tersine dönüyordu.
	*/
	.dugmeler {
		display: grid;
		/* En dar ekranda tek sütun: iki sütuna bölündüğünde "E-postayı
		   kopyala" düğmenin içinde iki satıra sarıyor ve yanındaki tek
		   satırlık WhatsApp'la aynı yüksekliğe zorlanıyordu. */
		grid-template-columns: 1fr;
		gap: 0.625rem;
		margin-top: 1.5rem;
	}

	@media (min-width: 480px) {
		.dugmeler {
			grid-template-columns: 1fr 1fr;
		}

		.birincil {
			grid-column: 1 / -1;
		}
	}

	.dugme {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding-inline: 1.1rem;
		border: 0;
		border-radius: 0.875rem;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		flex: 1 1 auto;
		transition:
			background-color 200ms ease-out,
			translate 200ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.dugme:hover {
		translate: 0 -1px;
	}

	.dugme:focus-visible {
		outline: 2px solid oklch(0.82 0.19 130);
		outline-offset: 2px;
	}

	.birincil {
		background: oklch(0.98 0 0);
		color: oklch(0.17 0 0);
	}

	.birincil:hover {
		background: oklch(0.9 0 0);
	}

	.ikincil {
		background: oklch(0.26 0 0);
		color: oklch(0.95 0 0);
	}

	/* WhatsApp'ın kendi yeşili; marka tanınırlığı düğmenin ne olduğunu
	   yazıdan önce söylüyor. Üstündeki metin koyu: bu yeşilde beyaz yazı
	   kontrast eşiğini geçmiyor. */
	.whatsapp {
		background: oklch(0.72 0.17 152);
		color: oklch(0.21 0.04 152);
	}

	.whatsapp:hover {
		background: oklch(0.78 0.16 152);
	}

	.ikincil:hover {
		background: oklch(0.32 0 0);
	}

	/* Betik çalışmadan kopyalama yapılamaz; düğme o hâlde hiç görünmüyor. */
	.kopyala {
		display: none;
	}

	:global(html.js-var) .kopyala {
		display: inline-flex;
	}

	/* Kopyala düğmesi basılmadığında ızgarada boş bir hücre kalmasın:
	   WhatsApp satırın tamamını alıyor. */
	:global(html:not(.js-var)) .whatsapp {
		grid-column: 1 / -1;
	}

	.adres {
		/* Rolün hemen altında, aynı sütunda. Kimlik metninin parçası olduğu
		   için soldan hizası ad ve rolle aynı. */
		margin-top: 0.35rem;
		font-size: 0.8125rem;
		color: oklch(0.7 0 0);
	}

	.adres a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid oklch(1 0 0 / 0.18);
	}

	.adres a:hover {
		color: oklch(0.92 0 0);
	}

	/* --- QR --- */

	/*
	  QR TELEFONDA BASILMIYOR.

	  Kodun tek işi, masaüstünde siteyi gösterirken karşıdakinin telefonuyla
	  okutabilmesi. Ziyaretçi zaten telefondaysa kendi ekranındaki kodu
	  okutamaz: kart mobilde yüksekliğinin yarısını hiçbir işe yaramayan
	  beyaz bir bloğa veriyordu. `display: none` olduğu için matris de
	  çizilmiyor, dar ekranda boşuna iş yapılmıyor.
	*/
	.kart-sag {
		display: none;
		flex-direction: column;
		align-items: center;
		/* Kod ve notu bölmenin dikey ortasına al: sol sütun daha uzun olduğu
		   için üste yapışık duruyordu. */
		justify-content: center;
		gap: 0.625rem;
		flex: none;
	}

	.qr-kutu {
		background: oklch(1 0 0);
		border-radius: 1rem;
		padding: 0.875rem;
		width: fit-content;
	}

	.qr {
		display: block;
		width: 168px;
		height: 168px;
	}

	/* Gövde üst yüzden açık: ikisi arasındaki fark kabartmayı okutuyor.
	   Fazla açık olursa okuyucu iki katmanı ayrı modül sanabilir, bu yüzden
	   ikisi de koyu tarafta kalıyor. */
	.qr-govde {
		fill: oklch(0.62 0 0);
	}

	.qr-yuz {
		fill: oklch(0.17 0 0);
	}

	.qr-not {
		font-size: 0.75rem;
		color: oklch(0.7 0 0);
		text-align: center;
		/* Not QR kutusunun genişliğini aşmıyor: iki blok aynı kenardan
		   hizalanıyor, altta sarkan bir satır kalmıyor. */
		max-width: 12.5rem;
		line-height: 1.45;
	}

	/*
	  ALT ŞERİT — vurgu değil, dipnot.

	  Şerit eskiden kartın tam genişliğinde parlak yeşil bir bloktu ve kartın
	  en çok dikkat çeken parçası oydu. Taşıdığı bilgi ("genelde aynı gün
	  dönüyorum") ise en önemsiziydi: göz önce oraya gidip sonra yukarı,
	  asıl eyleme dönüyordu. Şerit artık koyu zeminde, üstünde ince bir
