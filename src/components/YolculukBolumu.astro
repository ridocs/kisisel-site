---
import { Icon } from 'astro-icon/components';
import { cevirici, dilBul } from '@/i18n/ceviriler';

const dil = dilBul(Astro.url);
const m = cevirici(dil);

/*
  ZAMAN ÇİZELGESİ İÇERİĞİ — düzenlenecek tek yer burası.

  Her kayıt:
    yil      : kartın üstündeki etiket. "2021 — 2025" gibi aralık da olur.
    tur      : simgeyi belirler -> 'okul' | 'belge' | 'egitim' | 'is'
    baslik   : { tr, en }  kurum ya da belge adı
    yer      : { tr, en }  bölüm, veren kurum, şehir... (boş bırakılabilir)
    aciklama : { tr, en }  bir iki cümle (boş bırakılabilir)

  Kart sayısı serbest; üç ya da beş kayıtta ağ en dengeli duruyor.
  Ortadaki kart kendiliğinden bir tık büyük çiziliyor.
  Şu anki kayıtlar YER TUTUCU — kendi bilgilerinle değiştir.
*/
const kayitlar = [
	{
		yil: '2017 — 2021',
		tur: 'okul',
		baslik: { tr: 'Lise adı', en: 'High school name' },
		yer: { tr: 'Alan', en: 'Field' },
		aciklama: { tr: 'Kısa bir not.', en: 'A short note.' },
	},
	{
		yil: '2021 — 2025',
		tur: 'okul',
		baslik: { tr: 'Üniversite adı', en: 'University name' },
		yer: { tr: 'Bölüm', en: 'Department' },
		aciklama: {
			tr: 'Bölüm hakkında kısa bir not.',
			en: 'A short note about the programme.',
		},
	},
	{
		yil: '2025',
		tur: 'belge',
		baslik: { tr: 'Sertifika adı', en: 'Certificate name' },
		yer: { tr: 'Veren kurum', en: 'Issuing organization' },
		aciklama: {
			tr: 'Bu belgeyi neyle aldığını yaz.',
			en: 'What this certificate covers.',
		},
	},
];

const simgeler: Record<string, string> = {
	okul: 'lucide:graduation-cap',
	belge: 'lucide:award',
	egitim: 'lucide:book-open',
	is: 'lucide:briefcase',
};

const adet = kayitlar.length;
// Ortadaki kart. Çift sayıda kayıtta soldaki orta seçiliyor.
const ortaIndeks = Math.floor((adet - 1) / 2);

/*
  Ağ çizgileri.

  Kartlar eşit sütunlara oturduğu için her kartın yatay merkezi oransal olarak
  bilinebiliyor; çizgiler yüzdelik bir viewBox'a (100x100) çiziliyor ve
  `preserveAspectRatio="none"` ile alana esnetiliyor. Böylece hiçbir ölçüm
  JavaScript'e ihtiyaç duymuyor.

  Çizgiler kartların ARKASINDA duruyor; yalnızca kartların arasındaki
  boşluklarda görünüyorlar — istenen "aralarından geçen ağ" etkisi bu.
*/
const merkezler = kayitlar.map((_, i) => ((i + 0.5) / adet) * 100);
// Kartların arasındaki boşlukların ortası: çizgiler en çok burada görünüyor.
const bosluklar = kayitlar.slice(0, -1).map((_, i) => ((i + 1) / adet) * 100);

// Kartlar alanın orta bandında (y 30-70) duruyor; ağ üstte ve altta açıkta
// kalıyor. Bu yüzden düğümler ve çaprazlar 8-92 aralığına yayılıyor.
const UST = 8;
const ALT = 92;

type Cizgi = { x1: number; y1: number; x2: number; y2: number; kalin?: boolean };
const cizgiler: Cizgi[] = [];

// Boydan boya yatay omurga
cizgiler.push({ x1: merkezler[0], y1: 50, x2: merkezler[adet - 1], y2: 50, kalin: true });

// Üst ve alt kuşaklar
cizgiler.push({ x1: merkezler[0], y1: UST, x2: merkezler[adet - 1], y2: UST });
cizgiler.push({ x1: merkezler[0], y1: ALT, x2: merkezler[adet - 1], y2: ALT });

for (let i = 0; i < adet - 1; i++) {
	const a = merkezler[i];
	const b = merkezler[i + 1];
	// Komşu kartlar arasında bir X: boşluğun ortasında kesişiyorlar
	cizgiler.push({ x1: a, y1: UST, x2: b, y2: ALT });
	cizgiler.push({ x1: a, y1: ALT, x2: b, y2: UST });
}

// Her karttan üst ve alt kuşağa dikey iplikler
for (let i = 0; i < adet; i++) {
	cizgiler.push({ x1: merkezler[i], y1: UST, x2: merkezler[i], y2: ALT });
}

// Ortadaki karttan diğerlerine uzanan ışınlar — ağı örümcek ağına yaklaştıran kısım
for (let i = 0; i < adet; i++) {
	if (i === ortaIndeks) continue;
	cizgiler.push({ x1: merkezler[ortaIndeks], y1: 50, x2: merkezler[i], y2: UST });
	cizgiler.push({ x1: merkezler[ortaIndeks], y1: 50, x2: merkezler[i], y2: ALT });
}
---

{/*
  Yolculuk — yatay kart dizisi.

  Kartlar arasından geçen ağ çizgileri saf SVG; konumlar oransal hesaplandığı
  için hiçbir yerleşim ölçümü çalışma anında yapılmıyor. Animasyon sitedeki
  diğer bölümlerle aynı kurguyu kullanıyor: varsayılan durum görünür,
  `data-gorunur` yalnızca giriş animasyonunu oynatıyor.
*/}
<section
	class="yolculuk relative overflow-hidden py-20 sm:py-28 md:flex md:min-h-[100svh] md:items-center md:py-24"
	data-belir
	data-parcali
	data-sayfa
>
	<div class="mx-auto w-full max-w-5xl px-4 lg:max-w-6xl xl:max-w-7xl">
		<div class="text-center">
			<p
				class="text-xs font-semibold tracking-[0.22em] text-muted-foreground lg:text-sm"
				data-belir-oge
				style="--sira: 0"
			>
				{m('yolculuk.ustBaslik')}
			</p>
			<h2
				class="mt-4 text-3xl font-bold tracking-tight text-foreground lg:text-5xl"
				data-belir-oge
				style="--sira: 1"
			>
				{m('yolculuk.baslik')}
			</h2>
			<p
				class="mx-auto mt-4 max-w-xl text-muted-foreground lg:text-lg"
				data-belir-oge
				style="--sira: 2"
			>
				{m('yolculuk.metin')}
			</p>
		</div>

		<div class="ag-alani relative mt-14 lg:mt-20">
			<svg
				class="ag pointer-events-none absolute inset-0 hidden h-full w-full md:block"
				viewBox="0 0 100 100"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				{
					cizgiler.map((c, i) => (
						<line
							x1={c.x1}
							y1={c.y1}
							x2={c.x2}
							y2={c.y2}
							vector-effect="non-scaling-stroke"
							class:list={[c.kalin && 'omurga']}
							style={`--cizgi-sira: ${i}`}
						/>
					))
				}
				{/* Düğümler yalnızca açıkta kalan yerlerde: boşlukların ortası ve
				    üst/alt kuşakların kart hizaları. */}
				{
					bosluklar.map((x) => (
						<circle cx={x} cy={50} r="0.9" vector-effect="non-scaling-stroke" class="dugum" />
					))
				}
				{
					merkezler.map((x) => (
						<>
							<circle cx={x} cy={UST} r="0.7" vector-effect="non-scaling-stroke" class="dugum" />
							<circle cx={x} cy={ALT} r="0.7" vector-effect="non-scaling-stroke" class="dugum" />
						</>
					))
				}
			</svg>

			<ol class="kartlar relative grid gap-6 lg:gap-8" style={`--sutun: ${adet}`}>
				{
					kayitlar.map((kayit, sira) => (
						<li
							class:list={['kart', sira === ortaIndeks && 'one']}
							data-belir-oge
							style={`--sira: ${3 + sira}`}
						>
							<div class="kart-ust">
								<span class="simge" aria-hidden="true">
									<Icon name={simgeler[kayit.tur] ?? simgeler.egitim} class="size-5" />
								</span>
								<span class="numara">{String(sira + 1).padStart(2, '0')}</span>
							</div>

							<span class="yil">{kayit.yil}</span>
							<h3 class="baslik">{kayit.baslik[dil]}</h3>
							{kayit.yer[dil] && <p class="yer">{kayit.yer[dil]}</p>}
							{kayit.aciklama[dil] && <p class="aciklama">{kayit.aciklama[dil]}</p>}
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<style>
	/* --- Ağ --- */
	.ag line {
		stroke: color-mix(in oklab, var(--foreground) 24%, transparent);
		stroke-width: 1;
	}

	.ag line.omurga {
		stroke: color-mix(in oklab, var(--foreground) 36%, transparent);
		stroke-width: 1.5;
	}

	.ag .dugum {
		fill: color-mix(in oklab, var(--foreground) 45%, transparent);
	}

	/* Çizgiler bölüm görününce soldan sağa çiziliyor. Uzunluk bilinmediği için
	   kesikli desen üzerinden değil, opaklıkla açılıyor — ölçüm gerektirmiyor. */
	[data-gorunur] .ag line {
		animation: ag-beli 900ms ease-out backwards;
		animation-delay: calc(300ms + var(--cizgi-sira, 0) * 45ms);
	}

	[data-gorunur] .ag .dugum {
		animation: ag-beli 600ms ease-out backwards;
		animation-delay: 700ms;
	}

	@keyframes ag-beli {
		from {
			opacity: 0;
		}
	}

	/* --- Kartlar --- */
	.kartlar {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	/*
	  Sütun sayısı kayıt sayısına bağlı: kartlar tek satırda kalsın ve ağ
	  çizgilerinin oransal hesabı tutsun. Tailwind sınıfıyla yapılamıyor,
	  çünkü sınıf adının derleme sırasında sabit olması gerekiyor.

	  Dikey dolgu da burada: kartlar ağ alanının orta bandına oturuyor, üstte
	  ve altta ağ açıkta kalıyor. Tailwind'in `py-*` sınıfı işe yaramıyordu —
	  yukarıdaki `padding: 0` onu eziyor, çünkü Astro kapsamlı stillere nitelik
	  seçicisi ekliyor ve özgüllüğü tek sınıflı utility'lerin üstüne çıkıyor.
	*/
	@media (min-width: 768px) {
		.kartlar {
			grid-template-columns: repeat(var(--sutun, 3), minmax(0, 1fr));
			padding-block: 4rem;
		}
	}

	@media (min-width: 1024px) {
		.kartlar {
			padding-block: 5rem;
		}
	}

	.kart {
		position: relative;
		border-radius: 1rem;
		border: 1px solid var(--border);
		background: var(--card);
		padding: 1.5rem;
		transition:
			border-color 260ms ease-out,
			translate 260ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.kart:hover {
		border-color: color-mix(in oklab, var(--foreground) 28%, transparent);
		translate: 0 -4px;
	}

	/* Ortadaki kart bir tık büyük ve biraz daha belirgin. Ölçek küçük tutuldu
	   (%6): daha fazlası komşularıyla çakışıyor. */
	@media (min-width: 768px) {
		.kart.one {
			scale: 1.06;
			border-color: color-mix(in oklab, var(--foreground) 26%, transparent);
			padding: 1.75rem;
		}

		.kart.one:hover {
			scale: 1.08;
		}
	}

	.kart-ust {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.simge {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.625rem;
		background: color-mix(in oklab, var(--foreground) 8%, transparent);
		color: var(--foreground);
	}

	.numara {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: color-mix(in oklab, var(--foreground) 35%, transparent);
	}

	.yil {
		display: block;
		margin-top: 1.5rem;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--muted-foreground);
	}

	.baslik {
		margin-top: 0.375rem;
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--foreground);
	}

	.yer {
		margin-top: 0.125rem;
		font-size: 0.9375rem;
		color: var(--muted-foreground);
	}

	.aciklama {
		margin-top: 0.75rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--muted-foreground);
	}

	@media (min-width: 1024px) {
		.baslik {
			font-size: 1.25rem;
		}

		.aciklama {
			font-size: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		[data-gorunur] .ag line,
		[data-gorunur] .ag .dugum {
			animation: none;
		}

		.kart,
		.kart:hover {
			transition: none;
			translate: none;
		}
	}
</style>
