---
import { Icon } from 'astro-icon/components';
import { cevirici, dilBul } from '@/i18n/ceviriler';

/*
  KULLANDIKLARIM SAYFASININ GÖVDESİ — iki dil de bu bileşeni kullanıyor.

  Tek bileşen olmasının sebebi Hakkımda'daki ile aynı: iki sayfa arasında
  metin dışında hiçbir fark yok, ayrı yazmak iki düzenin zamanla birbirinden
  ayrı düşmesini garantilerdi.

  Sayfa bilinçli olarak ekrana kilitlenmiyor: `data-sayfa` ve `min-height:
  100svh` yok. Bu bir okuma sayfası; hamle başına bir bölüm ilerlemek uzun
  bir listeyi ortasından kesiyor.

  İÇERİK KURALI: burada yalnızca depodan ya da makineden DOĞRULANABİLEN
  şeyler "gerçek" olarak yazıldı. Doğrulanamayan her kalem `yerTutucu: true`
  ile işaretli ve metni ne yazılacağını söylüyor — sitedeki diğer yer
  tutucularla (proje adları, tanıtım metinleri) aynı kalıp. Uydurma bir
  donanım listesi ilk soruda çöker.
*/

const dil = dilBul(Astro.url);
const m = cevirici(dil);

/*
  İÇERİK — düzenlenecek tek yer burası.

  Kalem alanları:
    ad        : { tr, en }  aracın adı (çoğu özel ad, ikisinde de aynı)
    neden     : { tr, en }  TEK SATIRLIK gerekçe. Sayfanın değeri burada;
                            "ne kullandığım" değil "neden kullandığım".
    surum     : yalnızca depodaki kurulu paketten OKUNABİLEN sürümler.
                Emin olunmayan yere hiç yazılmadı — yanlış sürüm, sürümsüz
                bir satırdan kötüdür.
    yerTutucu : true ise satır "yer tutucu" rozetiyle işaretleniyor ve
                `neden` alanı gerekçe değil, ne yazılacağının tarifi olur.

  Metinler çeviri dosyasına taşınmadı: Seçilmiş çalışmalar ve Yetkinlikler
  bölümlerindeki kalıbın aynısı. Sayfa kabuğu (başlıklar, bölüm girişleri)
  `src/i18n/ceviriler.ts` içinde, kalemler burada — içerik düzenlenirken tek
  dosyaya bakılıyor.
*/
type Kalem = {
	ad: { tr: string; en: string };
	neden: { tr: string; en: string };
	/** Yalnızca depodan okunabilen sürümlerde dolu; diğerlerinde hiç yok. */
	surum?: string;
	yerTutucu: boolean;
};

type Bolum = {
	baslik: string;
	metin: string;
	ikon: string;
	kalemler: Kalem[];
};

const bolumler: Bolum[] = [
	{
		baslik: m('kullandiklarim.donanimBaslik'),
		metin: m('kullandiklarim.donanimMetin'),
		ikon: 'lucide:keyboard',
		kalemler: [
			{
				ad: { tr: 'Bilgisayar', en: 'Computer' },
				neden: {
					tr: 'Model adını ve neden onu seçtiğini yaz: taşınabilirlik mi, derleme süresi mi, ekran mı?',
					en: 'Write the model and why you chose it: portability, build times, or the screen?',
				},
				yerTutucu: true,
			},
			{
				ad: { tr: 'Monitör', en: 'Monitor' },
				neden: {
					tr: 'Kaç inç, hangi çözünürlük ve ikinci bir ekran kullanıp kullanmadığını yaz.',
					en: 'Write the size, the resolution, and whether you run a second screen.',
				},
				yerTutucu: true,
			},
			{
				ad: { tr: 'Klavye', en: 'Keyboard' },
				neden: {
					tr: 'Marka ve düzen (Q / F) yaz. Bütün gün yazan biri için burası sanılandan önemli.',
					en: 'Write the make and the layout. For someone typing all day this matters more than it looks.',
				},
				yerTutucu: true,
			},
			{
				ad: { tr: 'Fare', en: 'Mouse' },
				neden: {
					tr: 'Model ve gerekçe: avuç boyu mu, kablosuz mu, dikey mi?',
					en: 'Model and reason: palm size, wireless, vertical?',
				},
				yerTutucu: true,
			},
			{
				ad: { tr: 'Kulaklık', en: 'Headphones' },
				neden: {
					tr: 'Model yaz ve ne için kullandığını söyle: odaklanma mı, görüşme mi, ikisi için ayrı mı?',
					en: 'Write the model and what it is for: focus, calls, or a separate pair for each?',
				},
				yerTutucu: true,
			},
			{
				ad: { tr: 'Telefon', en: 'Phone' },
				neden: {
					tr: 'Model yaz. Bu siteyi gerçek cihazda denediğin telefon burası — hangi cihaz olduğu okuyana bir şey söyler.',
					en: 'Write the model. This is the phone you test the site on, so naming it tells the reader something.',
				},
				yerTutucu: true,
			},
		],
	},
	{
		baslik: m('kullandiklarim.gelistirmeBaslik'),
		metin: m('kullandiklarim.gelistirmeMetin'),
		ikon: 'lucide:terminal',
		kalemler: [
			{
				ad: { tr: 'Windows 11', en: 'Windows 11' },
				neden: {
					tr: 'Günlük işletim sistemim; bu site de baştan sona burada geliştirildi.',
					en: 'My day-to-day operating system; this site was built on it from start to finish.',
				},
				yerTutucu: false,
			},
			{
				ad: { tr: 'Visual Studio Code', en: 'Visual Studio Code' },
				neden: {
					tr: 'Editörüm. Depo yalnızca tek bir eklenti öneriyor (Astro); yeni bir makinede kurulum tek yerden başlıyor.',
					en: 'My editor. The repository recommends exactly one extension (Astro), so setup on a new machine starts from a single place.',
				},
				yerTutucu: false,
			},
			{
				ad: { tr: 'Terminal', en: 'Terminal' },
				neden: {
					tr: 'Hangi terminali kullandığını yaz (Windows Terminal, PowerShell, WSL…) ve neden onda karar kıldığını.',
					en: 'Write which terminal you use (Windows Terminal, PowerShell, WSL…) and why you settled on it.',
				},
				yerTutucu: true,
			},
			{
				ad: { tr: 'Git', en: 'Git' },
				neden: {
					tr: 'Her şey sürüm kontrolünde; bu sitenin kendisi de bir depo, yazılar dâhil.',
					en: 'Everything lives in version control; this site is itself a repository, posts included.',
				},
				yerTutucu: false,
			},
			{
				ad: { tr: 'Python', en: 'Python' },
				neden: {
					tr: 'Otomasyon ve veri işleri. Sitenin yazı tipini küçülten araç (araclar/yazitipi-altkume.py) da Python.',
					en: 'Automation and data work. The tool that shrinks this site’s font (araclar/yazitipi-altkume.py) is Python too.',
				},
				yerTutucu: false,
			},
			{
				ad: { tr: 'JavaScript ve TypeScript', en: 'JavaScript and TypeScript' },
				neden: {
					tr: 'Web tarafındaki günlük işim. Tip sistemi eksik bir çeviri anahtarını çalışma anında değil derlemede yakalıyor.',
					en: 'My daily work on the web side. The type system catches a missing translation key at build time, not at runtime.',
				},
				yerTutucu: false,
			},
			{
				ad: { tr: 'Dart ve Flutter', en: 'Dart and Flutter' },
				neden: {
					tr: 'Mobil taraftaki takımım: tek koddan birden çok platforma arayüz.',
					en: 'My kit on the mobile side: one codebase, interfaces on several platforms.',
				},
				yerTutucu: false,
			},
			{
				ad: { tr: 'SQL ve PostgreSQL', en: 'SQL and PostgreSQL' },
				neden: {
					tr: 'Projelerde ana veri deposu. Şema tasarımı, indeksleme ve sorgu iyileştirme buradan geçiyor.',
					en: 'The primary data store in my projects. Schema design, indexing and query tuning all go through it.',
				},
				yerTutucu: false,
			},
			{
				ad: { tr: 'Docker', en: 'Docker' },
				neden: {
					tr: 'Geliştirme ortamını ve küçük servisleri kapsayıcıya alıyorum; dağıtımın tekrarlanabilirliği buradan geliyor.',
					en: 'I containerise dev environments and small services; this is where repeatable deployments come from.',
				},
				yerTutucu: false,
			},
		],
	},
	{
		baslik: m('kullandiklarim.siteBaslik'),
		metin: m('kullandiklarim.siteMetin'),
		ikon: 'lucide:code-xml',
		kalemler: [
			{
				ad: { tr: 'Astro', en: 'Astro' },
				neden: {
					tr: 'Sayfaları derleme anında HTML’e çeviriyor. Tarayıcıya çerçeve kodu inmiyor; sayfa JavaScript olmadan da eksiksiz okunuyor.',
					en: 'Renders pages to HTML at build time. No framework code reaches the browser; the page reads fully without JavaScript.',
				},
				surum: '7.3.2',
				yerTutucu: false,
			},
			{
				ad: { tr: 'Tailwind CSS', en: 'Tailwind CSS' },
				neden: {
					tr: 'Düzen ve boşluklar sınıflarla, renkler tema değişkenlerinden. Koyu tema böylece tek yerden dönüyor.',
					en: 'Layout and spacing through classes, colours through theme variables — so dark mode flips from one place.',
				},
				surum: '4.3.3',
				yerTutucu: false,
			},
			{
				ad: { tr: 'MDX', en: 'MDX' },
				neden: {
					tr: 'Yazılar düz Markdown; gerektiğinde araya bileşen koyabilmek için MDX. Bir yazı için istisna açmak gerekmiyor.',
					en: 'Posts are plain Markdown, with MDX so a component can drop in when one is needed — no exception required per post.',
				},
				surum: '8.0.1',
				yerTutucu: false,
			},
			{
				ad: { tr: 'TypeScript', en: 'TypeScript' },
				neden: {
					tr: 'Çeviri katmanı ve bileşen arayüzleri tipli. Bir dilde unutulan metin sayfaya değil, derleme hatasına dönüşüyor.',
					en: 'The translation layer and component interfaces are typed. A string forgotten in one language becomes a build error, not a hole on the page.',
				},
				yerTutucu: false,
			},
			{
				ad: { tr: 'Keystatic', en: 'Keystatic' },
				neden: {
					tr: 'Yazı paneli yalnızca geliştirme sunucusunda açılıyor ve doğrudan depodaki dosyalara yazıyor. Yayın derlemesinde hiç yer almıyor.',
					en: 'The writing panel only opens on the dev server and writes straight into the repository’s files. It is absent from the production build.',
				},
				surum: '0.6.9',
				yerTutucu: false,
			},
			{
				ad: { tr: 'Inter (alt kümelenmiş)', en: 'Inter (subsetted)' },
				neden: {
					tr: 'Hazır dosyalar tarayıcıya 133 KB indiriyordu; sitenin gerçekten kullandığı harflere indirildi. Türkçe harfler ayrı bir dosyada, yalnızca Türkçe sayfalarda isteniyor.',
					en: 'The stock files shipped 133 KB to the browser; they were cut down to the characters the site actually uses. Turkish letters sit in a separate file, requested only on Turkish pages.',
				},
				yerTutucu: false,
			},
			{
				ad: { tr: 'Lucide ve Iconify “logos”', en: 'Lucide and Iconify “logos”' },
				neden: {
					tr: 'Arayüz ikonları Lucide, teknoloji logoları “logos” takımı. İkisi de derleme sırasında gömülüyor: çalışma anında ağ isteği yok, çevrimdışı çalışıyor.',
					en: 'Interface icons from Lucide, technology logos from the “logos” set. Both are inlined at build time: no runtime network request, works offline.',
				},
				yerTutucu: false,
			},
		],
	},
	{
		baslik: m('kullandiklarim.sunucuBaslik'),
		metin: m('kullandiklarim.sunucuMetin'),
		ikon: 'lucide:server',
		kalemler: [
			{
				ad: { tr: 'nginx', en: 'nginx' },
				neden: {
					tr: 'Statik dosyaları sunuyor. Site alan adının kökünde değil bir alt dizinde yayınlandığı için yönlendirme ve önbellek kuralları burada duruyor.',
					en: 'Serves the static files. The site is published in a subdirectory rather than at the domain root, so the redirect and cache rules live here.',
				},
				yerTutucu: false,
			},
			{
				ad: { tr: 'PocketBase', en: 'PocketBase' },
				neden: {
					tr: 'Tek dosyalık arka uç: veritabanı, kimlik doğrulama ve dosya yükleme bir arada. Küçük bir proje için ayrı bir yığın kurmaya değmiyor.',
					en: 'A single-file backend: database, auth and file uploads in one. For a small project, standing up a separate stack is not worth it.',
				},
				yerTutucu: false,
			},
			{
				ad: { tr: 'PM2', en: 'PM2' },
				neden: {
					tr: 'Sunucudaki süreçleri ayakta tutuyor: çöken servisi yeniden başlatıyor, makine yeniden açıldığında kendiliğinden kalkıyor.',
					en: 'Keeps the processes on the server up: restarts a service that crashes and brings everything back after a reboot.',
				},
				yerTutucu: false,
			},
		],
	},
];

// Belirme sırası her bölümde sıfırdan başlıyor; bölüm kendi `data-belir`
// kapsamında. Başlık ve giriş metni ilk iki sırayı aldığı için kalemler
// ikiden sonra geliyor.
const BASLIK_OGE_SAYISI = 2;
---

{/*
  1) Giriş.

  Tek `h1` burada. Bölüm başlıkları `h2`, kalem adları `h3`: sayfa tek bir
  ağaç, ekran okuyucu başlık listesinden gezinebiliyor.
*/}
<section class="bolum giris-bolum" data-belir data-parcali>
	<p class="ust-baslik" data-belir-oge style="--sira: 0">{m('kullandiklarim.ustBaslik')}</p>

	<h1 class="ad" data-belir-oge style="--sira: 1">{m('kullandiklarim.baslik')}</h1>

	<div class="cizgi" data-belir-oge data-belir-cizgi style="--sira: 2" aria-hidden="true"></div>

	<p class="giris-cumle" data-belir-oge style="--sira: 3">{m('kullandiklarim.giris')}</p>

	{/*
	  Yer tutucu uyarısı sayfanın başında: okuyucu listenin yarısını okuduktan
	  sonra değil, girerken öğrenmeli hangi satırların henüz boş olduğunu.
	*/}
	<p class="not" data-belir-oge style="--sira: 4">
		<Icon name="lucide:info" class="size-4" aria-hidden="true" />
		<span>{m('kullandiklarim.not')}</span>
	</p>
</section>

{
	bolumler.map((bolum) => (
		<section class="bolum" data-belir data-parcali>
			{/*
			  İkon başlığın İÇİNDE, ayrı bir üst başlık satırı olarak değil: aynı
			  metni bir kez küçük büyük harfle, bir kez başlık olarak yazmak
			  ekran okuyucuda aynı sözcüğü iki kez okutuyordu.
			*/}
			<h2 class="baslik baslik-simgeli" data-belir-oge style="--sira: 0">
				<span class="baslik-simge" aria-hidden="true">
					<Icon name={bolum.ikon} class="size-4" />
				</span>
				<span>{bolum.baslik}</span>
			</h2>
			<p class="bolum-metin" data-belir-oge style="--sira: 1">
				{bolum.metin}
			</p>

			<ul class="kalemler">
				{bolum.kalemler.map((kalem, sira) => (
					<li data-belir-oge style={`--sira: ${BASLIK_OGE_SAYISI + sira}`}>
						<div class="kalem">
							<div class="kalem-ust">
								<h3 class="kalem-ad">{kalem.ad[dil]}</h3>

								{/*
								  Sağdaki etiket ya doğrulanmış bir sürüm ya da yer
								  tutucu rozeti; ikisi birden olmuyor. Sürümü olmayan
								  kalem sessizce geçiyor — bilinmeyen bir sürümü
								  uydurmaktansa hiç yazmamak doğru.
								*/}
								{kalem.yerTutucu ? (
									<span class="rozet">{m('kullandiklarim.yerTutucu')}</span>
								) : (
									kalem.surum && <span class="surum">{kalem.surum}</span>
								)}
							</div>

							<p class="kalem-neden">{kalem.neden[dil]}</p>
						</div>
					</li>
				))}
			</ul>
		</section>
	))
}

<style>
	/*
	  Bölümler ince bir çizgiyle ayrılıyor; ilki hariç. Kutu yerine çizgi —
	  Hakkımda ve Seçilmiş çalışmalar bölümleriyle aynı dil.
	*/
	.bolum {
		padding-block: 2.5rem;
	}

	.bolum + .bolum {
		border-top: 1px solid var(--border);
	}

	.giris-bolum {
		padding-top: 0;
	}

	.ust-baslik {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		color: var(--muted-foreground);
	}

	/*
	  Başlık ekran genişliğine göre ölçekleniyor. clamp içindeki rem bileşeni
	  bilinçli: salt vw ile kurulan bir ölçek kullanıcı yakınlaştırdığında
	  büyümüyor ve WCAG 1.4.4'ü karşılamıyor.
	*/
	.ad {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 1.45rem + 2.8vw, 3rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--foreground);
	}

	.cizgi {
		margin-top: 1rem;
		width: 5rem;
		height: 3px;
		border-radius: 9999px;
		background: linear-gradient(to right, var(--color-marka-600), var(--color-marka-400));
	}

	/* Giriş cümlesi gövde metninden bir kademe büyük: sayfanın özeti o. */
	.giris-cumle {
		margin-top: 1.5rem;
		max-width: 38rem;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--foreground);
	}

	/* Uyarı satırı: zemin yok, yalnızca ince bir çerçeve. Dolgulu bir kutu
	   sayfanın en üstünde gereğinden fazla bağırıyordu. */
	.not {
		display: flex;
		align-items: start;
		gap: 0.5rem;
		margin-top: 1.25rem;
		padding: 0.75rem 0.875rem;
		max-width: 38rem;
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--muted-foreground);
	}

	.not :global(svg) {
		flex: none;
		margin-top: 0.1rem;
	}

	.baslik {
		font-size: clamp(1.375rem, 1.1rem + 1.2vw, 1.75rem);
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--foreground);
	}

	.baslik-simgeli {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	/* İkon kutusu başlığın yanında sabit ölçüde: başlık ekran genişliğine göre
	   ölçekleniyor, kutu ölçeklenseydi bölümden bölüme boy değiştirirdi. */
	.baslik-simge {
		display: grid;
		place-items: center;
		flex: none;
		width: 1.875rem;
		height: 1.875rem;
		border-radius: 0.625rem;
		border: 1px solid var(--border);
		background: color-mix(in oklab, var(--foreground) 3%, transparent);
		color: var(--muted-foreground);
	}

	.bolum-metin {
		margin-top: 0.75rem;
		max-width: 34rem;
		line-height: 1.7;
		color: var(--muted-foreground);
	}

	/* Uzun bir paket adı ya da kesilmemiş bir sözcük dar ekranda satırı taşırıp
	   sayfayı yatay kaydırılır hâle getiriyordu. */
	.giris-cumle,
	.not,
	.bolum-metin,
	.kalem-ad,
	.kalem-neden {
		overflow-wrap: break-word;
	}

	/* --- Kalem listesi --- */
	.kalemler {
		list-style: none;
		padding: 0;
		margin: 1.75rem 0 0;
	}

	/* Ayıraç `li`'de: kalem kutusu üzerine gelince zemin alıyor ve zemin
	   çizginin üstüne binip onu siliyor. */
	.kalemler li {
		border-top: 1px solid var(--border);
	}

	.kalemler li:last-child {
		border-bottom: 1px solid var(--border);
	}

	.kalem {
		padding: 1rem 0.75rem;
		min-width: 0;
	}

	.kalem-ust {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.kalem-ad {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.35;
		color: var(--foreground);
		min-width: 0;
	}

	/* Sürüm sayısal bir değer: tabular-nums ile alt alta gelen satırlarda
	   rakamlar aynı genişlikte duruyor. */
	.surum {
		flex: none;
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
		color: var(--muted-foreground);
	}

	/* Yer tutucu rozeti: dolgu değil ince çerçeve — Seçilmiş çalışmalar
	   bölümündeki etiketlerle aynı ölçüde sakin. Renk taşımıyor, çünkü bu bir
	   uyarı değil yalnızca bir durum bildirimi. */
	.rozet {
		flex: none;
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
