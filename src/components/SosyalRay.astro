---
import { Icon } from 'astro-icon/components';

/**
 * Ekranın sağ kenarında, dikey ortada duran sabit sosyal medya rayı.
 *
 * Adresi olmayan hesap bağlantı olarak BASILMIYOR: soluk ve tıklanamaz
 * duruyor. Sitede aynı kural Çalışmalar bölümünde de geçerli — çalışmayan bir
 * bağlantı, hiç bağlantı olmamasından kötü ve tıklanabilir görünen ölü bir
 * ikon ziyaretçiye yanlış söz verir.
 */

/*
  HESAPLAR — düzenlenecek tek yer burası.
  `adres` alanını doldurdukça ikon kendiliğinden tıklanabilir hâle geliyor,
  başka hiçbir yeri değiştirmen gerekmiyor.
*/
const hesaplar = [
	{ ad: 'GitHub', ikon: 'lucide:github', adres: 'https://github.com/ridocs' },
	{ ad: 'LinkedIn', ikon: 'lucide:linkedin', adres: '' },
	{ ad: 'X', ikon: 'lucide:twitter', adres: '' },
	{ ad: 'Instagram', ikon: 'lucide:instagram', adres: '' },
	{ ad: 'YouTube', ikon: 'lucide:youtube', adres: '' },
];
---

<nav class="ray" aria-label="Sosyal medya">
	<ul>
		{
			hesaplar.map((h) =>
				h.adres ? (
					<li>
						<a class="dugme" href={h.adres} rel="noopener" target="_blank" aria-label={h.ad}>
							<Icon name={h.ikon} class="size-[18px]" />
						</a>
					</li>
				) : (
					<li>
						{/* Adres henüz yok: görünüyor ama tıklanmıyor ve ekran
						    okuyucuya "bağlantı" olarak duyurulmuyor. */}
						<span class="dugme bos" title={h.ad} aria-hidden="true">
							<Icon name={h.ikon} class="size-[18px]" />
						</span>
					</li>
				),
			)
		}
	</ul>
</nav>

<style>
	.ray {
		position: fixed;
		right: 0.75rem;
		top: 50%;
		translate: 0 -50%;
		z-index: 40;
	}

	.ray ul {
		list-style: none;
		padding: 0.375rem;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		border: 1px solid var(--border);
		border-radius: 9999px;
		/*
		  Bulanıklık YOK: iOS'ta `backdrop-filter` sayfayı dondurmuştu. Zemin
		  düz bir karışım; sayfanın üstünde durduğu için tam opak değil ama
		  arkasını da bulandırmıyor.
		*/
		background: color-mix(in oklab, var(--background) 88%, var(--foreground));
	}

	.dugme {
		display: grid;
		place-items: center;
		/* Dokunma hedefi 40 piksel; WCAG 2.2 web için 24 istiyor ama
		   dokunmatikte bu aralık isabet hatasını belirgin azaltıyor. */
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 9999px;
		color: var(--muted-foreground);
		text-decoration: none;
		transition:
			background-color 200ms ease-out,
			color 200ms ease-out;
	}

	a.dugme:hover {
		background: color-mix(in oklab, var(--foreground) 8%, transparent);
		color: var(--foreground);
	}

	a.dugme:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}

	/* Adressiz hesap: yalnızca yerini tutuyor. */
	.bos {
		opacity: 0.35;
		cursor: default;
	}

	/*
	  Dar ekranda ray yok: 40 piksellik bir sütun telefonda içeriğin üstüne
	  biniyor ve sağ kenardan kaydırmaya karışıyor. Aynı bağlantılar zaten
	  altbilgide duruyor.
	*/
	@media (max-width: 1023px) {
		.ray {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dugme {
			transition: none;
		}
	}
</style>
