---
/**
 * Gezinme çubuğundaki vurgulu düğme — sıvı metal görünümü.
 *
 * Önceki sürüm React + WebGL shader ile çiziliyordu ve sitenin tarayıcıya inen
 * JavaScript'inin tamamını (≈79 KB) tek başına bu düğme oluşturuyordu. Görünüm
 * burada saf CSS ile üretiliyor: dönen konik gradyan metal akışını, üstteki
 * yumuşak parlama cam hissini veriyor. Böylece sayfada hiç JavaScript kalmıyor.
 *
 * Bir zamanlar yalnızca "İletişim" içindi, adı da oydu. Çubuktaki yeri
 * 2026-09-20'de "Giriş Yap"a geçince ad genelleşti: çubuğun vurgulu tek
 * düğmesi ne olursa olsun bu bileşen çiziyor.
 *
 * `hedef` verilirse bağlantı, verilmezse pasif bir düğme oluyor.
 */
interface Props {
	etiket: string;
	/**
	 * Gidilecek adres. Verilmezse düğme pasif: henüz bir yere gitmiyor
	 * ama çubuktaki yerini tutuyor.
	 */
	hedef?: string;
	/**
	 * Pasif hâlde ekran okuyucuya durumu anlatan ek not
	 * ("yakında" gibi). Gözle görünmüyor.
	 */
	pasifNotu?: string;
}

const { etiket, hedef, pasifNotu } = Astro.props;
---

{
	hedef ? (
		<a class="sivi-metal" href={hedef}>
			<span class="sivi-metal-yazi">{etiket}</span>
		</a>
	) : (
		/*
		  Gerçekten `disabled` bir <button>: `aria-disabled` yalnızca duyurur,
		  tıklamayı ve sekme sırasını engellemez. Hiçbir yere gitmeyen bir
		  şeye odaklanmak, klavyeyle gezen için boşa bir durak.
		*/
		<button class="sivi-metal pasif" type="button" disabled>
			<span class="sivi-metal-yazi">{etiket}</span>
			{pasifNotu && <span class="sr-only"> ({pasifNotu})</span>}
		</button>
	)
}

<style>
	/*
	  Ölçü çubuğun geri kalanıyla hizalı: ikon düğmeleri, marka ve gezinme
	  bağlantıları masaüstünde 36 piksel. Önceki 46 piksel, çubuk 52 piksele
	  inince kapsülün içini neredeyse tamamen dolduruyordu.

	  Genişlik sabit değil: "İletişim" ve "Contact" farklı uzunlukta, sabit
	  genişlik ikisinden birinde ya sıkışık ya boşluklu duruyordu. Dolgu artı
	  alt sınır, iki dilde de dengeli bir kapsül veriyor.
	*/
	.sivi-metal {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 108px;
		height: 36px;
		padding-inline: 1.125rem;
		border-radius: 100px;
		background: linear-gradient(180deg, var(--lm-ust) 0%, var(--lm-alt) 100%);
		/* Gölge yerine yalnızca kenar çizgisi: gezinme kapsülü `overflow: hidden`
		   olduğu için aşağı uzanan gölge kesilip keskin bir leke bırakıyordu. */
		box-shadow: 0 0 0 1px var(--lm-kenar);
		overflow: hidden;
		/* Yığın bağlamını kendi içinde tutar; içerideki katmanlar navbar'ın
		   diğer öğelerinin üstüne taşmaz. */
		isolation: isolate;
		text-decoration: none;
		transition:
			box-shadow 150ms cubic-bezier(0.4, 0, 0.2, 1),
			transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
	}

	/* Akan metal: geniş bir konik gradyan yavaşça dönüyor, bulanıklık
	   bantların keskin kenarını yumuşatıp sıvı hissini veriyor. */
	.sivi-metal::before {
		content: "";
		position: absolute;
		/* Kutudan taşacak kadar büyük: döndüğünde köşelerde boşluk kalmasın. */
		inset: -70%;
		background: conic-gradient(
			from 0deg,
			rgba(255, 255, 255, 0) 0deg,
			rgba(255, 255, 255, 0.45) 38deg,
			rgba(255, 255, 255, 0) 82deg,
			rgba(170, 200, 255, 0.3) 145deg,
			rgba(255, 255, 255, 0) 195deg,
			rgba(255, 255, 255, 0.4) 252deg,
			rgba(255, 255, 255, 0) 300deg,
			rgba(255, 185, 165, 0.24) 332deg,
			rgba(255, 255, 255, 0) 360deg
		);
		filter: blur(7px);
		opacity: 0.7;
		animation: sivi-metal-don 9s linear infinite;
	}

	/* Üstten aşağı sönen parlama: yüzeye cam/krom hissi verir. */
	.sivi-metal::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 48%);
	}

	.sivi-metal-yazi {
		position: relative;
		z-index: 1;
		/* Gezinme bağlantılarıyla aynı boy: düğme onlardan daha iri bir yazıyla
		   ayrı bir ölçekteymiş gibi duruyordu. */
		font-size: 14px;
		line-height: 1;
		font-weight: 400;
		white-space: nowrap;
		color: var(--lm-metin);
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
	}

	.sivi-metal:hover {
		box-shadow: 0 0 0 2px var(--lm-kenar);
	}

	/* Üzerine gelindiğinde metal hızlanıyor — React sürümündeki setSpeed(1)
	   davranışının karşılığı. */
	.sivi-metal:hover::before {
		animation-duration: 4s;
	}

	.sivi-metal:active {
		transform: translateY(1px) scale(0.98);
	}

	.sivi-metal:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}

	@keyframes sivi-metal-don {
		to {
			transform: rotate(360deg);
		}
	}

	/* ------------------------------------------------------------------ *
	 * PASİF HÂL
	 *
	 * Düğme çubuktaki yerini tutuyor ama hiçbir yere gitmiyor. İki şey
	 * birlikte söylüyor bunu: solukluk ve DURAN metal. Akan bir yüzey
	 * "buraya bas" diyor; pasif düğmede akış sürseydi görsel vaat ile
	 * davranış çelişirdi.
	 * ------------------------------------------------------------------ */
	.pasif {
		/* <button> kendi çerçevesini ve yazı tipini getiriyor; <a> sürümüyle
		   aynı görünmesi için ikisi de sıfırlanıyor. */
		border: 0;
		font: inherit;
		opacity: 0.55;
		cursor: not-allowed;
		/* Basılı hâl taklidi yok: basılamıyor. */
		transform: none;
	}

	.pasif::before {
		animation: none;
	}

	.pasif:hover {
		transform: none;
	}

	/* Hareketi azaltılmış tercihte metal duruyor; düğme yine de metalik kalıyor. */
	@media (prefers-reduced-motion: reduce) {
		.sivi-metal::before {
			animation: none;
		}
	}
</style>
