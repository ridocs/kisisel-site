---
import { Icon } from 'astro-icon/components';

// Gezinme bağlantıları. Yeni sayfa eklediğinde buraya bir satır eklemen yeterli;
// hem masaüstü hem mobil menü bu listeden üretilir.
const baglantilar = [
	{ ad: 'Ana Sayfa', yol: '/' },
	{ ad: 'Blog', yol: '/blog' },
];

const suAnkiYol = Astro.url.pathname;

// "/" yalnızca tam eşleşmede aktiftir; diğerleri alt sayfalarında da aktif kalır
// (örn. /blog/merhaba-dunya/ açıkken "Blog" vurgulu görünür).
function aktifMi(yol: string) {
	if (yol === '/') return suAnkiYol === '/';
	return suAnkiYol === yol || suAnkiYol.startsWith(`${yol}/`);
}

// Bağlantı stilleri iki menüde de aynı olsun diye tek yerde tutuluyor.
const bagTemel =
	'rounded-md px-3.5 py-2 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-marka-500';
const bagAktif = 'bg-marka-50 text-marka-600 dark:bg-marka-500/15 dark:text-marka-400';
const bagPasif =
	'text-slate-600 hover:bg-slate-900/5 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white';
const eylemDugmesi =
	'grid size-9 place-items-center rounded-md text-slate-500 transition-colors hover:bg-slate-900/5 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-marka-500 dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white';
---

{/*
  Çubuk iki durum arasında geçiş yapar ve durum `data-kaydirildi` ile taşınır:
  - "false" (sayfanın tepesi / hero): tam genişlik, zeminsiz, yüksek
  - "true"  (aşağı kaydırılmış): ortada yüzen, dar, yuvarlatılmış, bulanık zeminli kapsül
  Alt öğeler bu duruma `group-data-[kaydirildi=true]:` ile tepki verir.
*/}
<header id="ust-cubuk" data-kaydirildi="false" class="group fixed inset-x-0 top-0 z-50">
	<div
		class="mx-auto w-full max-w-7xl px-4 transition-all duration-200 ease-out group-data-[kaydirildi=true]:max-w-5xl motion-reduce:transition-none sm:px-6 group-data-[kaydirildi=true]:sm:px-4"
	>
		<div
			class="overflow-hidden border border-transparent transition-all duration-200 ease-out group-data-[kaydirildi=true]:mt-2.5 group-data-[kaydirildi=true]:rounded-md group-data-[kaydirildi=true]:border-slate-900/15 group-data-[kaydirildi=true]:bg-white/85 group-data-[kaydirildi=true]:shadow-md group-data-[kaydirildi=true]:shadow-slate-900/10 group-data-[kaydirildi=true]:backdrop-blur-md motion-reduce:transition-none dark:group-data-[kaydirildi=true]:border-white/15 dark:group-data-[kaydirildi=true]:bg-slate-900/85 dark:group-data-[kaydirildi=true]:shadow-black/30"
		>
			<nav
				aria-label="Ana gezinme"
				class="flex h-20 items-center justify-between gap-3 px-2 transition-all duration-200 ease-out group-data-[kaydirildi=true]:h-14 group-data-[kaydirildi=true]:px-2.5 motion-reduce:transition-none"
			>
				<!-- Marka -->
				<a
					href="/"
					class="flex shrink-0 items-center gap-2.5 rounded-md px-1.5 py-1 font-semibold tracking-tight text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-marka-500 dark:text-white"
				>
					<span
						class="grid size-9 place-items-center rounded-md bg-marka-600 text-sm font-bold text-white shadow-sm transition-all duration-200 ease-out group-data-[kaydirildi=true]:size-8 motion-reduce:transition-none"
						aria-hidden="true">M</span
					>
					<span>Mustafa</span>
				</a>

				<!-- Masaüstü bağlantıları -->
				<ul class="hidden items-center gap-1 md:flex">
					{
						baglantilar.map((baglanti) => (
							<li>
								<a
									href={baglanti.yol}
									aria-current={aktifMi(baglanti.yol) ? 'page' : undefined}
									class:list={[bagTemel, aktifMi(baglanti.yol) ? bagAktif : bagPasif]}
								>
									{baglanti.ad}
								</a>
							</li>
						))
					}
				</ul>

				<!-- Eylemler -->
				<div class="flex shrink-0 items-center gap-0.5">
					<a href="/rss.xml" aria-label="RSS akışı" class={eylemDugmesi}>
						<Icon name="lucide:rss" class="size-[18px]" />
					</a>

					<button id="tema-dugmesi" type="button" aria-label="Koyu temaya geç" class={eylemDugmesi}>
						<Icon name="lucide:moon" class="size-[18px] dark:hidden" />
						<Icon name="lucide:sun" class="hidden size-[18px] dark:block" />
					</button>

					<button
						id="menu-dugmesi"
						type="button"
						class={`${eylemDugmesi} group/dugme md:hidden`}
						aria-expanded="false"
						aria-controls="mobil-menu"
						aria-label="Menüyü aç"
					>
						<Icon name="lucide:menu" class="size-5 group-aria-expanded/dugme:hidden" />
						<Icon name="lucide:x" class="hidden size-5 group-aria-expanded/dugme:block" />
					</button>
				</div>
			</nav>

			<!-- Mobil menü: kapsülün içinde açılır, böylece yuvarlatılmış form bozulmaz -->
			<div id="mobil-menu" class="hidden border-t border-slate-900/10 md:hidden dark:border-white/10">
				<ul class="space-y-1 p-2">
					{
						baglantilar.map((baglanti) => (
							<li>
								<a
									href={baglanti.yol}
									aria-current={aktifMi(baglanti.yol) ? 'page' : undefined}
									class:list={[
										'block',
										bagTemel,
										aktifMi(baglanti.yol) ? bagAktif : bagPasif,
									]}
								>
									{baglanti.ad}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</header>

{/* Çubuk fixed olduğu için sayfa içeriğinin altına kaymasını engelleyen boşluk. */}
<div class="h-20" aria-hidden="true"></div>

<script>
	const ustCubuk = document.getElementById('ust-cubuk');
	const menuDugmesi = document.getElementById('menu-dugmesi');
	const mobilMenu = document.getElementById('mobil-menu');
	const temaDugmesi = document.getElementById('tema-dugmesi');

	// --- Kaydırma durumu -----------------------------------------------------
	// 32 piksel, hero'dan ayrıldığını anlamak için yeterli; daha küçük bir eşik
	// dokunmatik cihazlarda esneme hareketinde çubuğu titretiyor.
	const ESIK = 32;

	// Bilinçli olarak requestAnimationFrame ile kısıtlamıyoruz: rAF'ın duraklatıldığı
	// durumlarda (arka plan sekmesi, gömülü çerçeve) bekleme bayrağı kilitlenip çubuğu
	// kalıcı olarak donduruyordu. Yapılan iş yalnızca bir karşılaştırma; değer
	// değişmediğinde DOM'a hiç yazmıyoruz, dolayısıyla her olayda çalışması güvenli.
	function kaydirmayiUygula() {
		if (!ustCubuk) return;
		const yeniDurum = window.scrollY > ESIK ? 'true' : 'false';
		if (ustCubuk.dataset.kaydirildi !== yeniDurum) ustCubuk.dataset.kaydirildi = yeniDurum;
	}

	window.addEventListener('scroll', kaydirmayiUygula, { passive: true });
	kaydirmayiUygula();

	// --- Mobil menü ----------------------------------------------------------
	function menuyuAyarla(acik: boolean) {
		if (!menuDugmesi || !mobilMenu) return;
		menuDugmesi.setAttribute('aria-expanded', String(acik));
		menuDugmesi.setAttribute('aria-label', acik ? 'Menüyü kapat' : 'Menüyü aç');
		mobilMenu.classList.toggle('hidden', !acik);
	}

	menuDugmesi?.addEventListener('click', () => {
		menuyuAyarla(menuDugmesi.getAttribute('aria-expanded') !== 'true');
	});

	// Esc menüyü kapatır ve odağı butona geri verir.
	document.addEventListener('keydown', (olay) => {
		if (olay.key === 'Escape' && menuDugmesi?.getAttribute('aria-expanded') === 'true') {
			menuyuAyarla(false);
			menuDugmesi.focus();
		}
	});

	// Menü açıkken dışarı tıklanırsa kapansın.
	document.addEventListener('click', (olay) => {
		if (menuDugmesi?.getAttribute('aria-expanded') !== 'true') return;
		const hedef = olay.target as Node;
		if (!ustCubuk?.contains(hedef)) menuyuAyarla(false);
	});

	// Masaüstü genişliğine geçildiğinde açık kalan mobil menüyü sıfırla.
	window.matchMedia('(min-width: 48rem)').addEventListener('change', (olay) => {
		if (olay.matches) menuyuAyarla(false);
	});

	// --- Tema ----------------------------------------------------------------
	function temaEtiketiniGuncelle() {
		const koyu = document.documentElement.classList.contains('dark');
		temaDugmesi?.setAttribute('aria-label', koyu ? 'Açık temaya geç' : 'Koyu temaya geç');
	}

	temaDugmesi?.addEventListener('click', () => {
		const koyu = document.documentElement.classList.toggle('dark');
		localStorage.setItem('tema', koyu ? 'koyu' : 'acik');
		temaEtiketiniGuncelle();
	});

	temaEtiketiniGuncelle();
</script>
