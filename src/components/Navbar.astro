---
import { Icon } from 'astro-icon/components';
import IletisimDugmesi from './IletisimDugmesi.astro';
import { cevirici, digerDilYolu, dilBul, taban, yol } from '@/i18n/ceviriler';

const dil = dilBul(Astro.url);
const m = cevirici(dil);
const hakkimdaParcasi = dil === 'en' ? 'about' : 'hakkimda';
const iletisimCapasi = dil === 'en' ? '#contact' : '#iletisim';

// Gezinme bağlantıları. Yeni sayfa eklediğinde buraya bir satır eklemen yeterli;
// hem masaüstü hem mobil menü bu listeden üretilir.
const baglantilar = [
	{ ad: m('nav.anasayfa'), yol: yol(dil, '') },
	{ ad: m('nav.blog'), yol: yol(dil, 'blog') },
	{ ad: m('nav.hakkimda'), yol: yol(dil, hakkimdaParcasi) },
];

const suAnkiYol = Astro.url.pathname;
const digerDil = dil === 'tr' ? 'en' : 'tr';
const digerDilBaglantisi = digerDilYolu(Astro.url, digerDil);

// Kök sayfalar yalnızca tam eşleşmede aktiftir; diğerleri alt sayfalarında da
// aktif kalır (örn. /blog/merhaba-dunya/ açıkken "Blog" vurgulu görünür).
function aktifMi(hedef: string) {
	const sadelestir = (s: string) => s.replace(/\/+$/, '') || '/';
	const h = sadelestir(hedef);
	const p = sadelestir(suAnkiYol);
	if (h === '/' || h === '/en') return p === h;
	return p === h || p.startsWith(`${h}/`);
}

// Tipografi ölçeği. Önceki sürümde marka, bağlantılar ve düğme aynı 20px'teydi;
// hepsi eşit ağırlıkta görününce göz nereye bakacağını bulamıyordu. Swiss tipografi
// mantığıyla üç kademe: marka 17/600, gezinme 15/500, yardımcı eylemler ikon.
// Dolgu, kayan göstergenin çizdiği alanı belirliyor: metnin çevresinde 18px yatay,
// 11px dikey nefes payı bırakıyor ki vurgu metne yapışık görünmesin.
// Renk geçişindeki 110 ms'lik gecikme bilinçli: gösterge kayarken metin hemen
// karşıt renge dönerse, gösterge daha gelmeden beyaz yazı açık zeminde kalıyor
// ve kısa süre okunmuyor. Gecikme, rengin göstergeyle birlikte değişmesini sağlar.
const bagTemel =
	'relative rounded-lg px-[18px] py-[11px] text-[15px] leading-5 font-medium transition-colors delay-[110ms] duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current';

// Göstergenin üzerinde durduğu bağlantı karşıt renge geçer; bunu JS belirler
// (data-vurgulu), çünkü gösterge ayrı bir öğe ve imleci izliyor.
const bagAktifMasaustu =
	'text-slate-900 data-vurgulu:text-white dark:text-white dark:data-vurgulu:text-slate-900';
const bagPasifMasaustu =
	'text-slate-600 data-vurgulu:text-white dark:text-neutral-300 dark:data-vurgulu:text-slate-900';
const bagAktifMobil = 'bg-slate-900/10 text-slate-900 dark:bg-white/15 dark:text-white';
const bagPasifMobil =
	'text-slate-600 hover:bg-slate-900/5 hover:text-slate-900 dark:text-neutral-300 dark:hover:bg-white/10 dark:hover:text-white';

// İkon düğmeleri 40px: WCAG 2.2 AA web için 24px istiyor, ancak dokunmatikte
// 40-44px aralığı isabet hatasını belirgin biçimde azaltıyor.
const eylemDugmesi =
	'grid size-10 cursor-pointer place-items-center rounded-lg text-slate-600 transition-colors hover:bg-slate-900/5 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current dark:text-neutral-300 dark:hover:bg-white/10 dark:hover:text-white';

// Birincil eylem: gri (#D9D9D9) zemin üzerinde koyu metin yalnızca 1.9:1 veriyordu.
// Tam kontrastlı solid zemin hem 15:1 üzerine çıkıyor hem düğmeyi tek birincil
// eylem olarak okutuyor.
const iletisimDugmesi =
	'hidden h-10 shrink-0 cursor-pointer items-center rounded-lg bg-slate-900 px-5 text-[15px] leading-5 font-medium text-white transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current md:inline-flex dark:bg-white dark:text-neutral-900 dark:hover:bg-white/85';
---

{/*
  Çubuk iki durum arasında geçiş yapar ve durum `data-kaydirildi` ile taşınır:
  - "false" (sayfanın tepesi / hero): tam genişlik, zeminsiz, yüksek
  - "true"  (aşağı kaydırılmış): ortada yüzen, dar, yuvarlatılmış, bulanık zeminli kapsül
  Alt öğeler bu duruma `group-data-[kaydirildi=true]:` ile tepki verir.
*/}
<header id="ust-cubuk" data-kaydirildi="false" class="group fixed inset-x-0 top-0 z-50">
	<div
		class="mx-auto w-full max-w-[1352px] px-4 transition-all duration-200 ease-out group-data-[kaydirildi=true]:max-w-[1232px] motion-reduce:transition-none sm:px-6 group-data-[kaydirildi=true]:sm:px-4"
	>
		{/*
		  Tasarımdaki çerçeve: 1200x80, rgba(255,255,255,0.1) zemin, 1px beyaz kenarlık,
		  15px köşe. Zemin ve kenarlık yalnızca kaydırıldığında beliriyor; sayfanın
		  tepesinde çubuk saydam kalıyor. Beyaz değerler koyu zemin içindir, açık temada
		  aynı ilişkinin koyu karşılığı kullanılır.
		*/}
		<div
			class="overflow-hidden rounded-xl border border-transparent transition-all duration-200 ease-out group-data-[menu-acik=true]:border-slate-900/10 group-data-[menu-acik=true]:bg-white group-data-[menu-acik=true]:shadow-lg md:group-data-[menu-acik=true]:backdrop-blur-xl dark:group-data-[menu-acik=true]:border-white/15 dark:group-data-[menu-acik=true]:bg-slate-950 group-hover:border-slate-900/10 group-hover:bg-white/60 md:group-hover:backdrop-blur-xl group-data-[kaydirildi=true]:mt-3 group-data-[kaydirildi=true]:border-slate-900/10 group-data-[kaydirildi=true]:bg-white/95 md:group-data-[kaydirildi=true]:bg-white/70 group-data-[kaydirildi=true]:shadow-sm group-data-[kaydirildi=true]:shadow-slate-900/5 md:group-data-[kaydirildi=true]:backdrop-blur-xl motion-reduce:transition-none dark:group-hover:border-white/15 dark:group-hover:bg-slate-950/60 dark:group-data-[kaydirildi=true]:border-white/15 dark:group-data-[kaydirildi=true]:bg-slate-950/95 md:dark:group-data-[kaydirildi=true]:bg-slate-950/70"
		>
			<nav
				aria-label={dil === 'en' ? 'Main navigation' : 'Ana gezinme'}
				class="flex h-[62px] items-center justify-between gap-4 pr-3 pl-4 sm:pr-4 sm:pl-6"
			>
				<!-- Marka -->
				<a
					href={yol(dil, '')}
					class="inline-flex h-10 shrink-0 items-center rounded-lg text-[17px] leading-6 font-semibold tracking-tight whitespace-nowrap text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current dark:text-white"
				>
					Mustafa Eybek
				</a>

				<!-- Masaüstü bağlantıları: zemini, imleci izleyen tek bir gösterge çizer -->
				{/*
				  Bağlantılar tek bir küme olarak duruyor. Önceki 80px'lik aralık onları
				  birbirinden kopuk üç ayrı öğe gibi gösteriyordu; yakın yerleşim hem
				  gruplandırmayı hem de gösterge kaymasının okunabilirliğini artırıyor.
				*/}
				<ul id="menu-listesi" class="relative hidden items-center gap-2 md:flex">
					{/*
					  Gösterge opak: açık temada siyah, koyu temada beyaz. Üzerindeki
					  bağlantının metni karşıt renge geçtiği için kontrast korunuyor
					  (siyah zemin + beyaz yazı 16:1 üzerinde).
					*/}
					<span
						id="gosterge"
						class="gosterge pointer-events-none absolute top-0 left-0 h-full rounded-lg bg-slate-900 dark:bg-white"
						aria-hidden="true"></span>
					{
						baglantilar.map((baglanti) => (
							<li class="relative">
								<a
									href={baglanti.yol}
									data-menu-bag
									aria-current={aktifMi(baglanti.yol) ? 'page' : undefined}
									class:list={[
										bagTemel,
										aktifMi(baglanti.yol) ? bagAktifMasaustu : bagPasifMasaustu,
									]}
								>
									{baglanti.ad}
								</a>
							</li>
						))
					}
				</ul>

				<!-- Eylemler -->
				<div class="flex shrink-0 items-center gap-2">
					<a href={`${taban}/rss.xml`} aria-label={m('nav.rss')} class={eylemDugmesi}>
						<Icon name="lucide:rss" class="size-[18px]" />
					</a>

					<button id="tema-dugmesi" type="button" aria-label={m('nav.koyuTema')} class={eylemDugmesi}>
						<Icon name="lucide:moon" class="size-[18px] dark:hidden" />
						<Icon name="lucide:sun" class="hidden size-[18px] dark:block" />
					</button>

					{/* Dil değiştirici: karşı dilin kodunu gösterir, aynı sayfanın
					    o dildeki karşılığına gider. */}
					<a
						href={digerDilBaglantisi}
						hreflang={digerDil}
						aria-label={m('nav.dilDegistir')}
						data-dil-secimi={digerDil}
						class={`${eylemDugmesi} text-[13px] font-semibold tracking-wide`}
					>
						{digerDil.toUpperCase()}
					</a>

					{/* Sıvı metal düğme; dar ekranda gizlenip yerini mobil menüdeki
					    düz bağlantıya bırakıyor. */}
					<div class="hidden md:block">
						<IletisimDugmesi
							etiket={m('nav.iletisim')}
							hedef={`${yol(dil, hakkimdaParcasi)}${iletisimCapasi}`}
						/>
					</div>

					<button
						id="menu-dugmesi"
						type="button"
						class={`${eylemDugmesi} group/dugme md:hidden`}
						aria-expanded="false"
						aria-controls="mobil-menu"
						aria-label={m('nav.menuAc')}
						data-etiket-ac={m('nav.menuAc')}
						data-etiket-kapat={m('nav.menuKapat')}
					>
						<Icon name="lucide:menu" class="size-5 group-aria-expanded/dugme:hidden" />
						<Icon name="lucide:x" class="hidden size-5 group-aria-expanded/dugme:block" />
					</button>
				</div>
			</nav>

			<!-- Mobil menü: kapsülün içinde açılır, böylece yuvarlatılmış form bozulmaz -->
			<div id="mobil-menu" class="hidden border-t border-slate-900/10 md:hidden dark:border-white/10">
				<ul class="space-y-1 p-2">
					{
						baglantilar.map((baglanti) => (
							<li>
								<a
									href={baglanti.yol}
									aria-current={aktifMi(baglanti.yol) ? 'page' : undefined}
									class:list={[
										// Dar ekranda parmakla kullanıldığı için 44px'lik rahat bir hedef.
										'flex min-h-11 items-center',
										bagTemel,
										aktifMi(baglanti.yol) ? bagAktifMobil : bagPasifMobil,
									]}
								>
									{baglanti.ad}
								</a>
							</li>
						))
					}
					<li>
						{/* Masaüstündeki "İletişim" düğmesi dar ekranda gizlendiği için buraya taşınıyor. */}
						<a
							href={`${yol(dil, hakkimdaParcasi)}${iletisimCapasi}`}
							class="mt-2 grid h-11 place-items-center rounded-lg bg-slate-900 text-[15px] leading-5 font-medium text-white transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current dark:bg-white dark:text-neutral-900 dark:hover:bg-white/85"
						>
							{m('nav.iletisim')}
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>
</header>

{/* Çubuk fixed olduğu için sayfa içeriğinin altına kaymasını engelleyen boşluk:
    62px gezinme + 1px üst ve alt kenarlık. */}
<div class="h-16" aria-hidden="true"></div>

<style>
	/* Kayan gösterge. Konum ve genişlik CSS değişkenleriyle sürülür; JS yalnızca
	   bu iki değeri yazar. Zamanlama eğrisi sonda hedefi hafifçe aşarak yay hissi verir. */
	/* Yükseklik ve dikey konum da ölçülerek veriliyor: `height: 100%` bağlantının
	   kutusunu değil listenin kutusunu izliyordu ve vurgu metne yapışık kalıyordu. */
	.gosterge {
		width: var(--gosterge-w, 0px);
		height: var(--gosterge-h, 100%);
		translate: var(--gosterge-x, 0px) var(--gosterge-y, 0px);
		opacity: 0;
		transition:
			translate 250ms cubic-bezier(1, 0.2, 0.1, 1.2),
			width 250ms cubic-bezier(1, 0.2, 0.1, 1.2),
			height 250ms cubic-bezier(1, 0.2, 0.1, 1.2),
			opacity 150ms ease;
	}

	.gosterge[data-gorunur='true'] {
		opacity: 1;
	}

	/* Yapışkan his: gösterge yer değiştirirken hareket ekseninde uzayıp dik eksende
	   inceliyor, sonra toparlanıyor. `scale` bağımsız bir özellik olduğu için
	   `translate` ile çakışmaz — ikisi aynı anda sürülebilir. */
	.gosterge[data-akiyor='true'] {
		animation: gooey-yatay 250ms 1;
	}

	@keyframes gooey-yatay {
		0% {
			scale: 1 1;
		}
		45% {
			scale: 1.22 0.72;
		}
		100% {
			scale: 1 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gosterge {
			transition: opacity 150ms ease;
		}
		.gosterge[data-akiyor='true'] {
			animation: none;
		}
	}
</style>

<script>
	const ustCubuk = document.getElementById('ust-cubuk');
	const menuDugmesi = document.getElementById('menu-dugmesi');
	const mobilMenu = document.getElementById('mobil-menu');
	const temaDugmesi = document.getElementById('tema-dugmesi');

	// --- Kaydırma durumu -----------------------------------------------------
	// 32 piksel, hero'dan ayrıldığını anlamak için yeterli; daha küçük bir eşik
	// dokunmatik cihazlarda esneme hareketinde çubuğu titretiyor.
	const ESIK = 32;

	// Bilinçli olarak requestAnimationFrame ile kısıtlamıyoruz: rAF'ın duraklatıldığı
	// durumlarda (arka plan sekmesi, gömülü çerçeve) bekleme bayrağı kilitlenip çubuğu
	// kalıcı olarak donduruyordu. Yapılan iş yalnızca bir karşılaştırma; değer
	// değişmediğinde DOM'a hiç yazmıyoruz, dolayısıyla her olayda çalışması güvenli.
	function kaydirmayiUygula() {
		if (!ustCubuk) return;
		const yeniDurum = window.scrollY > ESIK ? 'true' : 'false';
		if (ustCubuk.dataset.kaydirildi !== yeniDurum) ustCubuk.dataset.kaydirildi = yeniDurum;
	}

	window.addEventListener('scroll', kaydirmayiUygula, { passive: true });
	kaydirmayiUygula();

	// --- Mobil menü ----------------------------------------------------------
	const menuAcikEtiketi = menuDugmesi?.dataset.etiketKapat ?? 'Menüyü kapat';
	const menuKapaliEtiketi = menuDugmesi?.dataset.etiketAc ?? 'Menüyü aç';

	function menuOgeleri(): HTMLElement[] {
		if (!mobilMenu) return [];
		return [...mobilMenu.querySelectorAll<HTMLElement>('a[href]')];
	}

	function menuyuAyarla(acik: boolean) {
		if (!menuDugmesi || !mobilMenu) return;
		menuDugmesi.setAttribute('aria-expanded', String(acik));
		menuDugmesi.setAttribute('aria-label', acik ? menuAcikEtiketi : menuKapaliEtiketi);
		mobilMenu.classList.toggle('hidden', !acik);
		// Panelin arkasi saydam kalmasin diye kapsule zemin veren durum.
		if (ustCubuk) ustCubuk.dataset.menuAcik = String(acik);
		// Menü açıkken arka planın kayması, açılan panelin sabit durması yüzünden
		// kopuk bir his veriyordu; sayfa kaydırması kilitleniyor.
		document.documentElement.classList.toggle('menu-acik', acik);
	}

	menuDugmesi?.addEventListener('click', () => {
		const acilacak = menuDugmesi.getAttribute('aria-expanded') !== 'true';
		menuyuAyarla(acilacak);
		// Odak menüye taşınmazsa klavyeyle gezen kullanıcı, açtığı menüye
		// ulaşmak için sayfanın başından tab'lamak zorunda kalıyordu.
		if (acilacak) menuOgeleri()[0]?.focus();
	});

	// Menü açıkken odak panelin içinde dönsün; arkadaki öğelere geçmesin.
	mobilMenu?.addEventListener('keydown', (olay) => {
		if (olay.key !== 'Tab' || !menuDugmesi) return;
		const ogeler = [menuDugmesi, ...menuOgeleri()];
		const ilk = ogeler[0];
		const son = ogeler[ogeler.length - 1];
		const etkin = document.activeElement;
		if (olay.shiftKey && etkin === ilk) {
			olay.preventDefault();
			son.focus();
		} else if (!olay.shiftKey && etkin === son) {
			olay.preventDefault();
			ilk.focus();
		}
	});

	// Esc menüyü kapatır ve odağı butona geri verir.
	document.addEventListener('keydown', (olay) => {
		if (olay.key === 'Escape' && menuDugmesi?.getAttribute('aria-expanded') === 'true') {
			menuyuAyarla(false);
			menuDugmesi.focus();
		}
	});

	// Menü açıkken dışarı tıklanırsa kapansın.
	document.addEventListener('click', (olay) => {
		if (menuDugmesi?.getAttribute('aria-expanded') !== 'true') return;
		const hedef = olay.target as Node;
		if (!ustCubuk?.contains(hedef)) menuyuAyarla(false);
	});

	// Masaüstü genişliğine geçildiğinde açık kalan mobil menüyü sıfırla.
	window.matchMedia('(min-width: 48rem)').addEventListener('change', (olay) => {
		if (olay.matches) menuyuAyarla(false);
	});

	// --- Tema ----------------------------------------------------------------
	function temaEtiketiniGuncelle() {
		const koyu = document.documentElement.classList.contains('dark');
		temaDugmesi?.setAttribute('aria-label', koyu ? 'Açık temaya geç' : 'Koyu temaya geç');
	}

	temaDugmesi?.addEventListener('click', () => {
		const koyu = document.documentElement.classList.toggle('dark');
		localStorage.setItem('tema', koyu ? 'koyu' : 'acik');
		temaEtiketiniGuncelle();
	});

	temaEtiketiniGuncelle();

	// --- Kayan gösterge ------------------------------------------------------
	const menuListesi = document.getElementById('menu-listesi');
	const gosterge = document.getElementById('gosterge');
	const menuBaglantilari = menuListesi
		? [...menuListesi.querySelectorAll<HTMLAnchorElement>('a[data-menu-bag]')]
		: [];
	const aktifBaglanti = menuListesi?.querySelector<HTMLAnchorElement>('a[aria-current="page"]');

	function gostergeyiTasi(hedef: HTMLElement, akitMi = true) {
		if (!menuListesi || !gosterge) return;
		// Konum listeye göre ölçülür; bağlantılar eşit genişlikte olmadığı için
		// sabit bölme yerine gerçek kutu ölçüleri kullanılıyor.
		const listeKutusu = menuListesi.getBoundingClientRect();
		const hedefKutusu = hedef.getBoundingClientRect();
		gosterge.style.setProperty('--gosterge-x', `${hedefKutusu.left - listeKutusu.left}px`);
		gosterge.style.setProperty('--gosterge-y', `${hedefKutusu.top - listeKutusu.top}px`);
		gosterge.style.setProperty('--gosterge-w', `${hedefKutusu.width}px`);
		gosterge.style.setProperty('--gosterge-h', `${hedefKutusu.height}px`);
		gosterge.dataset.gorunur = 'true';

		// Göstergenin üzerinde durduğu bağlantı karşıt renge geçsin.
		menuBaglantilari.forEach((bag) => bag.removeAttribute('data-vurgulu'));
		hedef.setAttribute('data-vurgulu', '');
		if (!akitMi) return;
		// Aynı animasyonu yeniden tetiklemek için sıfırlayıp yeniden başlatıyoruz.
		gosterge.dataset.akiyor = 'false';
		void gosterge.offsetWidth;
		gosterge.dataset.akiyor = 'true';
	}

	function gostergeyiAktifeAl(akitMi = true) {
		if (!gosterge) return;
		if (aktifBaglanti) {
			gostergeyiTasi(aktifBaglanti, akitMi);
		} else {
			// Bu sayfaya karşılık gelen bağlantı yoksa gösterge gizlenir ve
			// hiçbir bağlantı karşıt renkte kalmaz.
			gosterge.dataset.gorunur = 'false';
			menuBaglantilari.forEach((bag) => bag.removeAttribute('data-vurgulu'));
		}
	}

	if (menuListesi && gosterge) {
		menuBaglantilari.forEach((bag) => {
			bag.addEventListener('mouseenter', () => gostergeyiTasi(bag));
			bag.addEventListener('focus', () => gostergeyiTasi(bag));
		});

		menuListesi.addEventListener('mouseleave', () => gostergeyiAktifeAl());
		menuListesi.addEventListener('focusout', (olay) => {
			if (!menuListesi.contains(olay.relatedTarget as Node)) gostergeyiAktifeAl();
		});

		// İlk yerleşim animasyonsuz olmalı; aksi hâlde sayfa açılırken gösterge
		// sol kenardan hedefe doğru süzülüyor.
		gosterge.style.transition = 'none';
		gostergeyiAktifeAl(false);
		void gosterge.offsetWidth;
		gosterge.style.transition = '';

		window.addEventListener('resize', () => gostergeyiAktifeAl(false), { passive: true });

		// Bağlantı metinleri sayfa yüklendikten sonra da değişebiliyor: tarayıcının
		// sayfa çevirisi metinleri değiştiriyor ("Home" -> "Ev") ve gösterge eski
		// genişlikte kalıp komşu bağlantının üzerine taşıyordu. Metin değişimini
		// izleyip yeniden ölçüyoruz. Öznitelik değişiklikleri izlenmiyor; aksi hâlde
		// göstergenin kendi stil güncellemesi sonsuz döngü yaratırdı.
		const metinGozlemcisi = new MutationObserver(() => gostergeyiAktifeAl(false));
		metinGozlemcisi.observe(menuListesi, {
			childList: true,
			subtree: true,
			characterData: true,
		});

		// Yazı tipi geç yüklenirse ölçüler kayıyor; hazır olduğunda bir kez daha.
		document.fonts?.ready.then(() => gostergeyiAktifeAl(false));
	}
</script>
