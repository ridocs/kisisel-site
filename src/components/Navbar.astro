---
import { Icon } from 'astro-icon/components';
import CubukDugmesi from './CubukDugmesi.astro';
import { cevirici, digerDilYolu, dilBul, taban, yol } from '@/i18n/ceviriler';

const dil = dilBul(Astro.url);
const m = cevirici(dil);
const hakkimdaParcasi = dil === 'en' ? 'about' : 'hakkimda';
const iletisimCapasi = dil === 'en' ? '#contact' : '#iletisim';

// Gezinme bağlantıları. Yeni sayfa eklediğinde buraya bir satır eklemen yeterli;
// hem masaüstü hem mobil menü bu listeden üretilir.
/*
  MASAÜSTÜ ve MOBİL listeleri ayrı.

  Çubukta artık BEŞ bağlantı var. Önce dördü vardı ve buradaki yorum "beşinci
  sıkışır" diyordu; kapsül genişletildi (aşağıdaki `max-w`) ve masaüstü
  eşiği yükseltildi.

  EŞİK 768 DEĞİL 1024 — ölçülerek bulundu. Parçalar şu genişlikte:
  marka 110px + beş bağlantı 472px + sağdaki düğmeler 240px, artı boşluk ve
  dolgu = en az 926 piksel ekran gerekiyor. Menü 768'den itibaren açılsaydı
  768-925 arasında taşardı. Bu yüzden `md:flex` yerine `lg:flex`; o aralıkta
  mobil menü devrede ve orada satır sayısı sorun değil.

  Betikteki `matchMedia` eşiği de aynı değerde olmak zorunda: ayrışırsa menü
  görünürken betik onu kapalı sayar ve odak yönetimi bozulur.

  Mobil menü dikey açılan bir liste, orada satır sayısı sorun değil —
  Kullandıklarım yalnızca orada.

  Yeni sayfa eklerken hangi listeye gireceğine karar ver: çubuk birincil
  sayfalar için, mobil menü sitenin tamamı için. Altıncı bağlantıdan önce
  ölçüm yap; genişletmenin de bir sınırı var.
*/
/** `rol` isteğe bağlı: yalnızca aynı sayfayı paylaşan iki bağlantı taşıyor. */
type GezinmeBaglantisi = { ad: string; yol: string; rol?: 'hakkimda' | 'iletisim' };

const masaustuBaglantilari: GezinmeBaglantisi[] = [
	{ ad: m('nav.anasayfa'), yol: yol(dil, '') },
	{ ad: m('nav.hizmetler'), yol: yol(dil, dil === 'en' ? 'services' : 'hizmetler') },
	{ ad: m('nav.projeler'), yol: yol(dil, dil === 'en' ? 'projects' : 'projeler') },
	{ ad: m('nav.blog'), yol: yol(dil, 'blog') },
	/*
	  `rol` YALNIZCA bu iki bağlantıda var ve betiğin onları metne bakmadan
	  bulması için. İkisi de aynı sayfaya gidiyor, dolayısıyla hangisinin
	  vurgulanacağı adresten çıkarılamıyor; kaydırma konumuna bağlı.
	*/
	{ ad: m('nav.hakkimda'), yol: yol(dil, hakkimdaParcasi), rol: 'hakkimda' },
	/*
	  İletişim 2026-09-20'de buraya girdi. Önce çubuğun sağındaki vurgulu
	  düğmeydi; orayı "Giriş Yap" alınca iletişimin menüde bir yeri olması
	  gerekti — yoksa üst çubuktan hiç erişilemiyordu.
	*/
	{
		ad: m('nav.iletisim'),
		yol: `${yol(dil, hakkimdaParcasi)}${iletisimCapasi}`,
		rol: 'iletisim',
	},
];

const mobilBaglantilar = [
	...masaustuBaglantilari,
	{ ad: m('nav.kullandiklarim'), yol: yol(dil, dil === 'en' ? 'uses' : 'kullandiklarim') },
];

const suAnkiYol = Astro.url.pathname;
const digerDil = dil === 'tr' ? 'en' : 'tr';
/*
  Dil düğmesinin gideceği adres.

  `digerDilYolu` adresi öteki dile çevirerek buluyor ve durağan sayfalarda
  doğru çalışıyor. YAZILARDA çalışmıyor: çeviri adları farklı
  (`merhaba-dunya` ↔ `hello-world`) ve bazı yazının çevirisi hiç yok. Dart
  yazısında EN'e basan ziyaretçi var olmayan bir adrese gidip 404 alıyordu.

  Düzen bu yüzden gerçek adresi `dilBagi` ile geçiriyor. `null` gelirse
  düğme hiç basılmıyor: çalışmayan bir düğme, olmayan düğmeden kötü.
*/
interface Props {
	/** Düzen veriyor: yazılarda gerçek çeviri adresi, çevirisi yoksa null. */
	dilBagi?: string | null;
}

const { dilBagi } = Astro.props;
const digerDilBaglantisi =
	dilBagi !== undefined ? dilBagi : digerDilYolu(Astro.url, digerDil);

const sadelestir = (s: string) => s.replace(/\/+$/, '') || '/';

/*
  Bu dilin kök yolu. Site bir alt dizinde yayınlandığı için "/" değil
  "/web-sitem" (İngilizcede "/web-sitem/en"). Değer elle yazılmıyor, ana sayfa
  bağlantısının kendisinden türetiliyor — `base` değişirse burası da uyar.
*/
const kokYol = sadelestir(yol(dil, ''));

/*
  Kök sayfa YALNIZCA tam eşleşmede aktiftir; diğerleri alt sayfalarında da
  aktif kalır (örn. /blog/merhaba-dunya/ açıkken "Blog" vurgulu görünür).

  Kök kontrolü daha önce düz "/" ile yapılıyordu. Alt dizinde yayınlanınca kök
  "/web-sitem" oluyor ve öbür her adres onunla başladığı için ANA SAYFA her
  sayfada aktif görünüyordu — gösterge de imleç ayrılınca oraya dönüyordu.
*/
function aktifMi(hedef: string) {
	const h = sadelestir(hedef);
	const p = sadelestir(suAnkiYol);
	if (h === kokYol) return p === h;
	return p === h || p.startsWith(`${h}/`);
}

// Tipografi ölçeği. Önceki sürümde marka, bağlantılar ve düğme aynı 20px'teydi;
// hepsi eşit ağırlıkta görününce göz nereye bakacağını bulamıyordu. Swiss tipografi
// mantığıyla üç kademe: marka 17/600, gezinme 15/500, yardımcı eylemler ikon.
// Dolgu, kayan göstergenin çizdiği alanı belirliyor: metnin çevresinde 18px yatay,
// 11px dikey nefes payı bırakıyor ki vurgu metne yapışık görünmesin.
// Renk geçişindeki 110 ms'lik gecikme bilinçli: gösterge kayarken metin hemen
// karşıt renge dönerse, gösterge daha gelmeden beyaz yazı açık zeminde kalıyor
// ve kısa süre okunmuyor. Gecikme, rengin göstergeyle birlikte değişmesini sağlar.
const bagTemel =
	'relative rounded-lg px-4 py-2 text-[14px] leading-5 font-medium transition-colors delay-[110ms] duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current';

// Göstergenin üzerinde durduğu bağlantı karşıt renge geçer; bunu JS belirler
// (data-vurgulu), çünkü gösterge ayrı bir öğe ve imleci izliyor.
const bagAktifMasaustu =
	'text-slate-900 data-vurgulu:text-white dark:text-white dark:data-vurgulu:text-slate-900';
const bagPasifMasaustu =
	'text-slate-600 data-vurgulu:text-white dark:text-neutral-300 dark:data-vurgulu:text-slate-900';
const bagAktifMobil = 'bg-slate-900/10 text-slate-900 dark:bg-white/15 dark:text-white';
const bagPasifMobil =
	'text-slate-600 hover:bg-slate-900/5 hover:text-slate-900 dark:text-neutral-300 dark:hover:bg-white/10 dark:hover:text-white';

// Dar ekranda 40px kalıyor: WCAG 2.2 AA web için 24px istiyor, ancak
// dokunmatikte 40-44px aralığı isabet hatasını belirgin biçimde azaltıyor.
// Masaüstünde 36px — fareyle hedefleme sorun değil ve çubuk inceliyor.
const eylemDugmesi =
	'grid size-10 cursor-pointer place-items-center rounded-lg text-slate-600 transition-colors hover:bg-slate-900/5 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current md:size-9 dark:text-neutral-300 dark:hover:bg-white/10 dark:hover:text-white';

/*
  KAYDIRMAYA BAĞLI AKTİFLİK — yalnızca hakkımda sayfasında.

  "Hakkımda" ve "İletişim" aynı sayfaya gidiyor; ikincisi bir çapa. Adrese
  bakan `aktifMi` bu yüzden hep "Hakkımda"yı işaretliyor ve bu SUNUCU TARAFI
  varsayılanı doğru: betik hiç çalışmazsa sayfa yine kullanılabilir, aktif
  işareti tek bir bağlantıda duruyor.

  Betik çalışırsa iletişim bölümü ekranın ortasına geldiğinde işaret
  "İletişim"e geçiyor. Kurulumun gerekip gerekmediği SUNUCUDA belli oluyor:
  aşağıdaki öznitelik yalnızca hakkımda sayfasında basılıyor, öbür sayfalarda
  betik hiç gözlemci kurmuyor.

  Değer çapanın kimliği ('#' olmadan) çünkü betik `getElementById` ile
  arayacak.
*/
const hakkimdaSayfasindaMi = aktifMi(yol(dil, hakkimdaParcasi));
const iletisimBolumuKimligi = hakkimdaSayfasindaMi ? iletisimCapasi.slice(1) : undefined;

// Not: Vurgulu düğmenin görünümü burada değil, CubukDugmesi.astro içinde
// tanımlı (sıvı metal kapsül). Burada bir zamanlar duran düz düğme sınıfı
// kullanılmadığı için kaldırıldı.
---

{/*
  Çubuk iki durum arasında geçiş yapar ve durum `data-kaydirildi` ile taşınır:
  - "false" (sayfanın tepesi / hero): tam genişlik, zeminsiz, yüksek
  - "true"  (aşağı kaydırılmış): ortada yüzen, dar, yuvarlatılmış, bulanık zeminli kapsül
  Alt öğeler bu duruma `group-data-[kaydirildi=true]:` ile tepki verir.
*/}
{/*
  Sınıf dizileri betiğe öznitelikle taşınıyor, betiğin içine ikinci kez
  YAZILMIYOR. İki yerde duran bir sınıf listesi kaçınılmaz olarak ayrışır:
  renk değiştiğinde biri güncellenip öbürü unutulur.
*/}
<header
	id="ust-cubuk"
	data-kaydirildi="false"
	data-iletisim-bolumu={iletisimBolumuKimligi}
	data-sinif-masaustu-aktif={bagAktifMasaustu}
	data-sinif-masaustu-pasif={bagPasifMasaustu}
	data-sinif-mobil-aktif={bagAktifMobil}
	data-sinif-mobil-pasif={bagPasifMobil}
	class="group fixed inset-x-0 top-0 z-50"
>
	<div
		class="mx-auto w-full max-w-[1480px] px-4 transition-all duration-200 ease-out group-data-[kaydirildi=true]:max-w-[1340px] motion-reduce:transition-none sm:px-6 group-data-[kaydirildi=true]:sm:px-4"
	>
		{/*
		  Koyu temada zeminler `neutral` ailesinden, `slate` DEĞİL: slate mavi
		  içeriyor ve çubuk koyu temada lacivert bir blok gibi duruyordu; mobil
		  menü açıldığında en belirgin hâliyle. Gövde zemini de `neutral-950`,
		  ikisi aynı aileden olmalı yoksa çubuk sayfadan kopuk bir renkte kalıyor.

		  Tasarımdaki çerçeve: 1200x80, rgba(255,255,255,0.1) zemin, 1px beyaz kenarlık,
		  15px köşe. Zemin ve kenarlık yalnızca kaydırıldığında beliriyor; sayfanın
		  tepesinde çubuk saydam kalıyor. Beyaz değerler koyu zemin içindir, açık temada
		  aynı ilişkinin koyu karşılığı kullanılır.
		*/}
		<div
			class="overflow-hidden rounded-xl border border-transparent transition-all duration-200 ease-out group-data-[menu-acik=true]:border-slate-900/10 group-data-[menu-acik=true]:bg-white group-data-[menu-acik=true]:shadow-lg md:group-data-[menu-acik=true]:backdrop-blur-xl dark:group-data-[menu-acik=true]:border-white/15 dark:group-data-[menu-acik=true]:bg-neutral-950 group-hover:border-slate-900/10 group-hover:bg-white/60 md:group-hover:backdrop-blur-xl group-data-[kaydirildi=true]:mt-3 group-data-[kaydirildi=true]:border-slate-900/10 group-data-[kaydirildi=true]:bg-white/95 md:group-data-[kaydirildi=true]:bg-white/70 group-data-[kaydirildi=true]:shadow-sm group-data-[kaydirildi=true]:shadow-slate-900/5 md:group-data-[kaydirildi=true]:backdrop-blur-xl motion-reduce:transition-none dark:group-hover:border-white/15 dark:group-hover:bg-neutral-950/60 dark:group-data-[kaydirildi=true]:border-white/15 dark:group-data-[kaydirildi=true]:bg-neutral-950/95 md:dark:group-data-[kaydirildi=true]:bg-neutral-950/70"
		>
			<nav
				aria-label={dil === 'en' ? 'Main navigation' : 'Ana gezinme'}
				class="flex h-[var(--cubuk-yuksekligi)] items-center justify-between gap-4 pr-3 pl-4 sm:pr-4 sm:pl-6"
			>
				<!-- Marka -->
				<a
					href={yol(dil, '')}
					class="inline-flex h-9 shrink-0 items-center rounded-lg text-[16px] leading-6 font-semibold tracking-tight whitespace-nowrap text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current dark:text-white"
				>
					Mustafa Eybek
				</a>

				<!-- Masaüstü bağlantıları: zemini, imleci izleyen tek bir gösterge çizer -->
				{/*
				  Bağlantılar tek bir küme olarak duruyor. Önceki 80px'lik aralık onları
				  birbirinden kopuk üç ayrı öğe gibi gösteriyordu; yakın yerleşim hem
				  gruplandırmayı hem de gösterge kaymasının okunabilirliğini artırıyor.
				*/}
				<ul id="menu-listesi" class="relative hidden items-center gap-2 lg:flex">
					{/*
					  Gösterge opak: açık temada siyah, koyu temada beyaz. Üzerindeki
					  bağlantının metni karşıt renge geçtiği için kontrast korunuyor
					  (siyah zemin + beyaz yazı 16:1 üzerinde).
					*/}
					<span
						id="gosterge"
						class="gosterge pointer-events-none absolute top-0 left-0 h-full rounded-lg bg-slate-900 dark:bg-white"
						aria-hidden="true"></span>
					{
						masaustuBaglantilari.map((baglanti) => (
							<li class="relative">
								<a
									href={baglanti.yol}
									data-menu-bag
									data-bag-rol={baglanti.rol}
									aria-current={aktifMi(baglanti.yol) ? 'page' : undefined}
									class:list={[
										bagTemel,
										aktifMi(baglanti.yol) ? bagAktifMasaustu : bagPasifMasaustu,
									]}
								>
									{baglanti.ad}
								</a>
							</li>
						))
					}
				</ul>

				<!-- Eylemler -->
				<div class="flex shrink-0 items-center gap-2">
					<a href={dil === 'en' ? `${taban}/en/rss.xml` : `${taban}/rss.xml`} aria-label={m('nav.rss')} class={eylemDugmesi}>
						<Icon name="lucide:rss" class="size-[18px]" />
					</a>

					<button id="tema-dugmesi" type="button" aria-label={m('nav.koyuTema')} class={eylemDugmesi}>
						<Icon name="lucide:moon" class="size-[18px] dark:hidden" />
						<Icon name="lucide:sun" class="hidden size-[18px] dark:block" />
					</button>

					{/* Dil değiştirici: karşı dilin kodunu gösterir, aynı sayfanın
					    o dildeki karşılığına gider. Karşılığı olmayan yazıda hiç
					    basılmıyor — 404'e giden bir düğme olmaz. */}
					{digerDilBaglantisi && (
					<a
						href={digerDilBaglantisi}
						hreflang={digerDil}
						aria-label={`${digerDil.toUpperCase()}, ${m('nav.dilDegistir')}`}
						data-dil-secimi={digerDil}
						class={`${eylemDugmesi} text-[13px] font-semibold tracking-wide`}
					>
						{digerDil.toUpperCase()}
					</a>
					)}

					{/*
					  Sıvı metal düğme; dar ekranda gizlenip yerini mobil menüdeki
					  karşılığına bırakıyor.

					  Adres `yol()` YERİNE doğrudan `taban` ile kuruluyor, çünkü panel
					  tek dilli: `/web-sitem/panel/`. `yol(dil, 'panel')` İngilizce
					  sayfalarda `/web-sitem/en/panel/` üretirdi ve orada bir şey yok.
					*/}
					<div class="hidden md:block">
						<CubukDugmesi etiket={m('nav.girisYap')} hedef={`${taban}/panel/`} />
					</div>

					<button
						id="menu-dugmesi"
						type="button"
						class={`${eylemDugmesi} group/dugme lg:hidden`}
						aria-expanded="false"
						aria-controls="mobil-menu"
						aria-label={m('nav.menuAc')}
						data-etiket-ac={m('nav.menuAc')}
						data-etiket-kapat={m('nav.menuKapat')}
					>
						<Icon name="lucide:menu" class="size-5 group-aria-expanded/dugme:hidden" />
						<Icon name="lucide:x" class="hidden size-5 group-aria-expanded/dugme:block" />
					</button>
				</div>
			</nav>

			<!-- Mobil menü: kapsülün içinde açılır, böylece yuvarlatılmış form bozulmaz -->
			<div id="mobil-menu" class="hidden border-t border-slate-900/10 lg:hidden dark:border-white/10">
				<ul class="space-y-1 p-2">
					{
						mobilBaglantilar.map((baglanti) => (
							<li>
								<a
									href={baglanti.yol}
									data-bag-rol={baglanti.rol}
									aria-current={aktifMi(baglanti.yol) ? 'page' : undefined}
									class:list={[
										// Dar ekranda parmakla kullanıldığı için 44px'lik rahat bir hedef.
										'flex min-h-11 items-center',
										bagTemel,
										aktifMi(baglanti.yol) ? bagAktifMobil : bagPasifMobil,
									]}
								>
									{baglanti.ad}
								</a>
							</li>
						))
					}
					<li>
						{/*
						  Masaüstündeki vurgulu düğmenin dar ekran karşılığı. İkisi de
						  aynı adrese gidiyor: iki yerde aynı düğmenin farklı davranması,
						  hangisinin doğru olduğunu belirsizleştirirdi.
						*/}
						<a
							href={`${taban}/panel/`}
							class="mt-2 grid h-11 w-full place-items-center rounded-lg bg-slate-900 text-[15px] leading-5 font-medium text-white transition-opacity hover:opacity-90 dark:bg-white dark:text-neutral-900"
						>
							{m('nav.girisYap')}
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>
</header>

{/* Çubuk fixed olduğu için sayfa içeriğinin altına kaymasını engelleyen boşluk:
    çubuk yüksekliği artı kenarlık payı. Yükseklik değişkenden geliyor, yoksa
    çubuk incelince burası eski ölçüde kalıp fazladan boşluk bırakıyordu. */}
<div class="h-[calc(var(--cubuk-yuksekligi)+0.5rem)]" aria-hidden="true"></div>

<style>
	/* Kayan gösterge. Konum ve genişlik CSS değişkenleriyle sürülür; JS yalnızca
	   bu iki değeri yazar. Zamanlama eğrisi sonda hedefi hafifçe aşarak yay hissi verir. */
	/* Yükseklik ve dikey konum da ölçülerek veriliyor: `height: 100%` bağlantının
	   kutusunu değil listenin kutusunu izliyordu ve vurgu metne yapışık kalıyordu. */
	.gosterge {
		width: var(--gosterge-w, 0px);
		height: var(--gosterge-h, 100%);
		translate: var(--gosterge-x, 0px) var(--gosterge-y, 0px);
		opacity: 0;
		transition:
			translate 250ms cubic-bezier(1, 0.2, 0.1, 1.2),
			width 250ms cubic-bezier(1, 0.2, 0.1, 1.2),
			height 250ms cubic-bezier(1, 0.2, 0.1, 1.2),
			opacity 150ms ease;
	}

	.gosterge[data-gorunur='true'] {
		opacity: 1;
	}

	/* Yapışkan his: gösterge yer değiştirirken hareket ekseninde uzayıp dik eksende
	   inceliyor, sonra toparlanıyor. `scale` bağımsız bir özellik olduğu için
	   `translate` ile çakışmaz — ikisi aynı anda sürülebilir. */
	.gosterge[data-akiyor='true'] {
		animation: gooey-yatay 250ms 1;
	}

	@keyframes gooey-yatay {
		0% {
			scale: 1 1;
		}
		45% {
			scale: 1.22 0.72;
		}
		100% {
			scale: 1 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gosterge {
			transition: opacity 150ms ease;
		}
		.gosterge[data-akiyor='true'] {
			animation: none;
		}
	}
</style>

<script>
	const ustCubuk = document.getElementById('ust-cubuk');
	const menuDugmesi = document.getElementById('menu-dugmesi');
	const mobilMenu = document.getElementById('mobil-menu');
	const temaDugmesi = document.getElementById('tema-dugmesi');

	// --- Kaydırma durumu -----------------------------------------------------
	// 32 piksel, hero'dan ayrıldığını anlamak için yeterli; daha küçük bir eşik
	// dokunmatik cihazlarda esneme hareketinde çubuğu titretiyor.
	const ESIK = 32;

	// Bilinçli olarak requestAnimationFrame ile kısıtlamıyoruz: rAF'ın duraklatıldığı
	// durumlarda (arka plan sekmesi, gömülü çerçeve) bekleme bayrağı kilitlenip çubuğu
	// kalıcı olarak donduruyordu. Yapılan iş yalnızca bir karşılaştırma; değer
	// değişmediğinde DOM'a hiç yazmıyoruz, dolayısıyla her olayda çalışması güvenli.
	function kaydirmayiUygula() {
		if (!ustCubuk) return;
		const yeniDurum = window.scrollY > ESIK ? 'true' : 'false';
		if (ustCubuk.dataset.kaydirildi !== yeniDurum) ustCubuk.dataset.kaydirildi = yeniDurum;
	}

	window.addEventListener('scroll', kaydirmayiUygula, { passive: true });

	/*
	  İLK DURUM DA BİR KARE BEKLİYOR.

	  `window.scrollY` okumak düzen gerektiriyor. Bu satır sayfa açılırken
	  doğrudan çalıştığında tarayıcı henüz hiçbir düzen çıkarmamış oluyor ve
	  bütün sayfanınkini tek seferde hesaplamak zorunda kalıyordu: ölçümlerde
	  açılıştaki zorunlu yeniden düzenlemenin en büyük kalemi buydu (~46 ms).

	  Yukarıdaki not `scroll` olayını rAF ile KISITLAMAMAK üzerine; o hâlâ
	  geçerli ve değişmedi. Ertelenen yalnızca ilk okuma.

	  Sayfanın tepesinde durum zaten "false" ve HTML'de öyle yazılı, yani
	  gecikme görünmüyor. Kaydırılmış konumda açılan bir sayfada çubuk bir kare
	  sonra yerini alıyor. rAF hiç çalışmazsa (arka planda açılmış sekme) ilk
	  gerçek kaydırma zaten durumu uyguluyor.

	  `requestAnimationFrame` İÇİNDE `setTimeout`: rAF geri çağrısı karenin
	  düzen adımından önce çalıştığı için tek başına yetmiyor, okuma orada da
	  düzeni zorluyor. Gerekçenin tamamı `BaseLayout.astro` içinde.
	*/
	if (document.readyState === 'complete') setTimeout(kaydirmayiUygula, 0);
	else window.addEventListener('load', () => setTimeout(kaydirmayiUygula, 0), { once: true });

	// --- Mobil menü ----------------------------------------------------------
	const menuAcikEtiketi = menuDugmesi?.dataset.etiketKapat ?? 'Menüyü kapat';
	const menuKapaliEtiketi = menuDugmesi?.dataset.etiketAc ?? 'Menüyü aç';

	function menuOgeleri(): HTMLElement[] {
		if (!mobilMenu) return [];
		return [...mobilMenu.querySelectorAll<HTMLElement>('a[href]')];
	}

	function menuyuAyarla(acik: boolean) {
		if (!menuDugmesi || !mobilMenu) return;
		menuDugmesi.setAttribute('aria-expanded', String(acik));
		menuDugmesi.setAttribute('aria-label', acik ? menuAcikEtiketi : menuKapaliEtiketi);
		mobilMenu.classList.toggle('hidden', !acik);
		// Panelin arkasi saydam kalmasin diye kapsule zemin veren durum.
		if (ustCubuk) ustCubuk.dataset.menuAcik = String(acik);
		// Menü açıkken arka planın kayması, açılan panelin sabit durması yüzünden
		// kopuk bir his veriyordu; sayfa kaydırması kilitleniyor.
		document.documentElement.classList.toggle('menu-acik', acik);
	}

	menuDugmesi?.addEventListener('click', () => {
		const acilacak = menuDugmesi.getAttribute('aria-expanded') !== 'true';
		menuyuAyarla(acilacak);
		// Odak menüye taşınmazsa klavyeyle gezen kullanıcı, açtığı menüye
		// ulaşmak için sayfanın başından tab'lamak zorunda kalıyordu.
		if (acilacak) menuOgeleri()[0]?.focus();
	});

	// Menü açıkken odak panelin içinde dönsün; arkadaki öğelere geçmesin.
	mobilMenu?.addEventListener('keydown', (olay) => {
		if (olay.key !== 'Tab' || !menuDugmesi) return;
		const ogeler = [menuDugmesi, ...menuOgeleri()];
		const ilk = ogeler[0];
		const son = ogeler[ogeler.length - 1];
		const etkin = document.activeElement;
		if (olay.shiftKey && etkin === ilk) {
			olay.preventDefault();
			son.focus();
		} else if (!olay.shiftKey && etkin === son) {
			olay.preventDefault();
			ilk.focus();
		}
	});

	// Esc menüyü kapatır ve odağı butona geri verir.
	document.addEventListener('keydown', (olay) => {
		if (olay.key === 'Escape' && menuDugmesi?.getAttribute('aria-expanded') === 'true') {
			menuyuAyarla(false);
			menuDugmesi.focus();
		}
	});

	// Menü açıkken dışarı tıklanırsa kapansın.
	document.addEventListener('click', (olay) => {
		if (menuDugmesi?.getAttribute('aria-expanded') !== 'true') return;
		const hedef = olay.target as Node;
		if (!ustCubuk?.contains(hedef)) menuyuAyarla(false);
	});

	// Masaüstü genişliğine geçildiğinde açık kalan mobil menüyü sıfırla.
	window.matchMedia('(min-width: 64rem)').addEventListener('change', (olay) => {
		if (olay.matches) menuyuAyarla(false);
	});

	// --- Tema ----------------------------------------------------------------
	function temaEtiketiniGuncelle() {
		const koyu = document.documentElement.classList.contains('dark');
		temaDugmesi?.setAttribute('aria-label', koyu ? 'Açık temaya geç' : 'Koyu temaya geç');
	}

	temaDugmesi?.addEventListener('click', () => {
		const koyu = document.documentElement.classList.toggle('dark');
		localStorage.setItem('tema', koyu ? 'koyu' : 'acik');
		temaEtiketiniGuncelle();
	});

	temaEtiketiniGuncelle();

	// --- Kayan gösterge ------------------------------------------------------
	const menuListesi = document.getElementById('menu-listesi');
	const gosterge = document.getElementById('gosterge');
	const menuBaglantilari = menuListesi
		? [...menuListesi.querySelectorAll<HTMLAnchorElement>('a[data-menu-bag]')]
		: [];
	/*
	  Aktif bağlantı DEĞİŞKENDE TUTULMUYOR, her seferinde yeniden aranıyor.

	  Önce açılışta bir kez okunuyordu. Hakkımda sayfasında aktiflik artık
	  kaydırmaya göre "Hakkımda" ile "İletişim" arasında geçiyor; tek seferlik
	  okuma göstergeyi eski bağlantıda bırakıyordu.
	*/
	const aktifBaglantiyiBul = () =>
		menuListesi?.querySelector<HTMLAnchorElement>('a[aria-current="page"]') ?? null;

	function gostergeyiTasi(hedef: HTMLElement, akitMi = true) {
		if (!menuListesi || !gosterge) return;
		// Konum listeye göre ölçülür; bağlantılar eşit genişlikte olmadığı için
		// sabit bölme yerine gerçek kutu ölçüleri kullanılıyor.
		const listeKutusu = menuListesi.getBoundingClientRect();
		const hedefKutusu = hedef.getBoundingClientRect();
		gosterge.style.setProperty('--gosterge-x', `${hedefKutusu.left - listeKutusu.left}px`);
		gosterge.style.setProperty('--gosterge-y', `${hedefKutusu.top - listeKutusu.top}px`);
		gosterge.style.setProperty('--gosterge-w', `${hedefKutusu.width}px`);
		gosterge.style.setProperty('--gosterge-h', `${hedefKutusu.height}px`);
		gosterge.dataset.gorunur = 'true';

		// Göstergenin üzerinde durduğu bağlantı karşıt renge geçsin.
		menuBaglantilari.forEach((bag) => bag.removeAttribute('data-vurgulu'));
		hedef.setAttribute('data-vurgulu', '');
		if (!akitMi) return;
		// Aynı animasyonu yeniden tetiklemek için sıfırlayıp yeniden başlatıyoruz.
		gosterge.dataset.akiyor = 'false';
		void gosterge.offsetWidth;
		gosterge.dataset.akiyor = 'true';
	}

	function gostergeyiAktifeAl(akitMi = true) {
		if (!gosterge) return;
		const aktifBaglanti = aktifBaglantiyiBul();
		if (aktifBaglanti) {
			gostergeyiTasi(aktifBaglanti, akitMi);
		} else {
			// Bu sayfaya karşılık gelen bağlantı yoksa gösterge gizlenir ve
			// hiçbir bağlantı karşıt renkte kalmaz.
			gosterge.dataset.gorunur = 'false';
			menuBaglantilari.forEach((bag) => bag.removeAttribute('data-vurgulu'));
		}
	}

	if (menuListesi && gosterge) {
		menuBaglantilari.forEach((bag) => {
			bag.addEventListener('mouseenter', () => gostergeyiTasi(bag));
			bag.addEventListener('focus', () => gostergeyiTasi(bag));
		});

		menuListesi.addEventListener('mouseleave', () => gostergeyiAktifeAl());
		menuListesi.addEventListener('focusout', (olay) => {
			if (!menuListesi.contains(olay.relatedTarget as Node)) gostergeyiAktifeAl();
		});

		/*
		  İlk yerleşim animasyonsuz olmalı; aksi hâlde sayfa açılırken gösterge
		  sol kenardan hedefe doğru süzülüyor.

		  Ölçüm İLK BOYAMADAN SONRAYA bırakılıyor. `getBoundingClientRect`
		  sayfa açılırken, tarayıcı daha hiçbir düzen çıkarmamışken çağrılınca
		  bütün sayfanın düzeni tek seferde zorlanıyor ("zorunlu yeniden
		  düzenleme") ve bu satır ölçümlerde 50 ms'ye kadar çıkıyordu. Bir kare
		  beklendiğinde düzen zaten hazır oluyor, okuma bedava kalıyor.

		  `requestAnimationFrame` İÇİNDE `setTimeout`: rAF geri çağrısı karenin
		  düzen adımından önce çalıştığı için tek başına yetmiyor. Gerekçenin
		  tamamı `BaseLayout.astro` içinde.

		  Gecikme gözle görünmüyor: gösterge konumlanana kadar `data-gorunur`
		  atanmadığı için zaten gizli, hemen ardından doğru yerde beliriyor.
		*/
		const ilkYerlesim = () => {
			gosterge.style.transition = 'none';
			gostergeyiAktifeAl(false);
			void gosterge.offsetWidth;
			gosterge.style.transition = '';
		};

		/*
		  İlk yerleşim yazı tipleri hazır olunca yapılıyor.

		  Zaten aşağıda `document.fonts.ready` ile bir kez daha ölçülüyordu:
		  yazı tipi geç yüklendiğinde bağlantıların genişliği değişiyor ve ilk
		  ölçüm geçersiz kalıyor. Yani açılıştaki ölçüm hem düzeni zorluyor hem
		  de sonucu birazdan çöpe gidiyordu.

		  `fonts.ready` ilk boyamadan sonra çözüldüğü için düzen o noktada
		  hazır; okuma bedavaya geliyor ve gösterge tek seferde doğru yerine
		  oturuyor. Yazı tipi arayüzü olmayan tarayıcıda boyama sonrasına
		  düşen `setTimeout` yedeği çalışıyor.
		*/
		const yerlesimiPlanla = () => {
			if (document.fonts?.ready) document.fonts.ready.then(ilkYerlesim);
			else ilkYerlesim();
		};

		if (document.readyState === 'complete') yerlesimiPlanla();
		else window.addEventListener('load', yerlesimiPlanla, { once: true });

		window.addEventListener('resize', () => gostergeyiAktifeAl(false), { passive: true });

		// Bağlantı metinleri sayfa yüklendikten sonra da değişebiliyor: tarayıcının
		// sayfa çevirisi metinleri değiştiriyor ("Home" -> "Ev") ve gösterge eski
		// genişlikte kalıp komşu bağlantının üzerine taşıyordu. Metin değişimini
		// izleyip yeniden ölçüyoruz. Öznitelik değişiklikleri izlenmiyor; aksi hâlde
		// göstergenin kendi stil güncellemesi sonsuz döngü yaratırdı.
		const metinGozlemcisi = new MutationObserver(() => gostergeyiAktifeAl(false));
		metinGozlemcisi.observe(menuListesi, {
			childList: true,
			subtree: true,
			characterData: true,
		});

		// İlk yerleşim zaten `document.fonts.ready` üzerinden yapılıyor
		// (yukarıda); ayrıca bir kez daha ölçmek gereksizdi.
	}

	// --- Hakkımda / İletişim aktifliği --------------------------------------
	/*
	  "Hakkımda" ve "İletişim" aynı sayfaya gidiyor, ikincisi bir çapa. Adrese
	  bakarak hangisinin aktif olduğunu söylemek imkânsız; cevap kaydırma
	  konumunda.

	  Sunucu varsayılanı "Hakkımda" ve betik hiç çalışmazsa öyle kalıyor:
	  sayfa yine kullanılabilir, `aria-current` yine tek bir bağlantıda.

	  Öznitelik yalnızca hakkımda sayfasında basıldığı için gözlemci öbür
	  sayfalarda hiç kurulmuyor.
	*/
	const iletisimBolumuKimligi = ustCubuk?.dataset.iletisimBolumu;
	const iletisimBolumu = iletisimBolumuKimligi
		? document.getElementById(iletisimBolumuKimligi)
		: null;

	if (iletisimBolumu && 'IntersectionObserver' in window) {
		// Masaüstü ve mobil menüdeki eşleri birlikte dönüyor: iki listede
		// farklı bağlantının vurgulu olması ziyaretçiye çelişki gösterirdi.
		const rolBaglari = (rol: string) => [
			...document.querySelectorAll<HTMLAnchorElement>(`a[data-bag-rol="${rol}"]`),
		];
		const hakkimdaBaglari = rolBaglari('hakkimda');
		const iletisimBaglari = rolBaglari('iletisim');

		/*
		  Sınıf dizileri sunucudan geliyor (bkz. `data-sinif-*`). Betiğin içine
		  elle yazılsalardı renk değiştiğinde iki yerin ayrışması an meselesiydi.
		*/
		const sinif = (ad: string) => (ustCubuk?.dataset[ad] ?? '').split(' ').filter(Boolean);
		const masaustuAktif = sinif('sinifMasaustuAktif');
		const masaustuPasif = sinif('sinifMasaustuPasif');
		const mobilAktif = sinif('sinifMobilAktif');
		const mobilPasif = sinif('sinifMobilPasif');

		function aktifligiUygula(bag: HTMLAnchorElement, aktif: boolean) {
			const mobilMi = bag.closest('#mobil-menu') !== null;
			const eklenecek = aktif
				? mobilMi
					? mobilAktif
					: masaustuAktif
				: mobilMi
					? mobilPasif
					: masaustuPasif;
			const cikarilacak = aktif
				? mobilMi
					? mobilPasif
					: masaustuPasif
				: mobilMi
					? mobilAktif
					: masaustuAktif;
			// Önce çıkar sonra ekle: iki dizinin ortak sınıfları varsa
			// (örn. `data-vurgulu:text-white`) bu sırada kaybolmuyor.
			if (cikarilacak.length) bag.classList.remove(...cikarilacak);
			if (eklenecek.length) bag.classList.add(...eklenecek);
			if (aktif) bag.setAttribute('aria-current', 'page');
			else bag.removeAttribute('aria-current');
		}

		let iletisimdeyiz: boolean | null = null;

		function iletisimeGec(yeni: boolean) {
			if (iletisimdeyiz === yeni) return;
			/*
			  İlk değerlendirmede gösterge ELLENMİYOR. Gözlemcinin ilk geri
			  çağrısı sayfa açılırken hemen düşüyor; göstergeyi orada
			  konumlandırmak, açılış ölçümünü `load` + `fonts.ready` sonrasına
			  erteleyen düzeni bozup vurgunun sol kenardan süzülmesine yol
			  açıyordu. O ölçüm zaten aktif bağlantıyı yeniden arıyor,
			  dolayısıyla buradaki işareti kendiliğinden görüyor.
			*/
			const ilkDegerlendirme = iletisimdeyiz === null;
			iletisimdeyiz = yeni;
			// `aria-current` AYNI ANDA TEK bağlantıda: önce hepsi pasife
			// çekiliyor, sonra kazanan işaretleniyor.
			hakkimdaBaglari.forEach((bag) => aktifligiUygula(bag, !yeni));
			iletisimBaglari.forEach((bag) => aktifligiUygula(bag, yeni));
			// Kayan gösterge aktif bağlantıyı her çağrıda yeniden arıyor,
			// dolayısıyla burada tek yapılacak şey onu yeniden konumlandırmak.
			if (!ilkDegerlendirme) gostergeyiAktifeAl();
		}

		/*
		  TETİK ÇİZGİSİ GÖRÜŞ ALANININ ÜST %40'INDA — ölçülerek seçildi.

		  Önce akla gelen "bölüm ekranın ortasını kesiyor mu" kuralı ölçümde
		  çöktü: sayfa sonuna kadar kaydırıldığında iletişim bölümü orta
		  çizginin ÜSTÜNDE kalıyor (1440x900'de üst kenarı -165 piksel), dar
		  ekranda ise altbilgi yüzünden tamamen görüş alanının dışına çıkıyor
		  (390x844'te alt kenarı -165). O kuralla ziyaretçi tam iletişime
		  vardığında işaret "Hakkımda"ya geri dönüyordu.

		  Bu yüzden soru "kesişiyor mu" değil, "bölümün ÜSTÜ çizgiyi geçti mi".
		  `rootMargin` yüzde olduğu için tarayıcı pencere boyutu değişince
		  yeniden hesaplıyor; gözlemciyi elle yeniden kurmak gerekmiyor.

		  KÖK SIFIR YÜKSEKLİKTE, yani gerçek bir çizgi: `-40%` üstten,
		  `-60%` alttan, toplamı 100%. İlk denemede yalnızca üst kenar
		  kısılmıştı ve kök görüş alanının alt %60'ı kadar KOCAMAN bir
		  bölgeydi; bölüm bir kez o bölgeye girince kesişme durumu bir daha
		  değişmiyor, `IntersectionObserver` da yalnızca eşik geçişlerinde
		  tetiklendiği için geri çağrı bir daha hiç çalışmıyordu. Tarayıcıda
		  ölçüldü: bölümün üstü 559 pikselden -20 piksele inerken tek bir
		  bildirim gelmedi.

		  `isIntersecting` bilinçli olarak kullanılmıyor, yalnızca geri
		  çağrının tetiklenmesine yarıyor: bölüm tamamen çizginin üstüne
		  çıktığında kesişme biter ama biz hâlâ iletişimdeyizdir.
		*/
		const gozlemci = new IntersectionObserver(
			(girdiler) => {
				for (const girdi of girdiler) {
					iletisimeGec(girdi.boundingClientRect.top <= window.innerHeight * 0.4);
				}
			},
			{ rootMargin: '-40% 0px -60% 0px', threshold: 0 }
		);

		gozlemci.observe(iletisimBolumu);
	}
</script>
