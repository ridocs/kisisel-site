---
/**
 * Sayfanın tamamı boyunca sağlı sollu inen tek bir yazı sarmaşığı.
 *
 * Eğri SABİT duruyor. Hareket eden şey yazı: harfler eğrinin üzerinde, kendi
 * yörüngelerinde, tek yönde ve durmadan akıyor — bir reklam bandının soldan
 * sağa akması gibi, ama yörünge düz değil sarmaşık.
 *
 * Süs öğesi: okunacak bir metin değil, sayfaya doku veriyor. Bu yüzden
 * `aria-hidden` ve ekran okuyucuya hiç verilmiyor.
 *
 * Sayfa yüksekliği baştan bilinemediği için sarmaşık tek parça değil,
 * ARDIŞIK PARÇALARDAN kuruluyor. Her parça ortadan başlayıp ortada bitiyor
 * ve dikey teğeti aynı; alt alta dizildiklerinde ek yeri görünmeyen tek bir
 * eğri çıkıyor. Sayfadan uzun kalan parçalar kırpılıyor.
 *
 * Akış SMIL (`<animate>`) ile. CSS `startOffset` özelliğini canlandıramıyor —
 * o bir sunum özniteliği, CSS özelliği değil. SMIL bildirimsel SVG, JavaScript
 * değil; sitenin "sıfır JavaScript" kuralı korunuyor.
 */
interface Props {
	/** Sarmaşık boyunca tekrarlanacak kelime. */
	metin: string;
}

const { metin } = Astro.props;

/*
  Aynı sayfada birden çok kez kullanılabilsin diye her örnek kendi id önekini
  alıyor: `textPath` yolu id ile çağırıyor, çakışan id'lerde bütün parçalar
  ilk yolu izlerdi.
*/
const onek = `sarmasik-${Math.random().toString(36).slice(2, 8)}`;

const PARCA_SAYISI = 7;
const parcalar = Array.from({ length: PARCA_SAYISI }, (_, i) => i);

/*
  Tek parçanın yolu. Kutu 1000 × 1100.

  Dönüşlerin yarıçapı iki şeyden geliyor: salınım genliği (120–880, kenarlara
  dayanmıyor) ve kontrol kollarının uzunluğu (her dönüşte 190 birim). Daha
  kısa kollarla dönüşler sertleşiyor ve `textPath` harfleri virajın iç
  tarafında üst üste biniyor — eğrilik yarıçapı yazı boyuna yaklaşınca harfler
  birbirine giriyor.

  Her dönüşte teğet dikey (kontrol noktası ile uç noktanın x'i aynı), başlangıç
  ve bitiş de x=500'de dikey. Bu yüzden parçalar eklendiğinde kırılma olmuyor.
*/
const DUGUMLER = [
	// [p0, c1, c2, p3]
	[
		[500, 0],
		[500, 150],
		[880, 190],
		[880, 380],
	],
	[
		[880, 380],
		[880, 570],
		[120, 530],
		[120, 720],
	],
	[
		[120, 720],
		[120, 910],
		[500, 950],
		[500, 1100],
	],
] as const;

const YOL = `M ${DUGUMLER[0][0].join(' ')} ${DUGUMLER.map(
	([, c1, c2, p3]) => `C ${c1.join(' ')} ${c2.join(' ')} ${p3.join(' ')}`,
).join(' ')}`;

/*
  Yolun uzunluğu — akışın dikişsiz döngü yapabilmesi için gerekiyor.

  Örnekleyerek ölçülüyor: kübik Bézier'in kapalı bir yay uzunluğu formülü yok.
  200 adım bu ölçekte binde birin altında hata bırakıyor, fazlası gereksiz.
*/
function kubikUzunluk(
	p0: readonly number[],
	c1: readonly number[],
	c2: readonly number[],
	p3: readonly number[],
	adim = 200,
): number {
	const nokta = (t: number, i: number) => {
		const u = 1 - t;
		return u * u * u * p0[i] + 3 * u * u * t * c1[i] + 3 * u * t * t * c2[i] + t * t * t * p3[i];
	};
	let uzunluk = 0;
	let ox = nokta(0, 0);
	let oy = nokta(0, 1);
	for (let k = 1; k <= adim; k++) {
		const t = k / adim;
		const x = nokta(t, 0);
		const y = nokta(t, 1);
		uzunluk += Math.hypot(x - ox, y - oy);
		ox = x;
		oy = y;
	}
	return uzunluk;
}

const YOL_UZUNLUGU = Math.round(
	DUGUMLER.reduce((toplam, [p0, c1, c2, p3]) => toplam + kubikUzunluk(p0, c1, c2, p3), 0),
);

/*
  DİKİŞSİZ AKIŞ

  Yazı yolun tam İKİ KATI uzunluğa zorlanıyor (`textLength`) ve tekrar sayısı
  ÇİFT. Böylece metnin ilk yarısı ile ikinci yarısı birebir aynı diziliyor.

  Akış `startOffset`'i bir yol boyu kaydırıyor: `-uzunluk` → `0`. Başlangıçta
  yolu metnin ikinci yarısı, sonunda ilk yarısı kaplıyor — ikisi aynı olduğu
  için döngü başa dönerken görüntü hiç değişmiyor, sıçrama olmuyor.

  Tekrar sayısı hedef uzunluğa göre seçiliyor ki `lengthAdjust` harf aralığını
  fazla germesin; sonra çift sayıya yuvarlanıyor.
*/
const HEDEF_UZUNLUK = YOL_UZUNLUGU * 2;
// Kaba harf genişliği: yazı boyu 26, harf arası 0.16em. Kesin olması gerekmiyor,
// yalnızca tekrar sayısını makul bir aralıkta tutuyor.
const HARF_GENISLIGI = 26 * 0.6 + 26 * 0.16;
const birim = `${metin} · `;
const kabaTekrar = Math.max(2, Math.round(HEDEF_UZUNLUK / (birim.length * HARF_GENISLIGI)));
const TEKRAR = kabaTekrar % 2 === 0 ? kabaTekrar : kabaTekrar + 1;
const tekrarliMetin = birim.repeat(TEKRAR);

// Akış süresi: yavaş bir sürüklenme. Yolun tamamını bu sürede kat ediyor.
// Süs olduğu için ağır olmalı; hızlı akan bir yazı gözü içerikten çalıyor.
const SURE = 72;
---

<div class="sarmasik-alan" aria-hidden="true">
	{
		parcalar.map((i) => (
			<svg class="parca" viewBox="0 0 1000 1100" focusable="false">
				<defs>
					<path id={`${onek}-${i}`} fill="none" d={YOL} />
				</defs>
				<text class="sarmasik-yazi">
					<textPath
						href={`#${onek}-${i}`}
						startOffset={-YOL_UZUNLUGU}
						textLength={HEDEF_UZUNLUK}
						lengthAdjust="spacing"
					>
						{tekrarliMetin}
						<animate
							attributeName="startOffset"
							from={-YOL_UZUNLUGU}
							to="0"
							dur={`${SURE}s`}
							repeatCount="indefinite"
						/>
					</textPath>
				</text>
			</svg>
		))
	}
</div>

<style>
	/*
	  Sayfanın tamamını kaplayan katman. `overflow: hidden` şart: sarmaşık
	  kenarlara değiyor ve kırpılmazsa sayfa yatay kaydırma kazanırdı.

	  `z-index: -1` ile bütün içeriğin arkasında. Bunun çalışması için sayfa
	  zemininin `body` üzerinde değil `html` üzerinde olması gerekiyor —
	  zemin body'de kalsaydı sarmaşık onun arkasına düşüp görünmezdi.
	*/
	.sarmasik-alan {
		position: absolute;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		/* Parçalar alt alta, aralarında boşluk olmadan. `line-height: 0`
		   satır içi SVG'lerin altında kalan boşluğu siliyor. */
		display: flex;
		flex-direction: column;
		line-height: 0;
		/*
		  METİNLE ÇAKIŞMA

		  Sarmaşık salınırken sayfanın ortasından geçmek zorunda, oysa okunacak
		  metin tam orada duruyor. Maske sarmaşığı kenarlarda tam güçte bırakıp
		  orta sütunun arkasında soluklaştırıyor: eğri kopmuyor, yalnızca
		  metnin arkasına denk gelen yerde geri çekiliyor.

		  Maske alfası kullanılıyor, `transparent` değil — tamamen silmek eğriyi
		  ortadan ikiye bölüp sarmaşık algısını bozuyordu.
		*/
		mask-image: linear-gradient(
			to right,
			#000 0%,
			#000 14%,
			#0002 30%,
			#0002 70%,
			#000 86%,
			#000 100%
		);
	}

	.parca {
		width: 100%;
		height: auto;
		flex: none;
	}

	.sarmasik-yazi {
		font-weight: 700;
		font-size: 26px;
		/* Harf arası genişletildi: virajın iç tarafında harfler birbirine
		   yaklaşıyor, düz aralıkla dönüşlerde sıkışıyorlardı. */
		letter-spacing: 0.16em;
		text-transform: uppercase;
		/* Renk nötr `--foreground` üzerinden geliyor, böylece koyu temada renk
		   sapması olmuyor. */
		fill: color-mix(in oklab, var(--foreground) 16%, transparent);
	}

	/*
	  Hareketi azaltılmış tercihte sarmaşık tamamen kaldırılıyor.

	  Sebep teknik: akış SMIL ile çalışıyor ve SMIL bir CSS animasyonu değil,
	  medya sorgusuyla durdurulamıyor. Sürekli hareket eden bir öğeyi hareket
	  istemeyen kullanıcıya göstermektense süsü hiç göstermemek doğru taraf —
	  sayfanın hiçbir bilgisi bu katmanda değil.
	*/
	@media (prefers-reduced-motion: reduce) {
		.sarmasik-alan {
			display: none;
		}
	}

	/*
	  Mobilde bu tasarım yok.

	  Dar ekranda eğri sıkışıp sarmaşık yerine tırtıklı bir çizgiye dönüşüyor,
	  ayrıca sayfa boyunda sürekli canlanan bir katman iOS'ta pahalı.
	*/
	@media (max-width: 767px) {
		.sarmasik-alan {
			display: none;
		}
	}
</style>
