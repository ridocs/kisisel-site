---
/**
 * Sayfanın tamamı boyunca sağlı sollu inen tek bir yazı sarmaşığı.
 *
 * Tek bir eğri: tepeden başlıyor, sağa salınıp sola dönüyor ve aşağı doğru
 * böyle devam ediyor. Yazı bu eğrinin üzerinde akıyor, düz bir satır değil.
 * Yazı ayrıca eğri boyunca sürekli aşağı kayıyor — akan bir nehir gibi.
 *
 * Süs öğesi: okunacak bir metin değil, sayfaya doku veriyor. Bu yüzden
 * `aria-hidden` ve ekran okuyucuya hiç verilmiyor.
 *
 * Sayfa yüksekliği baştan bilinemediği için sarmaşık tek parça değil,
 * ARDIŞIK PARÇALARDAN kuruluyor. Her parça ortadan başlayıp ortada bitiyor
 * ve dikey teğeti aynı; alt alta dizildiklerinde ek yeri görünmeyen tek bir
 * eğri çıkıyor. Sayfadan uzun kalan parçalar kırpılıyor.
 *
 * Hareket tamamen CSS. Sitede hiç JavaScript yok, bu bileşen de o kuralı
 * bozmuyor.
 */
interface Props {
	/** Sarmaşık boyunca tekrarlanacak kelime. */
	metin: string;
}

const { metin } = Astro.props;

/*
  Aynı sayfada birden çok kez kullanılabilsin diye her örnek kendi id önekini
  alıyor: `textPath` yolu id ile çağırıyor, çakışan id'lerde bütün parçalar
  ilk yolu izlerdi.
*/
const onek = `sarmasik-${Math.random().toString(36).slice(2, 8)}`;

/*
  Parça sayısı: en uzun sayfanın altına yetişecek kadar, artı sürekli akış
  için bir parça yedek. Akış parçaları bir parça boyu kaydırdığı için üstte
  açılan boşluğu bu yedek kapatıyor.

  Sayı burada ve CSS'te aynı olmak zorunda; bu yüzden CSS'e değişken olarak
  geçiyor, iki yere ayrı ayrı yazılmıyor.
*/
const PARCA_SAYISI = 7;
const parcalar = Array.from({ length: PARCA_SAYISI }, (_, i) => i);

/*
  Tek parçanın yolu. Kutu 1000 × 1800.

  Kutunun boyu genişliğinin 1.8 katı: viraj yarıçapları bu yüzden geniş.
  Daha basık bir kutuda dönüşler sertleşiyor ve yazı virajın iç tarafında
  üst üste biniyordu — `textPath` harfleri yolun üzerine dizerken eğrilik
  yarıçapı yazı boyuna yaklaşınca harfler birbirine giriyor. Salınım genliği
  de bu yüzden kenarlara dayanmıyor (180–820), dönüşler yumuşak kalsın diye.

  Başlangıç ve bitiş noktasının x'i (500) ve dikey teğeti aynı olduğu için
  parçalar eklendiğinde kırılma olmuyor.
*/
const YOL =
	'M 500 0 C 500 210 820 350 820 570 C 820 790 180 930 180 1150 C 180 1370 500 1590 500 1800';

// Yazı eğriyi dolduracak kadar tekrarlanıyor; taşan kısmı tarayıcı yolun
// sonunda kendiliğinden kesiyor.
const tekrarliMetin = `${metin} · `.repeat(16);
---

<div class="sarmasik-alan" aria-hidden="true" style={`--parca-sayisi: ${PARCA_SAYISI}`}>
	{/* İki ayrı hareket, iki ayrı katman: dıştaki kaydırmaya bağlı, içteki
	    sürekli akan. İkisi de `translate` yazdığı için aynı ögede olamazlar. */}
	<div class="sarmasik-akis">
		{
			parcalar.map((i) => (
				<svg class="parca" viewBox="0 0 1000 1800" focusable="false">
					<defs>
						<path id={`${onek}-${i}`} fill="none" d={YOL} />
					</defs>
					<text class="sarmasik-yazi">
						<textPath href={`#${onek}-${i}`}>{tekrarliMetin}</textPath>
					</text>
				</svg>
			))
		}
	</div>
</div>

<style>
	/*
	  Sayfanın tamamını kaplayan katman. `overflow: hidden` şart: sarmaşık
	  kenarlara değiyor ve kırpılmazsa sayfa yatay kaydırma kazanırdı.

	  `z-index: -1` ile bütün içeriğin arkasında. Bunun çalışması için sayfa
	  zemininin `body` üzerinde değil `html` üzerinde olması gerekiyor —
	  zemin body'de kalsaydı sarmaşık onun arkasına düşüp görünmezdi.
	*/
	.sarmasik-alan {
		position: absolute;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		/*
		  METİNLE ÇAKIŞMA

		  Sarmaşık salınırken sayfanın ortasından geçmek zorunda, oysa okunacak
		  metin tam orada duruyor. Maske sarmaşığı kenarlarda tam güçte bırakıp
		  orta sütunun arkasında soluklaştırıyor: eğri kopmuyor, yalnızca
		  metnin arkasına denk gelen yerde geri çekiliyor.

		  Maske alfası kullanılıyor, `transparent` değil — tamamen silmek eğriyi
		  ortadan ikiye bölüp sarmaşık algısını bozuyordu.
		*/
		mask-image: linear-gradient(
			to right,
			#000 0%,
			#000 16%,
			#0003 34%,
			#0003 66%,
			#000 84%,
			#000 100%
		);
	}

	.sarmasik-akis {
		/* Parçalar alt alta, aralarında boşluk olmadan. `line-height: 0`
		   satır içi SVG'lerin altında kalan boşluğu siliyor. */
		display: flex;
		flex-direction: column;
		line-height: 0;
		/* Akış bir parça boyu yukarıdan başlıyor; yukarı kaydırma payı burada. */
		margin-top: 0;
	}

	.parca {
		width: 100%;
		height: auto;
		flex: none;
	}

	.sarmasik-yazi {
		font-weight: 700;
		font-size: 26px;
		/*
		  Harf arası genişletildi: virajın iç tarafında harfler birbirine
		  yaklaşıyor, düz aralıkla dönüşlerde sıkışıp okunmaz oluyorlardı.
		*/
		letter-spacing: 0.16em;
		text-transform: uppercase;
		/*
		  Renk nötr `--foreground` üzerinden geliyor, böylece koyu temada renk
		  sapması olmuyor. Doku olarak okunacak kadar var, içeriğin okunmasını
		  zorlaştırmayacak kadar geride.
		*/
		fill: color-mix(in oklab, var(--foreground) 16%, transparent);
	}

	/*
	  SÜREKLİ AKIŞ

	  Parçalar birbirinin aynı ve ek yeri vermeden diziliyor; bu yüzden
	  yığını tam BİR PARÇA boyu kaydırmak başladığı görüntüye geri dönüyor.
	  Döngü böylece dikişsiz: yazı sonsuza kadar aşağı akıyor.

	  Kaydırma miktarı yüzdeyle veriliyor ve yüzde ögenin kendi boyuna göre
	  hesaplanıyor; parça sayısına bölünce tam bir parça ediyor. Sabit bir
	  piksel değeri ekran genişliğiyle değişen parça boyunu tutturamazdı.

	  Yön yukarıdan sıfıra: yığın hep yukarı kaymış durumda duruyor, yani
	  üstte boşluk açılmıyor. Altta fazlası zaten kırpılıyor.
	*/
	@media (prefers-reduced-motion: no-preference) {
		.sarmasik-akis {
			animation: sarmasik-nehir 60s linear infinite;
		}
	}

	@keyframes sarmasik-nehir {
		from {
			translate: 0 calc(-100% / var(--parca-sayisi));
		}
		to {
			translate: 0 0;
		}
	}

	/*
	  Kaydırmaya bağlı ikinci hareket: sayfa indikçe sarmaşık biraz yukarı
	  kayıyor. İçerikten farklı hızda hareket ettiği için sabit bir arka plan
	  deseni gibi değil, sayfayla birlikte akan bir öğe gibi okunuyor.

	  `@supports` bilinçli: Firefox'ta özellik hâlâ bayrak arkasında. Destek
	  yoksa bu katman kıpırdamıyor, akış ise çalışmaya devam ediyor.

	  Uzun yazım bilinçli, `animation` kısayolu DEĞİL: CSS küçültücü kısayolu
	  kurarken zaman çizelgesini de içine katıyor, tarayıcı ise kısayolda
	  zaman çizelgesi kabul etmiyor ve bildirimin tamamını sessizce atıyor.
	*/
	@supports (animation-timeline: scroll()) {
		@media (prefers-reduced-motion: no-preference) {
			.sarmasik-alan {
				animation-name: sarmasik-kayma;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: scroll(root block);
			}
		}
	}

	@keyframes sarmasik-kayma {
		to {
			translate: 0 -6%;
		}
	}

	/*
	  Mobilde bu tasarım yok.

	  İki sebep: dar ekranda eğri sıkışıp sarmaşık yerine tırtıklı bir çizgiye
	  dönüşüyor, ve sürekli çalışan bir animasyon sayfa boyunda bir katmanı
	  her karede yeniden çizdiriyor — iOS'ta bu maliyet daha önce sayfayı
	  dondurmuştu.
	*/
	@media (max-width: 767px) {
		.sarmasik-alan {
			display: none;
		}
	}
</style>
