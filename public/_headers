# Cloudflare Pages yanıt başlıkları. Sunucu yapılandırması yok, güvenlik başlıkları burada.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Astro dosya adlarına içerik özeti ekliyor, bu dosyalar değişmez.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Geçici adres arama motorlarına kapalı: tek adres mustafaeybek.com olsun.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
